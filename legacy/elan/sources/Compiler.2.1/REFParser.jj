int GrammarDeclaration(OutputCode s,int numberOfGrammarRule) :
{
  int idSort;
  int isBuiltin;
  LexemSort lexSort;
}
{
  (
   
    "GrammarForSort" idSort=readInt()  ":" isBuiltin=readInt() ":" 
     {
       lexSort = LexemSort.get(idSort);
       if(isBuiltin==1) {
	 lexSort.setBuiltin();
       }
     }
       ( numberOfGrammarRule = SymbolDeclaration(lexSort,s,numberOfGrammarRule) <DOT> )* <NIL>
    ( <END> | <DOT> )
  )*
    <ENDDEF>
      {
        return numberOfGrammarRule;
      }
}

int SymbolDeclaration(Lexem lexSort, OutputCode s,int numberOfGrammarRule) :
{
  int intGrammar;
  int intSym;
  int intArity;
  int intInfo;
  int intSemantic;
  int intStrategy;
  int intTheory;
  int intLocStrat;

  Symbol sym;
  Lexem lexem;
  Vector vectorLex = new Vector(10);
  Lexem[] arrayLex;
    // for Earley tables
  int i,type;
  int vectorLexSize = 0;
}
{
  intGrammar  = readInt() ":"  // unused
  intSym      = readInt() ":"
  intArity    = readInt() ":"  // unused
  intInfo     = readInt() ":"  // unused
  intSemantic = readInt() ":"
  intTheory   = readInt() ":"
  intStrategy = readInt() ":"

    ( lexem = ALexem() <DOT>
      {
	vectorLex.addElement(lexem);
        if (lexem != LexemIdentifier.blank) {
          vectorLexSize++;
        }
      }
      )+ <NIL> ":"
    ( intLocStrat = readInt() <DOT>
      {
	// unused
	// Do nothing
      }
      )* <NIL>
    {

      arrayLex = new Lexem[vectorLex.size()];
      vectorLex.copyInto(arrayLex);
      vectorLex.removeAllElements();

        /*
         * Generation des tableaux pour Earley
         */
        // Global Rule
      s.write("1,");
      int info = intArity+(intInfo*(007777+1));
      s.write(info + ",");
      s.write(intSym + ",");
      s.write(lexSort.getCode() + ",");
      s.write(vectorLexSize + ",");

      numberOfGrammarRule += 5;
      for(i=0 ; i<arrayLex.length ; i++) {
        lexem = (Lexem)arrayLex[i];
        if(lexem != LexemIdentifier.blank) {
            // Type
          if(lexem instanceof LexemIdentifier) type = 0;
          else if(lexem instanceof LexemSort) type = 1;
          else if(lexem instanceof LexemChar) type = 2;
          else if(lexem instanceof LexemNum) type = 3;
          else 	throw new InternalError("Wrong lexem in REF file");
          s.write(type + ",");
          s.write(lexem.getCode() + ",");
          numberOfGrammarRule += 2;
        }
      }
      s.write("\n");
      
      if(Flags.strat > 0 && intStrategy != 0) {	// Peter
	if (ElanConstants.isFsym(intStrategy)) {
	  sym = new SymbolFsym(intSym,arrayLex,lexSort,intSemantic,intStrategy);
	  sym.put(); }
	else if (ElanConstants.isLab(intStrategy)) {
 	  sym = new SymbolLab(intSym,arrayLex,lexSort,intSemantic,intStrategy);
	  sym.put(); }
	else if (ElanConstants.isApply(intStrategy)) {
 	  sym = new SymbolApply(intSym,arrayLex,lexSort,intSemantic,intStrategy);
	  sym.put(); }
	else { // if (ElanConstants.isDstr(intStrategy))
 	  sym = new SymbolDstr(intSym,arrayLex,lexSort,intSemantic,intStrategy);
	  sym.put(); }					// Peter
      } else if( intSemantic != 0 ) {
	sym = new SymbolBuiltin(intSym,arrayLex,lexSort,intSemantic,intTheory);
	sym.put();
	if(intSemantic<0 && Symbol.get(-intSemantic)==null) {
	  sym = new SymbolBuiltin(-intSemantic,arrayLex,lexSort,-intSemantic,intTheory);
	  sym.put();
	}
      } else if( intTheory == 0 ) {
	sym = new SymbolFree(intSym,arrayLex,lexSort);
	sym.put();
      } else if( intTheory == 2 ) {
	sym = new SymbolAC(intSym,arrayLex,lexSort);
	sym.put();
      } 
      return numberOfGrammarRule;
    }
  
}

Lexem ALexem() :
{
  Lexem lex;
  int id;
}
{
    "Ident(" id=readInt() ")"
    {
      return LexemIdentifier.get(id);
    }
  | "Type(" id=readInt() ")"
    {
      return LexemSort.get(id);
    }
  | "Char(" id=readInt() ")"
    {
      lex=LexemChar.get(id);
      if(lex==null) {
	lex = new LexemChar(id);
	lex.put();
      }
      return lex;
    }
  | "Num(" id=readInt() ")"
    {
      lex=LexemNum.get(id);
      if(lex==null) {
	lex = new LexemNum(id);
	lex.put();
      }
      return lex;
    }
  | "Blank"
    {
      return LexemIdentifier.blank;
    }
}

void RuleDeclaration() :
{
  int intModule;
  int intInfo;
  int intAC;
  int intVarNum;

  Term leftside;
  Term rightside;
  RightHandSide rightsideOldSwitch;
  BranchEvaluation wheres;
  Lexem ruleName=null;
  Lexem ruleSort;
  int idSort;
  RewriteRule rule;
  int id;
  int ruleNameIndex;
  int i;
  LineariseCondition linearConditions;
  
}
{
    ( "RULE("
    ruleNameIndex = readInt() ","
      {
	if( ruleNameIndex != -1 ) {
	  ruleName = LexemRuleName.get(ruleNameIndex);
	} else {
	  ruleName = null;
	}
      }
    idSort   = readInt() ","
    intModule = readInt() ","
    intInfo   = readInt() ","
    intAC     = readInt() ","

      /*
       * Nombre de variables apparaissant dans la regle a quoi ca sert ?
       * [pem: May 20 99] je m'en sert pour normaliser les lhs
       * et les localAffectation
       */
    intVarNum = readInt() ","
    {
      linearConditions = new LineariseCondition();
      linearConditions.updateMaxVariableNumber(intVarNum);
    }
    leftside=unflattenedElanTerm()  ","
    rightside=ElanTerm() ","
    wheres=Wheres(linearConditions)
    ")"
    ( <END> | <DOT> )
    {

        //System.out.println("intVarNum = " + intVarNum);
      
      
      if(!Flags.quiet && !Flags.debug) {
	//System.out.print(".");
      }
      ruleSort = LexemSort.get(idSort);


        /*
         * mise en ONF
         */
      leftside.flatten();
      leftside.orderedNormalForm();

        /*
         * Linearise leftside
         */
      leftside.linearise(linearConditions);
      if(Flags.debug && linearConditions.getConditions().size()>0) {
        System.out.println("linearise lhs: " + leftside);
      }
      
      for(i=0 ; i<linearConditions.getConditions().size() ; i++) {
	// insertion en tete	
	wheres.insertLocalEvaluation((LocalEvaluation)
                                     linearConditions.conditionAt(i));
      }
      linearConditions.removeAllConditions();
      
      rule = new RewriteRule(ruleName,ruleSort,leftside,
			     new RhsTerm(rightside,wheres),wheres);
      try{
	if(rule.isCompilable()) {
	  RewriteRule.addElement(rule);
	} 
      } catch (ACPatternNotCompiled e) {
	if(!Flags.quiet) {
	  System.out.println("\nWarning: " + leftside);
          System.out.println("This pattern is not compiled");
	}
      } catch (CompileError e) {
        System.out.println("\nError: " + leftside);
        System.out.println("This pattern cannot be compiled");
        System.out.println("Please, apply a program transformation as described in the manual");
        System.exit(1);
      }
    }

 | // Old switch

 "SWRULE("
    ruleNameIndex = readInt() ","
      {
	if( ruleNameIndex != -1 ) {
	  ruleName = LexemRuleName.get(ruleNameIndex);
	} else {
	  ruleName = null;
	}
      }
    idSort   = readInt() ","
    intModule = readInt() ","
    intInfo   = readInt() ","
    intAC     = readInt() ","

    // Nombre de variables apparaissant dans la regle a quoi ca sert ???
    intVarNum = readInt() ","
    {
      linearConditions = new LineariseCondition();
      linearConditions.updateMaxVariableNumber(intVarNum);
    }
    leftside=unflattenedElanTerm()  ","
    rightsideOldSwitch=ElanRightHandSide(linearConditions)
    ")"
    ( <END> | <DOT> )
    {
      ruleSort = LexemSort.get(idSort);
      wheres = rightsideOldSwitch.getBranch();
      /*
       * Linearise rule
       */
      leftside.linearise(linearConditions);
      for(i=0 ; i<linearConditions.getConditions().size() ; i++) {
	// insertion en tete	
	wheres.insertLocalEvaluation((LocalEvaluation)
                                     linearConditions.conditionAt(i));
      }
      linearConditions.removeAllConditions();
	 
      leftside.flatten();
      leftside.orderedNormalForm();
      rule = new RewriteRule(ruleName,ruleSort,leftside,rightsideOldSwitch,wheres);
      try{
	if(rule.isCompilable()) {
	  RewriteRule.addElement(rule);
	} 
      } catch (CompileError e) {
	if(!Flags.quiet && Flags.debug) {
	  System.out.println("cannot be compile: " + leftside);
	}
      }
    }
  )+
  <ENDDEF>
}

Term ElanTerm() :
{
  Term term;
}
{
  term = BuildElanTerm()
    {
      //System.out.println("term before flatten = " + term);
      term.flatten();
      term.orderedNormalForm();
      return term;
    }
}

Term unflattenedElanTerm() :
{
  Term term;
}
{
  term = BuildElanTerm()
    {
      return term;
    }
}


Term BuildElanTerm() :
{
  Symbol symbol;
  Lexem lex;
  Lexem sort;
  Vector subterms=null;
  int idFsym;
  int idVar;
  int idSort;
  Object value;
  int intValue;
  String stringValue;
}
{
  "FSYM(" subterms=ElanTerms() "," idFsym=readInt() ")"
    {
      symbol=Symbol.get(idFsym);
      if(symbol == null) {
	throw new InternalError("symbol sym" + idFsym + " not found");
      }
      return new Term(symbol,subterms);
    }
  | "VAR(" idVar=readInt() "," idSort=readInt() ")"
    {
      // Creation eventuelle du lexem
      sort   = LexemSort.get(idSort);
      //if(sort==null) {
      //System.out.println("ERREUR VAR idVar=" + idVar + " idSort=" + idSort);
      //}

      lex   = LexemVariableName.get(idVar);
      if(lex==null) {
	lex = new LexemVariableName(idVar, "var"+idVar);
	lex.put();
      }
      symbol=SymbolVariable.getCreate(idVar,sort);
      return new Term(symbol,subterms);
    }
  | "EVAR(" idVar=readInt() "," idSort=readInt() ")"
    {
      // Creation eventuelle du lexem
      sort  = LexemSort.get(idSort);
      lex   = LexemVariableName.get(idVar);
      if(lex==null) {
	lex = new LexemVariableName(idVar, "var"+idVar);
	lex.put();
      }
      symbol=SymbolExtensionVariable.getCreate(idVar,sort);
      return new Term(symbol,subterms);
    }
  | "INT(" intValue=readInt() ")"
    {
      symbol = SymbolInteger.get(intValue);
      if(symbol == null) {
	symbol = new SymbolInteger(intValue, LexemSort.sortInteger);
	symbol.put();
      }
      return new Term(symbol,subterms);
    }
  | "IDENT(" intValue=readInt() ")"
    {
      symbol = SymbolIdentifier.get(intValue);
      if(symbol == null) {
	symbol = new SymbolIdentifier(intValue, LexemSort.sortIdentifier);
	symbol.put();
      }
      return new Term(symbol,subterms);
    }
  | "STRING(" stringValue=ElanString() ")"
    {
      symbol = SymbolString.get(stringValue);
      if(symbol == null) {
	symbol = new SymbolString(stringValue, LexemSort.sortString);
	symbol.put();
      }
      return new Term(symbol,subterms);
    }

}


String ElanString() :
{
  String stringValue = new String();
  int code;
}
{
  (
   code=readInt() <DOT>
    {
      stringValue+= (new Character((char)code)).toString();
    }
    )* <NIL>
  {
    return "\"" + stringValue + "\"";
  }
}



Vector ElanTerms() :
{
  Vector subterms = new Vector(2);
  Term t;
}
{
  ( t=BuildElanTerm()
    {
      subterms.addElement(t);
    }
      <DOT>
    )* <NIL>
      {
	return subterms;
      }
}



BranchEvaluation Wheres(LineariseCondition linearConditions) :
{
  LocalEvaluation locEval;
  Vector list = new Vector(2);
  int max;
  
}
{
  ( 
   (   locEval = Condition()
     {
       list.addElement(locEval);
     }
     | locEval = Choice(linearConditions)
     {
       list.addElement(locEval);
     }
     | locEval = LocalAffectation()
     {
       ((LocalAffectation)locEval).linearise(linearConditions);
       list.addElement(locEval);
       if(Flags.debug && linearConditions.getConditions().size()>0) {
         System.out.println("linearise locEval: " + locEval);
       }
       
       for(int i=0 ; i<linearConditions.getConditions().size() ; i++) {
         list.addElement(linearConditions.conditionAt(i));
       }
       linearConditions.removeAllConditions();
     }
   )
     
   <DOT>
    )* <NIL>
     {
       return new BranchEvaluation(list);
     }
}

Condition Condition() :
{
  Term term;
  Condition cond;
}
{
  "IFF(" term=ElanTerm() ")"
    {
      cond = new Condition(term);
      return cond;
    }
}

LocalAffectation LocalAffectation() :
{
  Term leftside;
  Term rightside;
  Lexem strategyName=null;
  LocalAffectation where;
  int stratNameIndex;
  int intSort;
}
{
  "WHERE("
    leftside=ElanTerm() ","
    stratNameIndex = readInt() ","
    rightside=ElanTerm()
    ")"
    {
      if( stratNameIndex != -1 ) {
	strategyName = LexemStrategyName.get(stratNameIndex);
      }
      where = new LocalAffectation(leftside,strategyName,rightside);
      return where;
    }
  | "PWHERE("
    leftside=ElanTerm() ","
    intSort = readInt() ","
    stratNameIndex = readInt() ","
    rightside=ElanTerm()
    ")"
    {
      if( stratNameIndex != -1 ) {
	strategyName = LexemStrategyName.get(stratNameIndex);
      }
      where = new LocalAffectation(leftside,strategyName,rightside);
      return where;
    }
}

Choice Choice(LineariseCondition linearConditions) :
{
  Choice choice;
  Vector list = new Vector();
  BranchEvaluation branch; 
}
{
  "TRY("
    ( LOOKAHEAD(2) branch = Wheres(linearConditions) <DOT>
      {
	list.addElement(branch);
      } 
    )* <NIL> ")"
    {
      choice = new Choice(list);
      return choice;
    }
}

void StrategyDeclaration() :
{
  Strategy strat;
  Lexem stratName;
  int intModule;
  StrategyTerm rightside;
  int id;
  int idSort;
  Lexem sort;
}
{
  (
   "STRATEGY("
   id        = readInt() ","
   idSort    = readInt() ","
   intModule = readInt() ","
   rightside = StrategyBody()
   ")"
   ( <END> | <DOT> )
   {
     if(!Flags.quiet && !Flags.debug) {
       //System.out.print(".");
     }
     stratName = LexemStrategyName.get(id);
     sort = LexemSort.get(idSort);
     strat = new Strategy(stratName,sort,rightside);
     Strategy.addElement(strat);
   }
 )*
 <ENDDEF>
}

StrategyTerm StrategyBody() :
{
  StrategyTerm head;
  StrategyTerm tail=null;
  Vector subterms = new Vector(2);
}
{
  head=StrategyTerm()
    {
      subterms.addElement(head);
    }
  ( ";" tail=StrategyTerm()
    {
      subterms.addElement(tail);
    }
  )*
    {
      if(subterms.size() <= 1) {
	return head;
      } else {
	return new StrategyCons(subterms);
      }
    }
}

StrategyTerm StrategyTerm() :
{
  Vector subterms;
  StrategyTerm stratBody;
  StrategyTerm stratTerm;
  Lexem stratName;
  int id;
}
{
  "id"
    {
      return new StrategyId();
    }
  | "fail"
    {
      return new StrategyFail();
    }
  | "META"
    {
      return new StrategyMeta();
    }
  | "one(" subterms=RuleNames() ")" 
    {
      return new StrategyOneRule(subterms);
    }
  | "dc(" subterms=RuleNames() ")" 
    {
      return new StrategyDcRule(subterms);
    }
  | "dk(" subterms=RuleNames() ")" 
    {
      return new StrategyDkRule(subterms);
    }
  | "ONE(" subterms=StrategyTerms() ")" 
    {
      return new StrategyOneStrat(subterms);
    }
  | "DC(" subterms=StrategyTerms() ")" 
    {
      return new StrategyDcStrat(subterms);
    }
  | "DK(" subterms=StrategyTerms() ")" 
    {
      return new StrategyDkStrat(subterms);
    }
  | "repeat*(" stratBody=StrategyBody() ")" 
    {
      subterms = new Vector(1);
      subterms.addElement(stratBody);
      return new StrategyRepeat(subterms);
    }
  | "iterate*(" stratBody=StrategyBody() ")" 
    {
      subterms = new Vector(1);
      subterms.addElement(stratBody);
      return new StrategyIterate(subterms);
    }
  | "call(" stratName = StrategyName() ")" 
    {
      return new StrategyCall(stratName);
    }
}

Lexem StrategyName() :
{
  Lexem name;
  int id;
}
{
  id = readInt()
    {
      name = LexemStrategyName.get(id);
      if(name == null) {
	throw new InternalError("strategyName sym" + id + " not found");
      }
      return name;
    }
}


StrategyTerm RuleName() :
{
  Lexem name;
  int id;
}
{
  id = readInt()
    {
      name = LexemRuleName.get(id);
      if(name == null) {
	throw new InternalError("ruleName sym" + id + " not found");
      }
      return new StrategyRuleName(name);
    }
}

Vector RuleNames() :
{
  Vector subterms = new Vector(3);
  StrategyTerm t;
}
{
  t=RuleName()
    {
      subterms.addElement(t);
    }
  [ <DOT> ( t=RuleName() <DOT>
    {
      subterms.addElement(t);
    }
    )* <NIL>
  ]
    {
      return subterms;
    }
}


Vector StrategyTerms() :
{
  Vector subterms = new Vector(3);
  StrategyTerm t;
}
{
  t=StrategyBody()
    {
      subterms.addElement(t);
    }
  [
  ( "," t=StrategyBody()
    {
      subterms.addElement(t);
    }
    )+
  ]
    {
      return subterms;
    }
}

Query QueryDeclaration() :
{

  int intSourceSort;
  int intResultSort;
  Term startWith;
  Term checkWith;
  int stratNameIndex;	
  Lexem strategyName=null;
  int id;	
}
{
   "QUERY("
   intSourceSort   = readInt() ","
   intResultSort   = readInt() ","
   stratNameIndex = readInt() ","
   startWith         = ElanTerm() ","
   checkWith         = ElanTerm()
   ")"
   {
     if( stratNameIndex != -1 ) {
	strategyName = LexemStrategyName.get(stratNameIndex);
     } 
     return new Query(intSourceSort,strategyName,startWith);
   }
}




// Old switch

RightHandSide ElanRightHandSide(LineariseCondition LinearConditions) :
{
  Term rightside;
  BranchEvaluation wheres;
  Vector caseTerm,caseRhs;
}
{
  "NOSWITCH(" wheres=Wheres(LinearConditions) "," rightside=ElanTerm() ")"
    {
      return new RhsNoSwitchTerm(rightside,wheres);
    }
  | "SWITCH("
    {
      caseTerm=new Vector();
      caseRhs=new Vector();
    }
      wheres=Wheres(LinearConditions) "," SwitchBranchs(caseTerm,caseRhs,LinearConditions) ")"
    {
      return new RhsSwitchTerm(caseTerm,caseRhs,wheres);
    }
}

void SwitchBranchs(Vector caseList, Vector caseRhs,
                   LineariseCondition LinearConditions) :
{
  Term caseTerm;
  RightHandSide rightside;
}
{
  ( caseTerm=ElanTerm() "," rightside=ElanRightHandSide(LinearConditions)
    {
      caseList.addElement(caseTerm);
      caseRhs.addElement(rightside);
    }
      <DOT>
    )* <NIL>
}
