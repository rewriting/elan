PARSER_BEGIN(REFParser)
import java.util.Vector;

public class REFParser {

}

PARSER_END(REFParser)

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
|  <"//" (~["\n","\r"])* ("\n" | "\r" | "\r\n")>
|  <"/*" (~["*"])* "*" ("*" | ~["*","/"] (~["*"])* "*")* "/">
}

TOKEN : {
   <INTEGER: (["0"-"9"])+>
|  <CHARACTER_LITERAL: "\'" (~["\'","\\","\n","\r"] | "\\" (["n","t","b","r","f","\\","\'","\""] | ["0"-"7"] (["0"-"7"])? | ["0"-"3"] ["0"-"7"] ["0"-"7"])) "\'">
/*
|  <STRING_LITERAL: "\"" (~["\"","\\","\n","\r"] | "\\" (["n","t","b","r","f","\\","\'","\""] | ["0"-"7"] (["0"-"7"])? | ["0"-"3"] ["0"-"7"] ["0"-"7"]))* "\"">
*/
|  <STRING_LITERAL: "\"" (~["\"","\\","\r"] | "\\" (["n","t","b","r","f","\\","\'","\""] | ["0"-"7"] (["0"-"7"])? | ["0"-"3"] ["0"-"7"] ["0"-"7"]))* "\"">
}

TOKEN : {
   < LEXEM_DECLARATION: "Identifiers" >
 | < SORT_DECLARATION: "Sorts" >
 | < MODULE_DECLARATION: "Modules" >
 | < RULENAME_DECLARATION: "RuleNames" >
 | < STRATEGYNAME_DECLARATION: "StrategyNames" >
 | < ENDDEF: "EndDef" >
 | < END: "end" >
 | < NIL: "nil" >
 | < DOT: "." >
 | < COMMA: "," >
}

/*
TOKEN : {
 <IDENTIFIER: <LETTER> (<LETTER> | <DIGIT>)*>
|  <#LETTER: ["$","A"-"Z","_","a"-"z"]>
|  <#DIGIT: ["0"-"9"]>
}
*/

int readInt() :
{
  boolean negative = false;
  Token token;	
  int res;
}
{
  ["-" {negative=true;}]
  token = <INTEGER>
  {
    res = Integer.parseInt(token.image);
    if(negative)
      res = -res;
    return res;
  }
}

Query Start(OutputCode s) :
{
  Query query;
  int numberOfGrammarRule = 0;
}
{
  
  <LEXEM_DECLARATION>        LexemIdentifierDeclaration()
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  <SORT_DECLARATION>         LexemSortDeclaration()
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  <MODULE_DECLARATION>       LexemModuleDeclaration()
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  <RULENAME_DECLARATION>     LexemRuleNameDeclaration()
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  <STRATEGYNAME_DECLARATION> LexemStrategyNameDeclaration()
  ( <END> | <COMMA> )
    {
      if(!Flags.quiet && !Flags.debug) System.out.print(".");
        // Tables for Earley
      s.write("int gram[] = {\n");
    }

  numberOfGrammarRule = GrammarDeclaration(s,numberOfGrammarRule)
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  numberOfGrammarRule = GrammarDeclaration(s,numberOfGrammarRule)
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  numberOfGrammarRule = GrammarDeclaration(s,numberOfGrammarRule)
    {
      if(!Flags.quiet && !Flags.debug) System.out.print(".");
        // Tables for Earley
      s.write("0};\n");
      s.write("int pos = " + numberOfGrammarRule + ";\n");
    }

  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  RuleDeclaration()
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  StrategyDeclaration()
  ( <END> | <COMMA> )
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  query = QueryDeclaration()
    { if(!Flags.quiet && !Flags.debug) System.out.print("."); }
  [ <END> ]
  <EOF>
    { if(!Flags.quiet && !Flags.debug) System.out.println(""); }

    {
      return query;
    }
}

void LexemIdentifierDeclaration() :
{
  Token tokenId;
  int id;
  String lexName;
  Lexem lex;
}
{
  ( id=readInt() ":" tokenId=<STRING_LITERAL> <DOT>
    {
      lexName = tokenId.image.substring(1,tokenId.image.length()-1);
      lex = new LexemIdentifier( id, lexName );
      lex.put();
    }
    )* <NIL>
}

