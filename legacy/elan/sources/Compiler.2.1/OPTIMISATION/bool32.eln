module bool32

import eq[Bool3] bool;
end

sort Bool3;
end

operators global
  b0		: Bool3;
  b1		: Bool3;
  b2		: Bool3;

  a1		: Bool3;
  a2		: Bool3;
  a3		: Bool3;
  a4		: Bool3;
  a5		: Bool3;
  a6		: Bool3;
  a7		: Bool3;
  a8		: Bool3;

  p(@,@)	: (Bool3 Bool3) Bool3 (AC);
  m(@,@)	: (Bool3 Bool3) Bool3 (AC);

  p2(@,@)	: (Bool3 Bool3) Bool3 ;
  m2(@,@)	: (Bool3 Bool3) Bool3 ;
  f(@)		: (Bool3) Bool3 ;


  and(@,@)	: (Bool3 Bool3) Bool3;
  or(@,@)	: (Bool3 Bool3) Bool3;
  not(@)	: (Bool3) Bool3;

  start		: bool;
end

rules for Bool3
	X,Y,Z,P,Q,R : Bool3;
	mX,mY,mZ,tZ : Bool3;
global
  [] p(X, p(X, X)) => f(b0) end
  [] p(f(b0), X) => X end

  [] m(f(b1), X) => X end
  [] m(X, m(X, X)) => X end
  [] m(f(b0), X) => f(b0) end
  [] m(p(X, Y), Z) => p(m(X, Z), m(Y, Z)) end

 

  [] p2(P,Q) => p(f(P),f(Q)) end
  [] m2(P,Q) => m(f(P),f(Q)) end
  [] f(f(P)) => f(P) end
  [] p(P,f(p(Q,R))) => p(P,p(Q,R)) end
  [] m(P,f(m(Q,R))) => m(P,m(Q,R)) end


  [] b2 => p2(b1, b1) end
  [] and(X,Y) =>
		   p2( m2(mX, mY),
                   p2( m2(b2, m2(mX, Y)),
                   p2( m2(b2, m2(mY, X)),
                   m2(b2, m2(X, Y)) )))
	where mX:=() m2(X,X)
	where mY:=() m2(Y,Y)
  end
  [] or(X,Y) =>   p2( m2(b2, m2(mX, mY)),
                  p2( m2(mX, Y),
                  p2( m2(mY, X),
                  p2( m2(X, Y),
                  p2(X, Y) ))))
	where mX:=() m2(X,X)
	where mY:=() m2(Y,Y)
  end

  [] not(X) => p2(m2(b2, X), b1) end
end

rules for bool
global
  [] start => and(a1, a2) == not(or(not(a1), not(a2))) end
end

end

