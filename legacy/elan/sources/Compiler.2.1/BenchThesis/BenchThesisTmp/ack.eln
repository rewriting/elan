module ack

sort Nat;
end

operators
global
  o : Nat;
  s(@)		: (Nat) Nat;
  ack(@,@)	: (Nat Nat) Nat;
end


rules for Nat
  x,y : Nat;
global 
  [] ack(o,x) => s(x)				end
  [] ack(s(x),o) => ack(x,s(o))			end
  [] ack(s(x),s(y)) => ack(x,ack(s(x),y))	end
end

end

