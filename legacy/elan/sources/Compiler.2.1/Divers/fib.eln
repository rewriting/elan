module fib
	// First import the integers
import global int;
end

	// And now all the operators of interest to build simple
	// monomials and polynomials
operators global
 fib(@)  : (int) int ;
 fac(@)  : (int) int ;
end

rules for int 
	n : int ;
global
    [] fib(n) => 1 if n==0 end
    [] fib(1) => 1 end
    [] fib(n) => fib(n - 1) + fib(n - 2) 
	if n > 1
    end

    [] fac(1) => 1 end
    [] fac(n) => n*fac(n - 1)
	if n > 1
    end

end

end
