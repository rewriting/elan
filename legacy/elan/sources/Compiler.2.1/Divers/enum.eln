module enum

import 	global int ;

end

operators

global

  f(@): (int) int ;
  next(@): (int) int ;
  enum(@,@): (int int) int ;

end

stratop global 
  enumStrat : <int> builtin ;
end

rules for int 

i,j,k,l: int ;

global 

// no-named rules applied leftmost innermost
[] f(i) => i end           // the identity
[] next(i) => i+1 end      // the incrementation

// named rules applied with the strategy enumStrat
[r1] enum(i,j) => f(i) end
[r2] enum(i,j) => l
                  if i<j
                  where k:=  () next(i) 
                  where l:= (enumStrat) enum(k,j)
                  end
end

strategies for int
   implicit
   [.] enumStrat => dk(r1,r2) end
end

end
