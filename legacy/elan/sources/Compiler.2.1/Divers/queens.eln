module queens
import 
  bool int list[int];
end
operators
  global
    queens	: list[int];
  local
    ok(@,@,@)	: ( int int list[int] ) bool;
end

stratop 
  global
	queens	: <list[int]>	builtin;
  local
	select	: <int>		builtin;
end

rules for list[int]
        p1,p2,p3,p4,p5,p6,p7,p8 : int;
	pp1,pp2,pp3,pp4,pp5,pp6,pp7,pp8 : list[int];
local
   [queensrule] queens	=> p8.pp7
			where p1:=(select) 0
			where p2:=(select) 0
			where pp1:=() p1.nil
			if ok(1,p2,pp1)
			where p3:=(select) 0
			where pp2:=() p2.pp1
			if ok(1,p3,pp2)
			where p4:=(select) 0
			where pp3:=() p3.pp2
			if ok(1,p4,pp3)
			where p5:=(select) 0
			where pp4:=() p4.pp3
			if ok(1,p5,pp4)
			where p6:=(select) 0
			where pp5:=() p5.pp4
			if ok(1,p6,pp5)
			where p7:=(select) 0
			where 	pp6:=() p6.pp5
			if ok(1,p7,pp6)
			where p8:=(select) 0
			where pp7:=() p7.pp6
			if ok(1,p8,pp7)
  end
end

rules for bool
          p,d,diff : int;
	l : list[int];
global
  [] ok(diff,d,nil)	=> true				end
  [] ok(diff,d,p.l)	=> false	if d == p  	end
  [] ok(diff,d,p.l)	=> false        if d-p == diff  end
  [] ok(diff,d,p.l)	=> false        if p-d == diff  end
  [] ok(diff,d,p.l)	=> ok(diff+1,d,l)		end
end


rules for int
x:int;
local
  [selectrule] x	=> 1	end
  [selectrule] x	=> 2	end
  [selectrule] x	=> 3	end
  [selectrule] x	=> 4	end
  [selectrule] x	=> 5	end
  [selectrule] x	=> 6	end
  [selectrule] x	=> 7	end
  [selectrule] x	=> 8	end
end

strategies for int
implicit
  [] select => dk(selectrule) end
end

strategies for list[int]
implicit
  [] queens => dk(queensrule) end
end

