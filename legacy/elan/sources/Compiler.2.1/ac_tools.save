/*
 * Ces procedures permettent d'extraire des elements identiques
 * is_maximal : tous les elements sans backtracking possible
 * minimal : un seul element repestant la multiplicite est extrait
 * maximal : tous les elements repestant la multiplicite sont extraits
 */


/*
 * retourne 1 s'il y a une solution
 */
int is_maximal_identical_element(struct term *t, 
				 int multiplicity,
				 struct term **ptr_list_x) {
  struct cell_term *cell;
  struct term *list_x;
  
  int res=1;
  for(cell=term_first(t) ; res && cell!=NULL ; cell=cell_next(cell)) {
    res = res && (cell_mult(cell)%multiplicity==0);
  }

  if(res!=1) {
    return 0;
  }
  if(isShared(t)) {
    TERM_ALLOC(*ptr_list_x,termac,getSymb(t));
    list_x=(*ptr_list_x);
    for(cell=term_first(t) ; cell!=NULL ; cell=cell_next(cell)) {
      setShared(cell_t(cell));
      term_add_last(list_x,cell_t(cell));
      cell_mult(cell) = cell_mult(cell)/multiplicity;
      setColor(term_last(list_x),getColor(cell));
    }
  } else {
    for(cell=term_first(t) ; cell!=NULL ; cell=cell_next(cell)) {
      cell_mult(cell) = cell_mult(cell)/multiplicity;
    }
  }
  return 1;
}

// TODO: color
void extract_maximal_identical_element(struct term *t, 
				       int multiplicity,
				       struct term **ptr_list_x,
				       struct term **ptr_list_y) {
  struct cell_term *cell;
  struct term *list_x;
  struct term *list_y;

  if(isShared(t)) {
    TERM_ALLOC(*ptr_list_x,termac,getSymb(t));
    TERM_ALLOC(*ptr_list_y,termac,getSymb(t));
    list_x=(*ptr_list_x);
    list_y=(*ptr_list_y);

    for(cell=term_first(t) ; cell!=NULL ; cell=cell_next(cell)) {
      int cell_mult = cell_mult(cell);
      setShared(cell_t(cell));
      
      if(cell_mult>=multiplicity) {
	// extract and copy the cell
	term_add_last(list_x,cell_t(cell));
	cell_mult(term_last(list_x)) = cell_mult/multiplicity;
	// update the context
	if(cell_mult%multiplicity!=0) {
	  term_add_last(list_y,cell_t(cell));
	  cell_mult(term_last(list_y)) = cell_mult%multiplicity;
	}
      } else {
	// copy the context
	term_add_last(list_y,cell_t(cell));
	cell_mult(term_last(list_y))=cell_mult;
      }
    }
    //printf("xy noshared %d\n",xy_noshared++);
  } else {
    struct cell_term *last_cell;
    struct cell_term *next_cell;

    //printf("xy shared\n");    

        
    (*ptr_list_y)=t;
    TERM_ALLOC(*ptr_list_x,termac,getSymb(t));
    list_x=(*ptr_list_x);

    for(cell=term_first(t), last_cell=term_first(t) ; cell != NULL ; cell=next_cell) {
      int cell_mult = cell_mult(cell);
      next_cell=cell_next(cell);
      if(cell_mult<multiplicity) {
	// do nothing
	last_cell=cell;
      } else {
	if(cell_mult%multiplicity==0) {
	  // move the cell
	  cell_delete(last_cell,cell,t);
	  cell_next(cell)=NULL;
	  cell_add_last(cell,list_x);
	  cell_mult(cell)=cell_mult/multiplicity;
	} else {
	  // modifying the multiplicity of the context
	  cell_mult(cell)=cell_mult%multiplicity;
	  last_cell=cell;
	  // and copying the cell
	  setShared(cell_t(cell));
	  term_add_last(list_x,cell_t(cell));
	  cell_mult(term_last(list_x))=cell_mult/multiplicity;
	}
      }
    }
    
    /*
    (*ptr_list_x)=t;
    TERM_ALLOC(*ptr_list_y,termac,getSymb(t));
    list_y=(*ptr_list_y);
    
    for(cell=term_first(t), last_cell=term_first(t), i=0 ;
	cell != NULL ; cell=next_cell, i++) {
      int cell_mult = cell_mult(cell);
      next_cell=cell_next(cell);
      if(cell_mult>=multiplicity) {
	// modify the multiplicity of selected cell
	cell_mult(cell)=cell_mult/multiplicity;
	last_cell=cell;
	if(cell_mult>multiplicity) {
	  // copying the context
	  setShared(cell_t(cell));
	  term_add_last(list_y,cell_t(cell));
	  cell_mult(term_last(list_y))=cell_mult%multiplicity;
	}
      } else {
	// move the context
	cell_delete(last_cell,cell,t);
	cell_next(cell)=NULL;
	cell_mult(cell)=cell_mult;
	cell_add_last(cell,list_y);
      }
    }
    */

  }
}

// TODO: color
void extract_minimal_identical_element(struct term *t, 
				       int multiplicity,
				       struct term **ptr_list_x,
				       struct term **ptr_list_y) {
  struct cell_term *cell;
  struct term *list_x;
  struct term *list_y;
  int found=0;

  if(isShared(t)) {
    TERM_ALLOC(*ptr_list_x,termac,getSymb(t));
    TERM_ALLOC(*ptr_list_y,termac,getSymb(t));
    list_x=(*ptr_list_x);
    list_y=(*ptr_list_y);

    for(cell=term_first(t) ; cell!=NULL ; cell=cell_next(cell)) {
      int cell_mult = cell_mult(cell);
      setShared(cell_t(cell));
      
      if(!found && cell_mult>=multiplicity) {
	found=1;
	// extract and copy the cell
	term_add_last(list_x,cell_t(cell));
	cell_mult(term_last(list_x)) = 1;
	// update the context
	if(cell_mult>multiplicity) {
	  term_add_last(list_y,cell_t(cell));
	  cell_mult(term_last(list_y)) = cell_mult-multiplicity;
	}
      } else {
	// copy the context
	term_add_last(list_y,cell_t(cell));
	cell_mult(term_last(list_y))=cell_mult;
      }
    }
    //printf("xy noshared %d\n",xy_noshared++);
  } else {
    struct cell_term *last_cell;
    struct cell_term *next_cell;

    //printf("xy shared\n");    

        
    (*ptr_list_y)=t;
    TERM_ALLOC(*ptr_list_x,termac,getSymb(t));
    list_x=(*ptr_list_x);

    for(cell=term_first(t), last_cell=term_first(t) ; cell != NULL ; cell=next_cell) {
      int cell_mult = cell_mult(cell);
      next_cell=cell_next(cell);
      if(cell_mult<multiplicity) {
	// do nothing
	last_cell=cell;
      } else if(!found) {
	found=1;
	if(cell_mult==multiplicity) {
	  // move the cell
	  cell_delete(last_cell,cell,t);
	  cell_next(cell)=NULL;
	  cell_add_last(cell,list_x);
	  cell_mult(cell)=1;
	} else {
	  // modifying the multiplicity of the context
	  cell_mult(cell)=cell_mult-multiplicity;
	  last_cell=cell;
	  // and copying the cell
	  setShared(cell_t(cell));
	  term_add_last(list_x,cell_t(cell));
	  cell_mult(term_last(list_x))=1;
	}
      }
    }
  }
}


static int sub_noshared=0;
static int sub_shared=0;

void substitution_build(struct term *t, match_state *ms,
			int nb_variable, struct term *substitution[],
			int nb_variable_ac,
			void (*variable_extract)()
			)
{
  int i,no_pattern;

  struct term *subject[MAX_TERM_SIZE];
  struct term *list_x;
  struct cell_term *cell;
  struct cell_term *copy_cell;
  int *pattern_list;
  int indice;


  /*
   * si le terme est partage
   * dans un premier temps on fait comme si le terme etait partage
   * (pas de recuperation de morceaux)
   */
  if(1 || isShared(t) ) {
    //printf("sub_shared   %d\n",sub_shared++);
    TERM_ALLOC(list_x,termac,getSymb(t));

    for(cell=term_first(t),i=0 ; cell != NULL ; cell=cell_next(cell),i++) {
      // mise du sujet dans un tableau
#ifdef DEBUG
      if(i >= MAX_TERM_SIZE) {
	term_printnl(stdout,t);
	fprintf(stderr,"subject too big\n");
	fprintf(stderr,"substitution_build : i >= MAX_TERM_SIZE\n");
	exit(1);
      }
#endif
      subject[i]=cell_t(cell);
      //      printf(" subject[%d] = ",i); term_printnl(stdout,subject[i]);
      /*
       * S'il y a une variable AC (un contexte) 
       * les elements non completement capture sont copie dans le contexte
       */
      if(nb_variable_ac >= 1 && ms->bg_multiplicity[i] != 0) {
#ifdef AFFICHAGE
	//indent(indentlevel);
	term_print(stdout,cell_t(cell));
	printf("\t[mult=%d] --> copier dans list_x\n", ms->bg_multiplicity[i]);
#endif
	CELL_ALLOC(copy_cell);
	cell_t(copy_cell)=cell_t(cell);
	setShared(cell_t(cell));
	cell_mult(copy_cell)=ms->bg_multiplicity[i];
	setColor(copy_cell,getColor(cell));
	/* ajout dans list_x */
	cell_add_last(copy_cell,list_x);
      }
    }
  } else {
    cell = term_first(t);
    list_x=t;
    term_first(list_x)=NULL;
    term_last(list_x)=NULL;

    //printf("sub_noshared %d\n",sub_noshared++);

    for(i=0 ; cell != NULL ; cell=cell_next(cell),i++) {
      // mise du sujet dans un tableau
      subject[i]=cell_t(cell);
      //printf("subject[%d] = ",i); term_printnl(stdout,subject[i]);


      /*
       * S'il y a une variable AC (un contexte) 
       * les elements non completement capture sont copie dans le contexte
       */
      if(nb_variable_ac >= 1 && ms->bg_multiplicity[i] != 0) {
	//term_print(stdout,cell_t(cell));
	//printf("\t[mult=%d] --> deplacer dans list_x\n", ms->bg_multiplicity[i]);

	if(cell_mult(cell)!=ms->bg_multiplicity[i]) {
	  setShared(cell_t(cell));
	  cell_mult(cell)=ms->bg_multiplicity[i];
	}

	/* ajout dans list_x */
	cell_add_last(cell,list_x);
	//printf("list_x = "); term_printnl(stdout,list_x);

      }
    }
    if(term_last(list_x)!=NULL) {
      cell_next(term_last(list_x))=NULL;
    }
  }
  
  //printf("fin de construction de list_x\n");

  indice=0;
  // sauvegarde du contexte dans substitution[0..nb_variable_ac-1]
  for(i=0 ; i<nb_variable_ac ; i++) {
    substitution[i] = list_x;
    indice++;
  }

  //printf("substitution[0] = "); term_printnl(stdout,substitution[0]);
  //printf("ms->no_rule=%d\n",ms->no_rule);
  pattern_list=MS_get_pattern_list(ms,ms->no_rule);
  //printf("ac_tools: pattern_list=%d\n",pattern_list);

  for(no_pattern=0 ; no_pattern < BG_size(ms->bg) ; no_pattern++) {
    int no_arg_subject;
    int id_pattern;
      
    no_arg_subject=ms->bg_solution[no_pattern];
    id_pattern=pattern_list[no_pattern];

    //printf("start variable_extract\n");
    variable_extract(subject[no_arg_subject],
		     id_pattern,
		     substitution,&indice,
		     // Pour le 2eme niveau :
		     ms,
		     no_arg_subject,
		     no_pattern
		     );
    //printf("end variable_extract\n");

  }
}

/*
 * Cette variante ne recupere pas l'instance des variables sous AC
 */
void substitution_build_without_context(struct term *t, match_state *ms,
					int nb_variable, struct term *substitution[],
					int nb_variable_ac,
					void (*variable_extract)()
					)
{
  int i,no_pattern;

  //struct term *subject[MAX_TERM_SIZE];
  struct cell_term *cell;
  int *pattern_list;
  int indice;

  /*
  for(cell=term_first(t),i=0 ; cell != NULL ; cell=cell_next(cell),i++) {
    // mise du sujet dans un tableau
#ifdef DEBUG
    if(i >= MAX_TERM_SIZE) {
      term_printnl(stdout,t);
      fprintf(stderr,"subject too big\n");
      fprintf(stderr,"substitution_build : i >= MAX_TERM_SIZE\n");
      exit(1);
    }
#endif
    subject[i]=cell_t(cell);
  }
  */


  indice=nb_variable_ac;

  pattern_list=MS_get_pattern_list(ms,ms->no_rule);
  for(no_pattern=0 ; no_pattern < BG_size(ms->bg) ; no_pattern++) {
    int no_arg_subject;
    int id_pattern;
      
    no_arg_subject=ms->bg_solution[no_pattern];
    id_pattern=pattern_list[no_pattern];

    for(cell=term_first(t),i=0 ; i<no_arg_subject ; cell=cell_next(cell),i++)
      /* do nothing */;
    
    //printf("i=%d\tno_arg_subject=%d\n",i,no_arg_subject);

    //printf("start variable_extract\n");
    variable_extract(cell_t(cell), //subject[no_arg_subject],
		     id_pattern,
		     substitution,&indice,
		     // Pour le 2eme niveau :
		     ms,
		     no_arg_subject,
		     no_pattern
		     );
    //printf("end variable_extract\n");

  }
}

struct term *rest_extract(struct term *t, match_state *ms)
{
  int i;
  struct term *list_x;
  struct cell_term *cell;
  struct cell_term *copy_cell;

  /*
   * si le terme est partage
   */
  if(isShared(t)) {
    TERM_ALLOC(list_x,termac,getSymb(t));

    for(cell=term_first(t),i=0 ; cell != NULL ; cell=cell_next(cell),i++) {
      if(ms->bg_multiplicity[i] != 0) {
#ifdef AFFICHAGE
	//indent(indentlevel);
	term_print(stdout,cell_t(cell));
	printf("\t--> copier dans list_x\n");
#endif
	CELL_ALLOC(copy_cell);
	cell_t(copy_cell)=cell_t(cell);
	cell_mult(copy_cell)=ms->bg_multiplicity[i];
	setColor(copy_cell,getColor(cell));
	addcounter(cell_t(cell));
	/* ajout dans list_x */
	cell_add_last(copy_cell,list_x);
      }
    }
    // ici : t->counter > 0
    //freeterm(t);
    return list_x;
  } else {
    struct cell_term *last_cell;
    struct cell_term *next_cell;
    
#ifdef AFFICHAGE
    //indent(indentlevel); printf("pas de partage\n");
    //indent(indentlevel); term_printnl(stdout,t);
#endif

      for(cell=term_first(t), last_cell=term_first(t), i=0 ;
	  cell != NULL ; cell=next_cell, i++)
	{
	  next_cell=cell_next(cell);

	  //printf("last_cell=%d\n",last_cell);
	  //printf("cell     =%d\n",cell);
	  //printf("next_cell=%d\n",next_cell);
	  //term_print(stdout,cell_t(cell));

	  if(ms->bg_multiplicity[i] != 0)
	    {
	      //printf("\t modif de la multiplicite\n");
	      cell_mult(cell)=ms->bg_multiplicity[i];
	      last_cell=cell;
	    }
	  else
	    {
	      //printf("\t destruction\n");
	      // destruction de la cellule
	      cell_delete(last_cell,cell,t);
	      subcounter(cell_t(cell));
#ifndef GCMEM
	      if(cell_t(cell)->counter == 0)
		freeterm(cell_t(cell));
#endif
	      cell_free(cell);
	    }
	}
      return t;
    }
}

static int xy_noshared=0;
static int xy_shared=0;

void extract_xy_from_pe(struct term *t, int *E, int *sol, int multiplicity,
			struct term **ptr_list_x,struct term **ptr_list_y)
{
  struct cell_term *cell;
  struct term *list_x;
  struct term *list_y;
  int i;
  // 1 || pour color
  if(isShared(t)) {
    TERM_ALLOC(*ptr_list_x,termac,getSymb(t));
    TERM_ALLOC(*ptr_list_y,termac,getSymb(t));
    list_x=(*ptr_list_x);
    list_y=(*ptr_list_y);

    for(cell=term_first(t), i=0 ; cell!=NULL ; cell=cell_next(cell), i++) {
      setShared(cell_t(cell));
      
      if(sol[i] == 0) {
	term_add_last(list_y,cell_t(cell));
	cell_mult(term_last(list_y))=E[i];
	setColor(term_last(list_y),getColor(cell));
      } else {
	// copier la cellule
	term_add_last(list_x,cell_t(cell));
	cell_mult(term_last(list_x))=sol[i]/multiplicity;
	setColor(term_last(list_x),getColor(cell));
	// copier le reste
	if(E[i] > sol[i]) {
	  term_add_last(list_y,cell_t(cell));
	  cell_mult(term_last(list_y))=E[i]-sol[i];
	  setColor(term_last(list_y),getColor(cell));
	}
      }
    }
    //printf("xy noshared %d\n",xy_noshared++);
  } else {
    struct cell_term *last_cell;
    struct cell_term *next_cell;

    //printf("xy shared   %d\n",xy_shared++);    
    //printf("extract_xy_from_pe : pas de partage\n");
    //term_printnl(stdout,t);

    (*ptr_list_x)=t;
    TERM_ALLOC(*ptr_list_y,termac,getSymb(t));
    list_y=(*ptr_list_y);

    for(cell=term_first(t), last_cell=term_first(t), i=0 ;
	cell != NULL ; cell=next_cell, i++) {
      next_cell=cell_next(cell);
      
      //printf("last_cell=%d\n",last_cell);
      //printf("cell     =%d\n",cell);
      //printf("next_cell=%d\n",next_cell);
      //term_print(stdout,cell_t(cell));


      if(sol[i]!=0) {
	//if(E[i]==sol[i]==0)
	//printf("\t modifier list_x sans toucher list_y\n");
	cell_mult(cell)=sol[i]/multiplicity;
	last_cell=cell;
	if(E[i]>sol[i]) {
	  //printf("\t modifier list_x et copier dans list_y\n");
	  setShared(cell_t(cell));
	  term_add_last(list_y,cell_t(cell));
	  cell_mult(term_last(list_y))=E[i]-sol[i];
	  setColor(term_last(list_y),getColor(cell));
	}
      } else {
	// C'EST ICI QU'IL FAUT OPTIMISER
	//printf("\t deplacer dans list_y\n");
	cell_delete(last_cell,cell,t);
	cell_next(cell)=NULL;
	cell_mult(cell)=E[i]-sol[i];
	cell_add_last(cell,list_y);
      }

      /*
      if(sol[i]!=0) {
	if(E[i]-sol[i]==0) {
	  //printf("\t modifier list_x sans toucher list_y\n");
	  cell_mult(cell)=sol[i]/multiplicity;
	  last_cell=cell;
	} else {
	  //printf("\t modifier list_x et copier dans list_y\n");
	  cell_mult(cell)=sol[i]/multiplicity;
	  setShared(cell_t(cell));
	  term_add_last(list_y,cell_t(cell));
	  cell_mult(term_last(list_y))=E[i]-sol[i];
	  last_cell=cell;
	}
      } else {
	if(E[i]-sol[i]!=0) {
	  //printf("\t deplacer dans list_y\n");
	  cell_delete(last_cell,cell,t);
	  cell_next(cell)=NULL;
	  cell_mult(cell)=E[i]-sol[i];
	  cell_add_last(cell,list_y);
	}
      }
      */

    }
  }
}

/*
 * E[] contient les multiplicites des cellules
 * sol[] est initialise a 0
 * taille est initialise avec la taille de E[]-1
 * la solution sol[]=0 n'est pas retournee
 */

int minimal_extract_fail(int taille,int E[], int sol[], int multiplicity)
{
  int i;

 start:
  for(i=taille, sol[i]+=multiplicity ; i>=0 && sol[i]>E[i] ; ) {
    sol[i]=0;
    sol[--i]+=multiplicity;
  }

  if(i<0) {
    return 0;
  } else {
    if(setChoicePoint()) {
      goto start;
    } else {
      return 1;
    }
  }
}

int maximal_extract_fail(int taille,int E[], int sol[], int multiplicity)
{
  int i;
  int borneInf=taille+1;

  for(i=taille ; i>=0 ; i--) {
    sol[i]=E[i] - (E[i]%multiplicity);
    if(sol[i]>0)
      borneInf=i;
  }
  // on ajoute 1 au compteur
  sol[taille]+=multiplicity;

 start:
  i=taille;
  sol[i]-=multiplicity;
  for( ; i>=0 && sol[i]<0 ; ) {
    sol[i]=E[i] - (E[i]%multiplicity);
    sol[--i]-=multiplicity;
  }
  if(sol[borneInf]==0)
    borneInf++;
  if(i<0 || borneInf>taille) {
    //printf("plus de sol\n");
    return 0;
  } else {
    if(setChoicePoint()) {
      //printf("next sol\n");
      goto start;
    } else {
      return 1;
    }
  }
}

int next_pe_extract(int pos,int E[], int sol[], int multiplicity)
{
  if(pos<0) {
    return -1;
  }
  sol[pos]+=multiplicity;
  if(sol[pos]<=E[pos]) {
      return pos;
  }
  /* il faut propager la retenue */
  sol[pos]=0;
  return next_pe_extract(pos-1,E,sol,multiplicity);
}

int next_pe_extract_fail(int pos,int E[], int sol[], int multiplicity)
{
  int res;
 start:
  res=next_pe_extract(pos,E,sol,multiplicity);
  if(res<0) {
    //printf("Plus de solution\n");
    return res;
  } 
  if(setChoicePoint()) {
    goto start;
  }
  return res;
}


int next_pe_extract2(int total, int pos,int E[], int sol[], int multiplicity)
{
  int i;
  if(pos<0) {
    return -1;
  }
  if(total == 0) {
    for(i=0 ; i<=pos ; i++) {
      sol[i]=E[i] - (E[i]%multiplicity);
      total+=sol[i];
    }
    return total;
  }
  sol[pos]-=multiplicity;
  total-=multiplicity;
  if(sol[pos] >= 0) {
    return total;
  }
  /* il faut propager la retenue */
  total-=sol[pos];
  sol[pos] = E[pos] - (E[pos]%multiplicity);
  total+=sol[pos];
  return next_pe_extract2(total,pos-1,E,sol,multiplicity);
}

int next_pe_extract2_fail(int total,int pos,int E[], int sol[], int multiplicity)
{
  int res;
  res=next_pe_extract2(total,pos,E,sol,multiplicity);
  goto next;
 start:
  res=next_pe_extract2(res,pos,E,sol,multiplicity);
 next:
  //printf("total = %d\tres = %d\n",total,res);
  if(res<=0) {
    //printf("no more solution\n");
    return res;
  } 
  if(setChoicePoint()) {
    //printf("next solution\n");
    goto start;
  }
  return res;
}

int match_subterm_AC(int base_id_pattern,
		     int no_arg_subject,
		     int *mask,
		     BG *cbg,
		     int (*my_match_subterm)(),
		     int nb_rule,
		     int **pattern_list,
		     int nb_pattern_in_cbg,
		     struct term *t,
		     int max_nb_pattern_under_AC) {
  /*
   * ici on construit le CBG principal
   */
  //int base_id_pattern=2;
  int id_pattern,no_rule;
  int nb_bit=0;
  match_state *ms;
  match_state *msbg;
  LINK *link;
  int necessary_link;
  int indice;

  //int pattern_tab[max_nb_pattern_under_AC];
  int *pattern_tab = (int*) MALLOC(max_nb_pattern_under_AC * sizeof(int));
  
  
  //  printf("match_subterm_AC:\n\tt = "); term_printnl(stdout,t);

  //ms=MS_create();
  /*
   * initialisation du match_state
   * 1 regle : p1(set(x),y))
   * 1 pattern_in_cbg : set(x)
   */
  necessary_link=0; // 1 niveau
  indice = MS_init(&ms, my_match_subterm, nb_rule, pattern_list, nb_pattern_in_cbg,
		   t, necessary_link, max_nb_pattern_under_AC);
  
  if(indice==-1) {
    /*
     * C'est que le MS est vide (pas de sous terme)
     */
    id_pattern=id_pattern+0;
    mask[nb_bit++]=id_pattern;
    //printf("c'est fini\n");
    return nb_bit;
    //printf("internal error in match_subterm_AC\n");
    //exit(1);
  }

  /*
   * Pour chaque BG du match_state qui a au moins une solution
   * on le memorise (sous la forme d'un match_state) dans le link
   * et on met a jour le mask
   */
#ifdef P2
  printf("  Creation du link\n");
#endif
  //	MS_print(ms); 
  //	printf("\n");
  
  for(no_rule=0 ; no_rule < ms->nb_rule ; no_rule++)
    {
      int nb_pattern;
      int nb_subterm_subject;
      int indice,i;
      
      int no_element;
      int *ms_pattern_tab;
      int **pattern_list2;
#ifdef P2
      printf("  BG no %d\n",no_rule);
#endif
      nb_pattern=MS_pattern_list_size(ms,no_rule);
      nb_subterm_subject=bitSet_size(BG_get(ms->cbg,0));
      
      msbg=MS_create();
      
      // --------------------------------------------------
      /* Creation d'une pattern list pour LA regle */
      pattern_list2=MS_pattern_list_create(1);
      // Copie de pattern_tab
      ms_pattern_tab=MS_get_pattern_list(ms,no_rule);
      for(no_element=0 ;
	  no_element < MS_pattern_list_size(ms,no_rule) ;
	  no_element++)
	{
	  pattern_tab[no_element] = ms_pattern_tab[no_element];
	}
      MS_pattern_list_init(pattern_list2,0,no_element,pattern_tab);
      msbg->pattern_list=pattern_list2;
      msbg->nb_rule=1;
      msbg->no_rule=0;
      msbg->cbg=NULL;
      // --------------------------------------------------
      
      /* Creation de bg */
      msbg->bg=BG_create(nb_pattern,0); // sans LINK
      /* Creation de bg_multiplicity */
      msbg->bg_multiplicity=(int*)IMALLOC(nb_subterm_subject*sizeof(int));
      /* Creation de bg_solution */
      msbg->bg_solution=(int*)IMALLOC(BG_size(msbg->bg)*sizeof(int));
      
      BG_cbg2bg(MS_get_pattern_list(ms,no_rule),ms->cbg,msbg->bg);
      
      /* initialisation de bg_solution */
      for(i=0 ; i<BG_size(msbg->bg) ; i++)
	msbg->bg_solution[i]=-1;
      /* initialisation de bg_multiplicity */
      for(i=0 ; i<nb_subterm_subject ; i++)
	msbg->bg_multiplicity[i]=ms->bg_multiplicity[i];
      
      /*
	printf("BG=");
	BG_print(msbg->bg);
	printf("\n");
	*/
      
      /* y-a-t-il une solution ? */
      indice=BG_solve_one(msbg->bg,msbg->bg_solution,msbg->bg_multiplicity,
			  bitSet_size(BG_get(msbg->bg,0)),0);  
#ifdef P2
      printf("y-a-t-il une solution ?, indice=%d\n",indice);
#endif
      
      if(indice>=0)
	{
	  //printf("Re-initialisation du msbg\n");
	  //for(i=0 ; i<BG_size(msbg->bg) ; i++)
	  //  msbg->bg_solution[i]=-1;
	  
	  // !!!!!!!!!!!!!!!!!!!!!!!!!!!
	  // 2 : no du subpattern commencant par p1
	  /*
	   * il faut etablir un correspondance entre les numeros
	   * des subpatterns de p2p1 et les subpattern de p2
	   * ici, set(x) : bit 0, de p2p1, correspond
	   * au subpattern p1(set(x),y) : bit 2, de p2
	   */
	  /*
	   * les patterns commencant par p1(...) sont numerotes:
	   * - base_id_pattern+0
	   * - base_id_pattern+1
	   * - base_id_pattern+2
	   * - ...
	   */
	  id_pattern=base_id_pattern+no_rule;
#ifdef P2
	  printf("id_pattern=%d\n",id_pattern);
#endif
	  // !!!!!!!!!!!!!!!!!!!!!!!!!!!
	  mask[nb_bit++]=id_pattern;
	  // Ancienne version
	  //bitSet32_set(mask,id_pattern);
	  //nb_bit++;
	  /*
	   * si le link existe deja on le complete sinon on le cree
	   */
	  link=BG_link_get(cbg,id_pattern);
	  if(link==NULL)
	    {
	      link=LINK_create(  bitSet_size(BG_get(cbg,id_pattern)) );
	      BG_link_set(cbg,id_pattern,link);
	    }
	  LINK_set(link,no_arg_subject,msbg);
	}
      else
	{
	  //printf("Pas de solution : il faut detruire le msbg\n"); 
	  /* il faut detruire le msbg */
	  MS_pattern_list_free(msbg->pattern_list,msbg->nb_rule);
	  MS_delete(msbg);
	}
    }
  // IL FAUT DETRUIRE : ms
  MS_delete(ms);
  return nb_bit;
}

