module wpatternAC2

// pattern with non-linearity and multiplicity
import eq[term];
end
sort term;
end

operators global
 a      : term;
 b      : term;
 c      : term;
 d      : term;
 e      : term;
 f      : term;

 go     : term;

 F(@,@) : (term term) term (AC);
 f(@,@) : (term term) term;
 g(@) : (term) term;
 h(@,@) : (term term) term;
end

stratop global
  s0 : <term> builtin;
end

rules for term
  x1,x2,x3 : term;
  y1,y2,y3 : term;
  z1,z2,z3 : term;
global
  [] go => F(g(a),F(g(b),F(c,F(g(a),a))))
  end

  [r0] F(x1,x2) => y1
	where (term) F(g(y1),F(y1,g(y1))) :=() x1
  end
end

strategies for term
implicit
  [.] s0 => dk(r0)
  end
end

end
