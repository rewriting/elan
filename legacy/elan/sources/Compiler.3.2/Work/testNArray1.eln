module testNArray1

import bool narray[1,Term];
end

sort Term;
end 

operators global
  go     : Term;
  empty  : Term; 
  a      : Term; 
  b      : Term; 
  c      : Term; 

  array1 : narray[1,Term];
  array2 : narray[1,Term];

end

rules for Term
 x,y : Term;
global

  [] go      => array2[0]
  end

end

rules for narray[1,Term]
  X    : narray[1,Term];
  tmp1 : narray[1,Term];
  tmp2 : narray[1,Term];

  
global
  [] array1      => X 
                    where tmp1 :=() new(2,empty)
                    where tmp2 :=() tmp1[0]<-a
                    where X :=()    tmp2[1]<-b
  end

  [] array2      => new(3,empty)
                    [0]<-c
		    [1]<-b
                    [2]<-a
  end

end

end
				




