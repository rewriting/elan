module ans
import
 global
    bool int 
    // list[int] list[message] list[AgentId] 
    cmp[AgentId]
    // cmp[Nonce]
;end

/*****************************************************************/

sort
  AgentId SWC Nonce
  Actor intruder
  TypMes Key Address
  message
  network 
  state
  listActor listNonce;
end

/*****************************************************************/

operators
 global
   a   : AgentId;
   b   : AgentId; 
   c   : AgentId;
   e   : AgentId;
   d   : AgentId; 
   ii  : AgentId;
   dai   : AgentId;  //dummy AgentId
  
   SLEEP  : SWC;
   WAIT   : SWC;
   COMMIT :SWC;

   MNA  : TypMes;
   MNNA : TypMes;
   MN   : TypMes;


   K(@)   : (AgentId) Key;

   N(@,@) : (AgentId AgentId) Nonce;
   DN     :  Nonce;  // Dummy Nonce

   A(@)   : (AgentId) Address;
   DA     :  Address;  // Dummy Address

   @ + @ + @  : ( AgentId SWC Nonce ) Actor; 

   @*@*@*@*@*@*@ : (AgentId AgentId Key TypMes Nonce Nonce Address) message;

   @  : (message) network;
   @ & @  : (network  network) network (AC);
   nill :network;

   @ # @ # @ # @ : ( AgentId listNonce listNonce  network ) intruder; 

   @ <> @ <> @ <> @ <> @ : ( listActor listActor intruder network int ) state;
   ATTACK  : state;
   ERROR   : state;

   @  : (Nonce) listNonce;
   @ | @ : ( listNonce listNonce) listNonce (AC);
   nl : listNonce;

   @ : (Actor) listActor;
   @ || @ : ( listActor  listActor ) listActor (AC);
   nnl  : listActor;

   delElem(@,@) : (Nonce listNonce) listNonce ;
   existNonce(@,@)  : (Nonce listNonce) bool; 

   existActor(@,@)  : (Actor listActor) bool;
   delActor(@,@)  : (Actor listActor) listActor;

   elemIN(@)   : (listNonce) Nonce ;
   elemIA(@)   : (listActor) Actor ;

end

/*****************************************************************/

stratop
 global
   com        : < state -> state > 		bs;
   attStrat   : < state -> state > 		bs;
   extAgent   : < AgentId -> AgentId >  	bs; 
   extNonce   : < Nonce -> Nonce >  		bs;
   extActor   : < Actor -> Actor >  		bs;
end
 
/*****************************************************************/

rules for state
	
         x,x1,x2,y,y1,y2,z,w,v,v1,t,k,r : AgentId;
         n1,n2,n3,n4 : AgentId;
	
         resp,init,dn : Nonce;

         I  : intruder;
         A,B  : Actor;
         E,E1,D,D1  : listActor;
         l,l1,ln  : listNonce;
         ls,ll : network;
         st : TypMes;
         cmp : int;
         st, std : SWC;

global


[rulescomAT1]
x+COMMIT+N(x,y) || E <> D <> I <> ls <> cmp => 
ATTACK
	if y!=ii
	if not(existActor(y+WAIT+N(y,x),D)) and
	   not(existActor(y+COMMIT+N(y,x),D))  
end


//--------------------------------------------------------------------
// attack on the sender

[rulescomAT2]
E <> y+COMMIT+N(y,x) || D <> I <> ls <> cmp => 
ATTACK
	if x!=ii
	if not(existActor(x+COMMIT+N(x,y),E))
end

//--------------------------------------------------------------
end


//--------------------------------------------------------------
// generate dummies

rules for Nonce
global
	[] DN => N(dai,dai)		 end 
end

rules for Address
global
	[] DA => A(dai)			 end 
end

//--------------------------------------------------------------
// eliminate duplicates
// delete elements
//  *** We must have always nl in listNonce ***

rules for listNonce
         m ,b : Nonce;
         l : listNonce; 
global
	[] m | m | l => m | l		 	end

	[] delElem(m,nl)  => nl 		end
	[] delElem(m,m|l) => l   		end
	[] delElem(m,b|l) => b | delElem(m,l)
		 // if m!=b
						end
end

//--------------------------------------------------------------
//  *** We must have always nl in listNonce ***

rules for bool
     x,y : Nonce;
     l : listNonce ;
global
    [] existNonce(x,nl)   => false		end
    [] existNonce(x,x|l)  => true		end
    [] existNonce(x,y|l)  => existNonce(x,l)
		 // if y!=x
					end
end

rules for bool
     x,y : Actor;
     l : listActor ;
global
    //[] existActor(x,x)    => true		end
    //[] existActor(x,y)    => false
		 // if y!=x
						//end
    [] existActor(x,nnl)   => false		end
    [] existActor(x,x || l)  => true		end
    [] existActor(x,y || l)  => existActor(x,l)   
		 // if y!=x
					end
end

rules for listActor
     x,y : Actor;
     l : listActor ;
global
    [] delActor(x,nnl)  => nnl 		end
    [] delActor(x,x || l) => l   		end
    [] delActor(x,y || l) => y || delActor(x,l)
		 // if y!=x
						end
end

//--------------------------------------------------------------
// eliminate doubletons in the network
// ***** DO WE LOSE MESSAGES ????  *****

rules for network
         resp,init : Nonce;
         x,y,z,w,v : AgentId;
	 ll : network;
global
[] z*x*K(y)*MN*resp*init*A(v) & z*x*K(y)*MN*resp*init*A(v) & ll =>
		z*x*K(y)*MN*resp*init* A(v) & ll      end
[] z*x*K(y)*MNA*resp*init*A(v) & z*x*K(y)*MNA*resp*init*A(v) & ll =>
		z*x*K(y)*MNA*resp*init* A(v) & ll     end
[] z*x*K(y)*MNNA*resp*init*A(v) & z*x*K(y)*MNNA*resp*init*A(v )& ll =>
		z*x*K(y)*MNNA*resp*init* A(v) & ll     end
 
end

//--------------------------------------------------------------
// Extract Rules

rules for Nonce
        m : Nonce;
	l : listNonce; 
global
	[extRuleNonce] elemIN(m | l) => m 		 end
end

rules for Actor
        m : Actor;
	l : listActor; 
global
	[extRuleActor] elemIA(m || l) => m		 end
end

//--------------------------------------------------------------
// Extract Rules

strategies for Nonce
implicit 
    []extNonce => dk(extRuleNonce) end
end

strategies for Actor
implicit 
    [] extActor => dk(extRuleActor) end
end

//--------------------------------------------------------------

strategies for state 
implicit 
    []com => 
		repeat*(
		        dk(
                           rulescomAT1,
                           rulescomAT2)
		) end


end

//--------------------------------------------------------------

end

