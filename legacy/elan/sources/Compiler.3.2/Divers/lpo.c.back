  for(i=1 ; i<argc && *argv[i]=='-' ; i++) {
    if(!strcmp(argv[i],"-noInput")) {
      queryMode=0;
    }
    if(!strcmp(argv[i],"-REFInput")) {
      queryMode=1;
    }
    if(!strcmp(argv[i],"-noOutput")) {
      ResultMode=0;
    }
    if(!strcmp(argv[i],"-REFOutput")) {
      ResultMode=1;
    }
    if(!strcmp(argv[i],"-internalOutput")) {
      ResultMode=3;
    }
