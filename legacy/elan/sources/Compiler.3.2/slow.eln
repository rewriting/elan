module bug

import global bool;
end
sort poly;
end
operators global

  go : poly;
  a : poly;
  b : poly;

  @ + @ 	: ( poly poly ) poly  assocRight pri 1 (AC);
  @ * @		: ( poly poly) poly  assocRight pri 2 (AC);

end

stratop global
  simplify	: <poly>	bs;
  S1		: <poly>	bs;
  S2		: <poly>	bs;
end

rules for poly
  P            : poly;
  absX1, absX2 : poly;
  p1,p2,p3,p4  : poly;
  X,Y,Z        : poly;
global

  [] go => a*b + a*b + a*b + a*b  + a*b 
	 + a*b + a*b + a*b + a*b  + a*b 
  end

  [expand] P + absX1*absX2	=> P if false
  end

  [R1] X => Y where Y:=(S1) X         end
  [R2] X+Y => X+Z where Z:=(S2) Y end
  [R2] X+Y => Z+Y where Z:=(S2) X end
  [R3] X*Y => X*Z where Z:=(S2) Y end
  [R3] X*Y => Z*Y where Z:=(S2) X end

end

strategies for poly
implicit

//  [] simplify => normalise( first one(expand) ) end
  [] simplify => repeat*(first one(R1,R2,R3)) end
  [] S2 => first one(R1,R2,R3) end
  [] S1 => first one(expand) end



/*
  [] simplify => repeat*(dc one(dc one(R1),dc one(R2),dc one(R3))) end
  [] S2 => dc one(dc one(R1),dc one(R2),dc one(R3)) end
  [] S1 => dc one(expand) end
*/

end

end

