  [.] tdexpand => first one(topexpand,id) ; 
		  first one(sexpand,id)
  end

  [.] sfactorize  => dc one(tone(repeat*(dc one(factorize))))  end
  [.] tdfactorize => first one(topfactorize,id) ; 
		     first one(sfactorize,id)
  end


end
*/

end



