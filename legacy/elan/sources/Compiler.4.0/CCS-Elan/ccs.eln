module ccs

import global bool eq[labelname];
end

sort ccst rccst label labelname procId resId relId;
end

operators global
  

  tau	: label pri 50;
  p(@)	: (labelname) label;
  @     : (labelname) label pri 1 alias p(@) :;
  q(@)	: (labelname) label;
  '\39' @ : (labelname) label alias q(@):;  // '@ is inverse Action  (39="'")

  @     : (procId) ccst 		pri 40;         //Defined Process
  0 	: ccst				pri 50;		//empty Process
  |(@,@) : (ccst ccst) ccst assocRight	pri 10;
  +(@,@) : (ccst ccst) ccst assocRight	pri 20;
  @ | @ : (ccst ccst) ccst assocRight 	pri 10 alias |(@,@):;         //parallel
  @ # @ : (ccst ccst) ccst assocRight 	pri 10 alias |(@,@):;         //parallel
  @ + @	: (ccst ccst) ccst assocRight 	pri 20 alias +(@,@):;         //choice
  @.@ : (label ccst) ccst 		pri 30;         //action
  (@) : (ccst) ccst;
  @ \ @: (ccst resId) ccst pri 5;
  @ [@]: (ccst relId) ccst pri 7;

  (@;;@)	: (label ccst) rccst;
  (;@)	: (ccst) rccst;



Knuth: procId;
K1: procId;
K2: procId;
C1_0: procId;
C1_1: procId;
C1_2: procId;
C2_0: procId;
C2_1: procId;
C2_2: procId;
P1: procId;
P11: procId;
P12: procId;
P13: procId;
P14: procId;
P15: procId;
P16: procId;
P17: procId;
P2: procId;
P21: procId;
P22: procId;
P23: procId;
P24: procId;
P25: procId;
P26: procId;
P27: procId;
KBig: procId;
L: resId;
c1r0: labelname;
c1r1: labelname;
c1r2: labelname;
c1w0: labelname;
c1w1: labelname;
c1w2: labelname;
c2r0: labelname;
c2r1: labelname;
c2r2: labelname;
c2w0: labelname;
c2w1: labelname;
c2w2: labelname;
enter1: labelname;
enter2: labelname;
exit1: labelname;
exit2: labelname;
kr1: labelname;
kr2: labelname;
kw1: labelname;
kw2: labelname;
req1: labelname;
req2: labelname;




local
  doesNotRestrict(@,@) : (resId label) bool;
  doesNotRestrictName(@,@) : (resId labelname) bool;
  isInverseLabel(@,@)  : (label label) bool;             //check if l1 = l2'
  apply @ on @ : (relId label) label;             //apply relabeling on label
  appl  @ on @ : (relId labelname) labelname;     //  "       "      "  labelname
end

stratop global
   start_str: <rccst -> rccst> bs;
   calc_str:  <rccst -> rccst> bs;
end

rules for bool
  ln1,ln2: labelname;
  l: label;
  resId__: resId;
global
  [] isInverseLabel(p($ln1),q($ln2)) => true if $ln1 == $ln2 end
  [] isInverseLabel(q($ln1),p($ln2)) => true if $ln1 == $ln2 end

  [] doesNotRestrict($resId__,tau) => true end
  [] doesNotRestrict($resId__,p($ln1)) =>  doesNotRestrictName($resId__,$ln1) end
  [] doesNotRestrict($resId__,q($ln1)) =>  doesNotRestrictName($resId__,$ln1) end


[] doesNotRestrictName(L,kw1) => false end
[] doesNotRestrictName(L,kw2) => false end
[] doesNotRestrictName(L,kr1) => false end
[] doesNotRestrictName(L,kr2) => false end
[] doesNotRestrictName(L,c1w0) => false end
[] doesNotRestrictName(L,c1w1) => false end
[] doesNotRestrictName(L,c1w2) => false end
[] doesNotRestrictName(L,c1r0) => false end
[] doesNotRestrictName(L,c1r1) => false end
[] doesNotRestrictName(L,c1r2) => false end
[] doesNotRestrictName(L,c2w0) => false end
[] doesNotRestrictName(L,c2w1) => false end
[] doesNotRestrictName(L,c2w2) => false end
[] doesNotRestrictName(L,c2r0) => false end
[] doesNotRestrictName(L,c2r1) => false end
[] doesNotRestrictName(L,c2r2) => false end




  [] doesNotRestrictName($resId__,$ln1) => true end
end

rules for label
  ln, newln : labelname;
  relId: relId;
global
  [] apply $relId on tau => tau end
  [] apply $relId on p($ln) => p(appl $relId on $ln)
//        where newln := () appl $relId on $ln
        end
  [] apply $relId on q($ln) => q(appl $relId on $ln)
//        where newln := () appl $relId on $ln
        end
end

rules for labelname
  relId: relId;
  ln: labelname;
global
  






  [] appl $relId on $ln => $ln end
end
 

rules for rccst
	t, t1, t2, t11, t21 : ccst ;
        l,l1,l2: label;
        term: ccst;
        res, R: rccst;
	resId: resId;
	relId: relId;
global
    [start_rule] res => res end
    
    [act]  (;$l.$t) => ($l;;$t) end


    [plus1] (;$t1 + $t2) => R
              where R := (calc_str)(;$t1) end
    [plus2] (;$t1 + $t2) => R
              where R := (calc_str)(;$t2) end

    [par1] (;$t1 | $t2) => ($l;; $t | $t2) 
              where (rccst)($l;;$t) := (calc_str)(;$t1) end
    [par2] (;$t1 | $t2) => ($l;; $t1 | $t) 
              where (rccst)($l;;$t) := (calc_str)(;$t2) end

    [par3] (;$t1 | $t2) => (tau;; $t11 | $t21)
              where (rccst)($l1;; $t11) := (calc_str)(;$t1)
	      where (rccst)($l2;; $t21) := (calc_str)(;$t2)
              if isInverseLabel($l1,$l2)
              end

    [res] (;$t1 \ $resId) => ($l;; $t \ $resId)
	      where (rccst) ($l;;$t) := (calc_str)(;$t1)
              if doesNotRestrict($resId,$l)
	      end
    [rel] (; $t [$relId]) => ($l2 ;; $t1 [$relId])
              where (rccst) ($l1;; $t1) := (calc_str)(;$t)
	      where (label) $l2 := () apply $relId on $l1
	      end


[proc] (; Knuth ) => res where res := (calc_str) (; (P1 | P2 | K1 | C1_0 | C2_0) \ L) end
[proc] (; K1 ) => res where res := (calc_str) (; kw1.K1 + kw2.K2 + 'kr1.K1) end
[proc] (; K2 ) => res where res := (calc_str) (; kw1.K1 + kw2.K2 + 'kr2.K2) end
[proc] (; C1_0 ) => res where res := (calc_str) (; c1w0.C1_0 + c1w1.C1_1 + c1w2.C1_2 + 'c1r0.C1_0) end
[proc] (; C1_1 ) => res where res := (calc_str) (; c1w0.C1_0 + c1w1.C1_1 + c1w2.C1_2 + 'c1r1.C1_1) end
[proc] (; C1_2 ) => res where res := (calc_str) (; c1w0.C1_0 + c1w1.C1_1 + c1w2.C1_2 + 'c1r2.C1_2) end
[proc] (; C2_0 ) => res where res := (calc_str) (; c2w0.C2_0 + c2w1.C2_1 + c2w2.C2_2 + 'c2r0.C2_0) end
[proc] (; C2_1 ) => res where res := (calc_str) (; c2w0.C2_0 + c2w1.C2_1 + c2w2.C2_2 + 'c2r1.C2_1) end
[proc] (; C2_2 ) => res where res := (calc_str) (; c2w0.C2_0 + c2w1.C2_1 + c2w2.C2_2 + 'c2r2.C2_2) end
[proc] (; P1 ) => res where res := (calc_str) (; tau.P11 + tau.0) end
[proc] (; P11 ) => res where res := (calc_str) (; 'c1w1.req1.P12) end
[proc] (; P12 ) => res where res := (calc_str) (; kr1.P14 + kr2.P13) end
[proc] (; P13 ) => res where res := (calc_str) (; c2r0.P14 + c2r1.P12 + c2r2.P12) end
[proc] (; P14 ) => res where res := (calc_str) (; 'c1w2.P15) end
[proc] (; P15 ) => res where res := (calc_str) (; c2r0.P16 + c2r1.P16 + c2r2.P17) end
[proc] (; P16 ) => res where res := (calc_str) (; 'kw1.enter1.exit1.'kw2.'c1w0.P1) end
[proc] (; P17 ) => res where res := (calc_str) (; 'c1w1.P12) end
[proc] (; P2 ) => res where res := (calc_str) (; tau.P21 + tau.0) end
[proc] (; P21 ) => res where res := (calc_str) (; 'c2w1.req2.P22) end
[proc] (; P22 ) => res where res := (calc_str) (; kr2.P24 + kr1.P23) end
[proc] (; P23 ) => res where res := (calc_str) (; c1r0.P24 + c1r1.P22 + c1r2.P22) end
[proc] (; P24 ) => res where res := (calc_str) (; 'c2w2.P25) end
[proc] (; P25 ) => res where res := (calc_str) (; c1r0.P26 + c1r1.P26 + c1r2.P27) end
[proc] (; P26 ) => res where res := (calc_str) (; 'kw2.enter2.exit2.'kw1.'c2w0.P2) end
[proc] (; P27 ) => res where res := (calc_str) (; 'c2w1.P22) end
[proc] (; KBig ) => res where res := (calc_str) (; Knuth|Knuth|Knuth) end




end


rules for ccst
  t: ccst;
global
  [] ($t) => $t end
end

strategies for rccst
  implicit
    [] start_str => start_rule end
    [] calc_str => dk( act, plus1, plus2, par1, par2, par3, res, rel, proc ) end
end


end
