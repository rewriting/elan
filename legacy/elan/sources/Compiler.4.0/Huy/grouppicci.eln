/* \rho2\PI conversion */
/* Run exclusively with interpreter since using Input-Output */

// See Example.v for some examples
// Query: Req(t1,t2,v1,v2) where:
// t1, t2 are two terms to be compared
// v1,v2 are respectively two pi-proofterm generated by ELAN
// Req() generates the whole proof of t1 =AC,G t2 in all 4 possible cases
// EMP means an empty pi-proof term or the corresponding term is in NF w.r.t Groups

// Resulted in Generated_lemma.v including main_theorem: t1 =Ac,G t2
// Require ACequal. (Theory.v,ac_poly.v) for AC equality
// Run Load Generated_lemma. to typecheck the proof in Coq.

// Naming new lemma by input-output => to be improved.

module grouppicci

import global int string to_coq IO[string] IO[term] IO[int];
end

//stratop global
//  li : <term -> term> bs;		
//	callRun: <term -> term> bs;
//end

/* proof of main theorem */
rules for term
	r0,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,t1,t2,v1,w1,v2,w2: term;
	s0,s1,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,s12,s13:string;
	pid0,pid,pid1,pid2,pid3,pid4,pid5,pid6,pid7,pid8: File;
	name,name1,name2,name3,name4: int;
global
	// Proof t=In(t) is in innermost since t may be big
	// Other AC equalities are in outermost to decrease nu of steps to replay

	//Case 1: empty proofterms for t1 and t2
	[] Req(Equal(t1,t2),Equal(EMP,EMP)) => QED
			//Lemma t1 =AC,G t2
			where pid :=() open("Generated_lemma.v","w")
			where r0:= () write(pid, Lemma main_theorem: t1 = t2.) 
			where s0:= ()proof_eq_ac_innermost(pid)

	end

	// Case 2.1: empty proof term for t1
	//           and lemma t2=In(v2) is not trivial
	[] Req(Equal(t1,t2),Equal(EMP,v2)) => QED
			if not eq_term(t2,In(v2)) 

		        where pid :=() open("Generated_lemma.v","w")
			where name := ()get_new_number
			where r0:= ()write(pid, Lemma L(name): t2=In(v2).) 
			where s1 := () proof_eq_ac_innermost(pid)
			
			//generate proof term in CCI

			where w2:= ()pi2CCI(v2)

			// Lemma t2 =AC,G Out(pi2)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t2 = Out(v2).) 
			where s2:=()write(pid1,"\n Proof.\n Rewrite ")
			where r2 := ()write(pid1, L(name))
			where s3:=()write(pid1,".\n Time Exact ")
			where r3 :=() write(pid1,w2)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)
		    	
			// Lemma t1 =AC Out(pi2)

		        where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): t1=Out(v2).) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 

			// Rewrite t2=Out(pi2)

			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))

			// Apply t1 = Out(pi2)
			where s12:=()write(pid7,".\n Apply ")
			where r12 :=() write(pid7,L(name4))

			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)							end

	// Case 2.2: empty proof term for t1
	//           and lemma t2=In(v2) is trivial
	[] Req(Equal(t1,t2),Equal(EMP,v2)) => QED
		        where pid0 :=() open("Generated_lemma.v","w")
			where pid :=() close(pid0)

			//generate proof term in CCI
			where w2:= ()pi2CCI(v2)
			// Lemma t2 =AC,G Out(pi2)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t2 = Out(v2).) 
			where s2:=()write(pid1,"\n Proof.")
			where s3:=()write(pid1,"\n Time Exact ")
			where r3 :=() write(pid1,w2)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)
   	
			// Lemma t1 =AC Out(pi2)

		        where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): t1=Out(v2).) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 

			// Rewrite t2=Out(pi2)

			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))

			// Rewrite t1 = Out(pi2)
			where s12:=()write(pid7,".\n Rewrite ")
			where r12 :=() write(pid7,L(name4))
			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)						
	end

	// Case 3.1: empty proof term for t2
	//           and lemma t1=In(v1) is not trivial
	[] Req(Equal(t1,t2),Equal(v1,EMP)) => QED
			if not eq_term(t1,In(v1))

		        where pid :=() open("Generated_lemma.v","w")
			where name := ()get_new_number
			where r0:= ()write(pid, Lemma L(name): t1=In(v1).) 
			where s1 := () proof_eq_ac_innermost(pid)

			//generate proof term in CCI
			where w1:= ()pi2CCI(v1)	
			
			// Lemma t1 =AC,G Out(pi1)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t1 = Out(v1).) 
			where s2:=()write(pid1,"\n Proof.\n Rewrite ")
			where r2 := ()write(pid1, L(name))
			where s3:=()write(pid1,".\n Time Exact ")
			where r3 :=() write(pid1,w1)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)


			// empty proof term for t2

			// Lemma Out(pi1) =AC t2
	        	where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): Out(v1)=t2.) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 

			// Rewrite t1=Out(pi1)
			
			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))

			// Apply Out(pi1)=t2
			where s12:=()write(pid7,".\n Apply ")
			where r12 :=() write(pid7,L(name4))

			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)

		end

	// Case 3.2: empty proof term for t2
	//           and lemma t1=In(v1) is trivial
	[] Req(Equal(t1,t2),Equal(v1,EMP)) => QED
		        where pid0 :=() open("Generated_lemma.v","w")
			where pid :=() close(pid0)

			//generate proof term in CCI
			where w1:= ()pi2CCI(v1)

			// Lemma t1 =AC,G Out(pi1)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t1 = Out(v1).) 
			where s2:=()write(pid1,"\n Proof.")
			where s3:=()write(pid1,"\n Time Exact ")
			where r3 :=() write(pid1,w1)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)
		    	
			// empty proof term for t2

			// Lemma Out(pi1) =AC t2

		        where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): Out(v1)=t2.) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 

			// Rewrite t1=Out(pi1)

			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))

			// Apply Out(pi1)=t2
			where s12:=()write(pid7,".\n Apply ")
			where r12 :=() write(pid7,L(name4))

			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)							
	end

	// Case 4.1: both proofterms for t1 and t2 are not empty
	//           and lemma t1=In(v1) is not trivial
	//           and lemma t2=In(v2) is not trivial
	[] Req(Equal(t1,t2),Equal(v1,v2)) => QED
			if not eq_term(t1,In(v1))
			if not eq_term(t2,In(v2))	

			// Lemma t1 =AC In(pi1)

		        where pid :=() open("Generated_lemma.v","w")
			where name := ()get_new_number
			where r0:= ()write(pid, Lemma L(name): t1=In(v1).) 
			where s1 := () proof_eq_ac_innermost(pid)
			
			//generate proof term in CCI

			where w1:= ()pi2CCI(v1)

			// Lemma t1 =AC,G Out(pi1)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t1 = Out(v1).) 
		
			// Rewrite  t1 =AC In(pi1)
			where s2:=()write(pid1,"\n Proof.\n Rewrite ")
			where r2 := ()write(pid1, L(name))

			// Exact pi2CCI(v1)
			where s3:=()write(pid1,".\n Time Exact ")
			where r3 :=() write(pid1,w1)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)
		    	
			// the same process for t2
			// Lemma t2 =AC In(pi2)

		        where pid3 :=() open("Generated_lemma.v","a")
			where name2 := ()get_new_number
			where r4:= ()write(pid3, Lemma L(name2): t2=In(v2).) 
			where s5:= () proof_eq_ac_innermost(pid3)
			
			//generate proof term in CCI

			where w2:= ()pi2CCI(v2)

			// Lemma t2 =AC,G Out(pi2)

			where pid4 :=() open("Generated_lemma.v","a")
			where name3 := () get_new_number
			where r5:= () write(pid4, Lemma L(name3): t2 = Out(v2).) 

			// Rewrite  t2 =AC In(pi2)
			where s6:=()write(pid4,"\n Proof.\n Rewrite ")
			where r6 := ()write(pid4, L(name2))
			// Exact pi2CCI(v2)
			where s7:=()write(pid4,".\n Time Exact ")
			where r7 :=() write(pid4,w2)
			where s8:=()write(pid4,".\n Show Size. \n Qed.\n")
			where pid5 := () close(pid4)


			// Lemma Out(pi1) =AC Out(pi2)

		        where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): Out(v1)=Out(v2).) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 

			// Rewrite t1 =AC,G Out(pi1)
			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))

			// Rewrite t2 =AC,G Out(pi2)
			where s11:=()write(pid7,".\n Rewrite ")
			where r11 := ()write(pid7, L(name3))
			
			// Apply Out(pi1) =AC Out(pi2)
			where s12:=()write(pid7,".\n Apply ")
			where r12 :=() write(pid7,L(name4))

			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)	
	end

	// Case 4.2: both proofterms for t1 and t2 are not empty
	//           and lemma t1=In(v1) is trivial
	//           and lemma t2=In(v2) is not trivial
	[] Req(Equal(t1,t2),Equal(v1,v2)) => QED
			if not eq_term(t2,In(v2))
		        where pid0 :=() open("Generated_lemma.v","w")
			where pid :=() close(pid0)

			//generate proof term in CCI
			where w1:= ()pi2CCI(v1)

			// Lemma t1 =AC,G Out(pi1)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t1 = Out(v1).) 
			// Exact pi2CCI(v1)
			where s3:=()write(pid1,"\n Proof.\n Time Exact ")
			where r3 :=() write(pid1,w1)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)
		    	
			// the same process for t2
			// Lemma t2 =AC In(pi2)
		        where pid3 :=() open("Generated_lemma.v","a")
			where name2 := ()get_new_number
			where r4:= ()write(pid3, Lemma L(name2): t2=In(v2).) 
			where s5:= () proof_eq_ac_innermost(pid3)
			
			//generate proof term in CCI
			where w2:= ()pi2CCI(v2)

			// Lemma t2 =AC,G Out(pi2)

			where pid4 :=() open("Generated_lemma.v","a")
			where name3 := () get_new_number
			where r5:= () write(pid4, Lemma L(name3): t2 = Out(v2).) 
			// Rewrite  t2 =AC In(pi2)
			where s6:=()write(pid4,"\n Proof.\n Rewrite ")
			where r6 := ()write(pid4, L(name2))
			// Exact pi2CCI(v2)

			where s7:=()write(pid4,".\n Time Exact ")
			where r7 :=() write(pid4,w2)
			where s8:=()write(pid4,".\n Show Size. \n Qed.\n")
			where pid5 := () close(pid4)

			// Lemma Out(pi1) =AC Out(pi2)

		        where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): Out(v1)=Out(v2).) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 
			// Rewrite t1 =AC,G Out(pi1)
			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))
			// Rewrite t2 =AC,G Out(pi2)
			where s11:=()write(pid7,".\n Rewrite ")
			where r11 := ()write(pid7, L(name3))
			// Apply Out(pi1) =AC Out(pi2)
			where s12:=()write(pid7,".\n Apply ")
			where r12 :=() write(pid7,L(name4))

			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)							
	end			

	// Case 4.3: both proofterms for t1 and t2 are not empty
	//           and lemma t1=In(t1) is not trivial
	//           and lemma t2=In(t2) is trivial
	[] Req(Equal(t1,t2),Equal(v1,v2)) => QED
			if not eq_term(t1,In(v1))
			// Lemma t1 =AC In(pi1)
		        where pid :=() open("Generated_lemma.v","w")
			where name := ()get_new_number
			where r0:= ()write(pid, Lemma L(name): t1=In(v1).) 
			where s1 := () proof_eq_ac_innermost(pid)
			
			//generate proof term in CCI
			where w1:= ()pi2CCI(v1)

			// Lemma t1 =AC,G Out(pi1)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t1 = Out(v1).) 
		
			// Rewrite  t1 =AC In(pi1)
			where s2:=()write(pid1,"\n Proof.\n Rewrite ")
			where r2 := ()write(pid1, L(name))

			// Exact pi2CCI(v1)
			where s3:=()write(pid1,".\n Time Exact ")
			where r3 :=() write(pid1,w1)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)
		    	
			// the same process for t2
			//generate proof term in CCI
			where w2:= ()pi2CCI(v2)

			// Lemma t2 =AC,G Out(pi2)

			where pid4 :=() open("Generated_lemma.v","a")
			where name3 := () get_new_number
			where r5:= () write(pid4, Lemma L(name3): t2 = Out(v2).) 
			where s6:=()write(pid4,"\n Proof.\n")
			// Exact pi2CCI(v2)
			where s7:=()write(pid4,"Time Exact ")
			where r7 :=() write(pid4,w2)
			where s8:=()write(pid4,".\n Show Size. \n Qed.\n")
			where pid5 := () close(pid4)

			// Lemma Out(pi1) =AC Out(pi2)

		        where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): Out(v1)=Out(v2).) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 
			// Rewrite t1 =AC,G Out(pi1)
			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))
			// Rewrite t2 =AC,G Out(pi2)
			where s11:=()write(pid7,".\n Rewrite ")
			where r11 := ()write(pid7, L(name3))
			// Apply Out(pi1) =AC Out(pi2)
			where s12:=()write(pid7,".\n Apply ")
			where r12 :=() write(pid7,L(name4))

			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)							
	end

	// Case 4.4: both proofterms for t1 and t2 are not empty
	//           and lemma t1=In(t1) is trivial
	//           and lemma t2=In(t2) is trivial
	[] Req(Equal(t1,t2),Equal(v1,v2)) => QED
		        where pid0 :=() open("Generated_lemma.v","w")
			where pid :=() close(pid0)
			//generate proof term in CCI
			where w1:= ()pi2CCI(v1)

			// Lemma t1 =AC,G Out(pi1)

			where pid1 :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where r1:= () write(pid1, Lemma L(name1): t1 = Out(v1).) 
			where s2:=()write(pid1,"\n Proof.")
			// Exact pi2CCI(v1)
			where s3:=()write(pid1,"\n Time Exact ")
			where r3 :=() write(pid1,w1)
			where s4:=()write(pid1,".\n Show Size. \n Qed.\n")
			where pid2 := () close(pid1)
		    	
			// the same process for t2
			//generate proof term in CCI

			where w2:= ()pi2CCI(v2)

			// Lemma t2 =AC,G Out(pi2)

			where pid4 :=() open("Generated_lemma.v","a")
			where name3 := () get_new_number
			where r5:= () write(pid4, Lemma L(name3): t2 = Out(v2).) 
			where s6:=()write(pid4,"\n Proof.\n")
			// Exact pi2CCI(v2)
			where s7:=()write(pid4,"Time Exact ")
			where r7 :=() write(pid4,w2)
			where s8:=()write(pid4,".\n Show Size. \n Qed.\n")
			where pid5 := () close(pid4)

			// Lemma Out(pi1) =AC Out(pi2)

		        where pid6 :=() open("Generated_lemma.v","a")
			where name4 := ()get_new_number
			where r8 := ()write(pid6, Lemma L(name4): Out(v1)=Out(v2).) 
			where s9 := ()proof_eq_ac_outermost(pid6)

			//Lemma t1 =AC,G t2
			where pid7 :=() open("Generated_lemma.v","a")
			where r9:= () write(pid7, Lemma main_theorem: t1 = t2.) 
			// Rewrite t1 =AC,G Out(pi1)
			where s10:=()write(pid7,"\n Proof.\n Rewrite ")
			where r10 := ()write(pid7, L(name1))
			// Rewrite t2 =AC,G Out(pi2)
			where s11:=()write(pid7,".\n Rewrite ")
			where r11 := ()write(pid7, L(name3))
			// Apply Out(pi1) =AC Out(pi2)
			where s12:=()write(pid7,".\n Apply ")
			where r12 :=() write(pid7,L(name4))

			where s13:=()write(pid7,".\n Qed.\n")
			where pid8 := () close(pid7)							end

end

/* equality modulo AC by ordered rewriting */
rules for string
	s1,s2,s3: string;
	pid,pid1: File;
global
	[] proof_eq_ac_outermost(pid) => s1
		where s1:= ()write(pid,"\n Proof.\n")
		where s2:= ()write(pid,"Time Reflexivity Orelse Erp ac_poly li;Reflexivity.\n Show Size.\n")
		where s3:= ()write(pid,"Qed.\n")
		where pid1:= ()close(pid)
	   end
	
	[] proof_eq_ac_innermost(pid) => s1
		where s1:= ()write(pid,"\n Proof.\n")
		where s2:= ()write(pid,"Time Reflexivity Orelse Erp ac_poly li;Reflexivity.\n Show Size.\n")
		where s3:= ()write(pid,"Qed.\n")
		where pid1:= ()close(pid)
	   end

	[] proof_eq_ac_non_refl(pid) => s1
		where s1:= ()write(pid,"\n Proof.\n")
		where s2:= ()write(pid,"Time Intros;Erp ac_poly li;Reflexivity.\n Show Size.\n")
		where s3:= ()write(pid,"Qed.\n")
		where pid1:= ()close(pid)
	   end

	[] proof_eq_ac_non_refl_clos(pid) => s1
		where s1:= ()write(pid,"\n Proof.\n")
		where s2:= ()write(pid,"Time Erp ac_poly li;Reflexivity.\n Show Size.\n")
		where s3:= ()write(pid,"Qed.\n")
		where pid1:= ()close(pid)
	   end
end


/* generate intermidiate lemmas */
rules for term
	ret,ret1,ret2,ret3,ret4,ret5,x,y,ac_term:term;
	l1: list[term];
	pid,pid1,pid2: File;
	s0,s1,s2,s3,s4,str0,str1,str2,str3,str4,str5:string;
	name,name1 : int;
	codex,codey: list[int];
global
	[] equal_generator(x,y) => L(codex,codey)
			where codex :=() num_code(x)
			where codey :=() num_code(y)
			where pid :=() open("Generated_lemma.v","a")
			where str1 := ()  write(pid,"ErpLemma ac_poly li ")
			where ret:= () write(pid, L(codex,codey): x=y.)
			where str2 := ()  write(pid,"\n")	
			where pid1 :=() close(pid)
	   end


	// Lemma (z1:A)(z2:A) z1=z2 -> t[z1]\omega = t[z2]\omega

	[] lemma_generator(x) => L(name)
		where pid :=() open("Generated_lemma.v","a")
		where name :=() get_new_number
		//where str1:=() write(pid,"Lemma ")
		where ret:= () write(pid,Lemma L(name): (z1:A)(z2:A) z1=z2 -> remCTX(x,z1) = remCTX(x,z2).)
		where str2:=()write(pid,"\n Proof.\n")
		where str3:=()write(pid,"Intros;Rewrite H;Reflexivity.\n")
		where str4:=()write(pid,"Qed.\n")
		where pid2 := ()close(pid)
 	   end

	// Lemma eq_ac	

	// optimise
	[] equal_generator(x,y) => L(name)
			where pid :=() open("Generated_lemma.v","a")
			where name1 := () get_new_number
			where ac_term := () eq_ac(x,y,nil,nil,0)
			where s0 := () write(pid,"Lemma")
			where ret:= () write(pid,L(name1))
			where s1  := () write(pid,":(")
			where ret1:= () print_list(pid,list_var(ac_term))
			where s2    := () write(pid,":A)")
			where ret2  := () write(pid,1st(ac_term))
			where s3    := () write(pid,"=")
			where ret3  := () write(pid,2nd(ac_term))
			where s4    := () write(pid,".") 
			where str1 :=() proof_eq_ac_non_refl(pid)

			where pid1 :=() open("Generated_lemma.v","a")
			where name := () get_new_number
			where ret4:= () write(pid1,Lemma L(name): x=y.)
 			where str2:=()write(pid1,"\n Proof.\n")
			where str3:=()write(pid1,"Apply ")
			where ret5:=()write(pid1,L(name1))
			where str5:=()write(pid1,".\n Qed.\n")
			where pid2 := ()close(pid1) 
	   end

	[] print_list(pid,x.nil) => ret 
			where ret :=() write(pid,x)
			end
	[] print_list(pid,x.l1) =>  ret
			where ret :=() write(pid,x)
			where str1 :=() write(pid,",")
			where ret1 :=() print_list(pid,l1)
			end

end


/* Generate a new number for naming a generated lemma */
rules for int
	pid,pid1,pid2,pid3: File;
	name,name1,name2: int;
global

	[] get_new_number => name1
				where pid :=() open("Lemma.name","r")
				if not iserr(pid)				
				where name :=() read(pid)
				where pid1 :=() close(pid)
				where name1 :=() name + 1
				where pid2 :=() open("Lemma.name","w")
				where name2 := () write(pid2,name1)
				where pid3:= ()close(pid2)
				end

	[] get_new_number => name
				where pid :=() open("Lemma.name","w")
				where name := () 1
				where name1 := () write(pid,name)
				where pid1:= ()close(pid)
				end
end

/* naming an AC equality lemma by elan_LHS_RHS */
/* to be generalized by .spc */

rules for list[int]
	x,y:term;
global
	[] num_code((A_Plus x y)) => append(1.num_code(x),num_code(y)) end
	[] num_code((A_Opp x)) => 3.num_code(x) end
	[] num_code(y0) => 2.nil end
	[] num_code(y1) => 3.nil end
	[] num_code(y2) => 4.nil end
	[] num_code(y3) => 5.nil end
	[] num_code(A_Zero) => 6.nil end
end

rules for list[term]
	t,s: term;
	Var,Inst: list[term];

global
	[] list_var((t,s,Var,Inst)) => Var end
	[] list_inst((t,s,Var,Inst)) => Inst end
end

