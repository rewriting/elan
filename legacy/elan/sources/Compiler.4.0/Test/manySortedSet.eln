module manySortedSet

import bool eq[Elt] eq[Set];
end

sort Set Elt EltList;
end

operators global

  i(@) : (Set) Elt ;		// inclusion operator
  j(@) : (Elt) EltList ;	// inclusion operator
  empty    : Set ;
  l(@,@) : (EltList EltList) EltList (AC);
  s(@) : (EltList) Set ;
  U(@,@) : (Set Set) Set (AC) ;
  ^(@,@) : (Set Set) Set (AC) ;
  -(@,@) : (Set Set) Set ;
  contains(@,@) : (Set Elt) bool ;
  P(@) : (Set) Set ;
  augment(@,@) : (Set Set) Set ;
  a : Elt ;
  b : Elt ;
  c : Elt ;
  d : Elt ;
  e : Elt ;

  u : Set ;
  v : Set ;
  w : Set ;
  x : Set ;
  z : Set ;

  q1 : bool;
  q2 : bool;
  q3 : bool;
end

rules for Set 
  L,M,N : EltList;
  YEltList : EltList;
  E,F,G : Elt;
  S,T,V : Set;
global
// equations between constructors to eliminate duplicate elements
  [] s(l(l(L, L), M)) => s(l(L, M)) end
  [] s(l(L, L)) => s(L) end
 
// set union
  [] U(S, empty) => S end
  [] U(s(L), s(M)) => s(l(L, M)) end

// set intersection
  [] ^(empty, S) => empty end
//  [] ^(s(j(E)), S) => if contains(S, E) then s(j(E)) else empty fi end
  [] ^(s(j(E)), S) => s(j(E)) if contains(S, E) end
  [] ^(s(j(E)), S) => empty end

// PEM
/*
  [] ^(s(l(j(E), L)), S) => U(^(s(j(E)), S), ^(s(L), S)) end
*/
/*
 * mange bcp de memoire
  [] ^(s(YEltList), S) => U(^(s(j(E)), S), ^(s(L), S))
	where (EltList) l(j(E),L) :=() YEltList
  end
*/
  [] ^(s(l(M,L)), S) => U(^(s(j(E)), S), ^(s(L), S))
	where (EltList) j(E) :=() M
  end

// asymmetric set difference
  [] -(empty, S) => empty end
//  [] -(s(j(E)), S) => if contains(S, E) then empty else s(j(E)) fi end
  [] -(s(j(E)), S) => empty if contains(S, E) end
  [] -(s(j(E)), S) => s(j(E)) end

  [] -(s(l(j(E), L)), S) => U(-(s(j(E)), S), -(s(L), S)) end
 
// power set (defined using auxiliary function "augment")
  [] P(empty) => s(j(i(empty))) end
  [] P(s(j(E))) => s(l(j(i(empty)), j(i(s(j(E)))))) end
/*
  [] P(s(l(j(E), L))) => U(P(s(L)), augment(P(s(L)), s(j(E))))
  end
*/
  [] P(s(l(j(E), L))) => U(S, augment(S, s(j(E))))
	where S:=() P(s(L))
  end

  [] augment(empty, T) => empty end
  [] augment(s(j(i(S))), T) => s(j(i(U(S, T)))) end
  [] augment(s(l(j(i(S)), L)), T) => U(s(j(i(U(S, T)))), augment(s(L), T)) end

// some specific sets
  [] u => P(P(s(l(l(j(a), j(b)), j(c))))) end
  [] v => P(P(s(l(j(a), j(b))))) end
  [] w => P(P(s(l(j(a), j(c))))) end
  [] x => P(P(s(l(j(b), j(c))))) end

  [] z => P(s(l(j(a), j(b)))) end

end

rules for bool
  L,M,N : EltList;
  E,F,G : Elt;
  S,T,V : Set;
global
// set membership
  [] contains(empty, E) => false end
  [] contains(s(j(F)), E) => E == F end
//  [] contains(s(l(j(F), L)), E) => if E == F then true else contains(s(L), E) fi end
  [] contains(s(l(j(F), L)), E) => true if E == F end
  [] contains(S,E) => false end
//  [] contains(s(l(j(F), L)), E) => contains(s(L), E) end


  [] q1 => -(u, U(U(v, w), x))  != empty 
  end
  [] q2 => -(u, U(v, w)) == ^(-(u, v), -(u, w)) 
  end
  [] q3 => -(u, U(U(v, w), x)) == ^(^(-(u, v), -(u, w)), -(u, x)) 
end

end

end

/*

-(u, U(U(v, w), x)) =/= empty 

-(u, U(U(v, w), x)) == ^(^(-(u, v), -(u, w)), -(u, x)) 
*/