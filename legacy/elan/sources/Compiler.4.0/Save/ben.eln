module ben

import global eq[Nat];
end

sort Bool Nat SNat NatPair Tree;
end

operators global
  true                : Bool;
  false               : Bool;

  z                   : Nat; 
  s ( @ )             : (Nat) Nat;
  equal ( @ , @ )     : (Nat Nat) Bool;

  plus ( @ , @ )      : (Nat Nat) Nat;
  mult ( @ , @ )      : (Nat Nat) Nat;
  exp ( @ , @ )       : (Nat Nat) Nat;

  succ17 ( @ )        : (Nat) Nat;
  pred17 ( @ )        : (Nat) Nat;
  plus17 ( @ , @ )    : (Nat Nat) Nat;
  mult17 ( @ , @ )    : (Nat Nat) Nat;
  exp17 ( @ , @ )     : (Nat Nat) Nat;

  exz                 : SNat;
  exs ( @ )           : (SNat) SNat;
  explus ( @ , @ )    : (SNat SNat) SNat;
  exmult ( @ , @ )    : (SNat SNat) SNat;
  exexp ( @ , @ )     : (SNat SNat) SNat;

  leaf(@)             : (Nat) Tree;
  node(@,@,@,@)       : (Nat Nat Tree Tree) Tree;
  buildtree(@,@)      : (Nat Nat) Tree;
  calctree17(@)       : (Nat) Nat;
  getmax(@)           : (Tree) Nat;
  getval(@)           : (Tree) Nat;

  eval ( @ )          : (SNat) Nat;
  eval17 ( @ )        : (SNat) Nat;
  evalsym17 ( @ )     : (SNat) Nat;
  evalexp17 ( @ )     : (SNat) Nat;

  evalspoon(@,@,@)    : (Nat Nat SNat) Nat;
  evalmod(@,@)        : (Nat SNat) Nat; 

  bench-evalexp17(@) : (SNat) Bool;
  bench-evaltree17(@): (SNat) Bool;

  zero        : SNat;
  dec ( @ )        : (SNat) SNat;
  expand ( @ )     : (SNat) SNat;
  exone            : SNat;
  <@,@>            : (Nat Nat) NatPair;
  mod(@,@)         : (Nat Nat) Nat;
  mod(@,@,@,@)     : (Nat Nat Nat Nat) Nat;
  nat2spoon(@,@,@) : (Nat Nat Nat) Nat;
  spoonexp(@,@,@,@) : (Nat Nat Nat Nat) Nat;

  nat2sym ( @ )    : (Nat) SNat;

end

rules for Bool
  bool : Bool;
  x, y, x1, y1 : Nat;
  Xs, Ys, Zs : SNat;
  
  global

    [] equal(x,x) => true end 
    [] equal(x,y) => false end

    [] bench-evalexp17(Xs) => equal(eval17(Zs),evalexp17(Zs))
       where Zs := ()exexp(exs(exs(exz)),Xs)
    end
    [] bench-evaltree17(Xs) => equal(calctree17(y),getval(buildtree(y,z)))
       where y := ()eval(Xs)
    end

  end

rules for Nat
  x, y   : Nat;
  xs, ys : SNat;
  Xs, Ys, Zs : SNat;

  global
    [] plus(x,z) => x end
    [] plus(x,s(y)) => s(plus(x,y)) end

    [] mult(x,z) => z end
    [] mult(x,s(y)) => plus(mult(x,y),x) end

    [] exp(x,z) => s(z) end
    [] exp(x,s(y)) => mult(x,exp(x,y)) end

    [] succ17(s(s(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z))))))))))))))))) => z end
    [] succ17(x) => s(x) end

    [] pred17(s(x)) => x end
    [] pred17(z) => s(s(s(s(s(s(s(s(s(s(s(s(s(s(s(s(z)))))))))))))))) end

    [] plus17(x,z) => x end
    [] plus17(x,s(y)) => succ17(plus17(x,y)) end

    [] mult17(x,z) => z end
    [] mult17(x,s(y)) => plus17(x,mult17(x,y)) end

    [] exp17(x,z) => succ17(z) end
    [] exp17(x,s(y)) => mult17(x,exp17(x,y)) end

    [] eval(exz) => z end
    [] eval(exs(xs)) => s(eval(xs)) end
    [] eval(explus(xs,ys)) => plus(eval(xs), eval(ys)) end
    [] eval(exmult(xs,ys)) => mult(eval(xs), eval(ys)) end
    [] eval(exexp(xs,ys)) => exp(eval(xs), eval(ys)) end

    [] eval17(exz) => z end
    [] eval17(exs(xs)) => succ17(eval17(xs)) end
    [] eval17(explus(xs,ys)) => plus17(eval17(xs), eval17(ys)) end
    [] eval17(exmult(xs,ys)) => mult17(eval17(xs), eval17(ys)) end
    [] eval17(exexp(xs,ys)) => exp17(eval17(xs), eval(ys)) end
    [] evalexp17(Xs) => eval17(expand(Xs)) end
    [] eval17(exone) => s(z) end

  end

rules for SNat 
  x   : Nat;
  Xs, Ys, Zs : SNat;

  global
    [] expand(exz) => exz end
    [] expand(exone) => exone end
    [] expand(exs(Xs)) => explus(exone,expand(Xs)) end
    [] expand(explus(Xs,Ys)) => explus(expand(Xs),expand(Ys)) end
    [] expand(exmult(Xs,exz)) => exz end
    [] expand(exmult(Xs,exone)) => expand(Xs) end
    [] expand(exmult(Xs,explus(Ys,Zs))) =>
                expand(explus(exmult(Xs,Ys),exmult(Xs,Zs))) end
    [] expand(exmult(Xs,Ys)) => expand(exmult(Xs,expand(Ys))) end
    [] expand(exexp(Xs,exz)) => exone end
    [] expand(exexp(Xs,exone)) => expand(Xs) end
    [] expand(exexp(Xs,explus(Ys,Zs))) =>
                expand(exmult(exexp(Xs,Ys),exexp(Xs,Zs))) end
    [] expand(exexp(Xs,Ys)) => expand(exexp(Xs, expand(Ys))) end

  end

rules for Nat 
  Val, Val2, Val3 : Nat;
  Max, Max2   : Nat;
  X, I, J : Nat;
  Left, Right : Tree;

  global

  [] getval(leaf(Val)) => Val
  end
  [] getval(node(Val,Max,Left,Right)) => Val
  end

  [] getmax(leaf(Val)) => Val
  end
  [] getmax(node(Val,Max,Left,Right)) => Max
  end

  [] calctree17(X) => mult17(I,J)
	where I :=() exp17(s(s(z)), pred17(X))
	where J :=() pred17(exp17(s(s(z)),X))
  end
end

rules for Tree
  Val, Val2, Val3 : Nat;
  Max, Max2   : Nat;
  X, Y, I, J : Nat;
  Left, Right : Tree;

  global


  [] buildtree(z, Val) => leaf(Val)
  end

  [] buildtree(s(X), Y) => node(Val, Max, Left, Right)
	where Left :=() buildtree(X, Y)	
	where Max2 :=() getmax(Left)
  	where Right:=() buildtree(X, succ17(Max2))
	where Val2 :=() getval(Left)
	where Val3 :=() getval(Right)
	where Val  :=() plus17(Val2, Val3)
	where Max  :=() getmax(Right)
  end
end

end
