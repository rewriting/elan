module ident1

import ident;
end

sort term;
end

operators global
 a    : ident;
 b    : ident;

 f(@) : (ident) term;
 g(@) : (ident) term;

 t1   : term;
 t2   : term;
 t3   : term;
 t4   : term;

 test1   : term;


end

rules for term
  x : ident;
global
  [] f(a) => t1 end
  [] f(b) => t2 end
  [] f(BB) => t3 end
  [] f($x) => g($x) end


  [] test1 => f(a) end
end


end
