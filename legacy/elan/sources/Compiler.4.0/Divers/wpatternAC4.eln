module wpatternAC4
import int;
end

// pattern with builtins
sort term;
end

operators global
 a      : term;
 b      : term;
 c      : term;
 d      : term;
 e      : term;
 f      : term;

 go     : term;

 F(@,@) : (term term) term (AC);
 f(@,@) : (term term) term;
 g(@)   : (int) term;
 h(@,@) : (term term) term;
end

stratop global
  s0 : <term> builtin;
end

rules for term
  x1,x2,x3 : term;
  y1,y2,y3 : int;
  z1,z2,z3 : term;
global
  [] go => F(a,F(g(1),g(1)))
  end

  [r0] F(x1,x2) => g(y1+y2)
	where (term) F(g(y1),g(y2)) :=() x1
  end
end

strategies for term
implicit
  [.] s0 => dk(r0)
  end
end

end
