module natc10[Base]
import builtinInt list[builtinInt];
end

sort Nat;
end

operators global
  d : Nat;
  {
    (@)I : (Nat) Nat;
    mult_I(@) : (Nat) Nat;
  }_I=0...Base

  @ + @ : (Nat Nat) Nat ;
  @ * @ : (Nat Nat) Nat ;
  prec(@) : (Nat) Nat;
  fact(@) : (Nat) Nat;
  fib(@) : (Nat) Nat;

  l : list[builtinInt];
end

rules for list[builtinInt]
global
 [] l=> {I.}_I=0...(Base-1) nil
 end
end

rules for Nat
  x,y : Nat;
  r : builtinInt;
global
  [] (d)0 => d end
  [] x + d => x end
  [] d + x => x end

{
  FOR EACH J:builtinInt; R:builtinInt; B:builtinInt SUCH THAT J:=(listExtract) elem(l)
		AND R:=() ((I+J)-((I+J)%Base))/Base
		AND B:=() (I+J)%Base
		ANDIF J>=I :{
    [] (x)I + (y)J => (x+y + (d)R )B end  
    [] (x)J + (y)I => (x+y + (d)R )B end  
  }
}_I=0...(Base-1)

  [] mult_0(x) => d end
  [] mult_1(x) => x end

{
  [] mult_I(d) => d end

  FOR EACH J:builtinInt; R:builtinInt; B:builtinInt SUCH THAT J:=(listExtract) elem(l)
		AND R:=() ((I*J)-((I*J)%Base))/Base
		AND B:=() (I*J)%Base
		:{
    [] mult_I((x)J) => ((d)R + mult_I(x) )B end
  }
}_I=2...(Base-1)
  

  [] x * d => d end
  [] d * x => d end

{
  [] (x)I * y => (x*y)0 + mult_I(y) end  
  [] y * (x)I => (x*y)0 + mult_I(y) end  
}_I=0...(Base-1)

FOR EACH B:builtinInt SUCH THAT B:=() Base-1 :{
  [] prec((x)0) => (prec(x))B end
}



FOR EACH I:builtinInt; B:builtinInt SUCH THAT I:=(listExtract) elem(l)
	AND B:=() I-1
        ANDIF I>0
 :{
  [] prec((x)I) => (x)B end
}


  [] fact(d) => (d)1 end
  [] fact(x) => x* fact(prec(x)) end

  [] fib(d) => (d)1 end
  [] fib((d)1) => (d)1 end
  [] fib(x) => fib(prec(x)) + fib(prec(prec(x))) end



end
end


