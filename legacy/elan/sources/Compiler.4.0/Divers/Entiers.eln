module Entiers

import
global  builtinInt
        ;
end

sort
term;
end

operators
global
        @               : (builtinInt)         term;
        @ + @         : (term term)  term (AC);
        ExpandTerm(@)   : (term)        term;
        (@)             : (term)        term;
end

rules for term

        t,t1,t2 :term;

global

[] ExpandTerm(t1 + t2) => t1+t2	end
end


end


