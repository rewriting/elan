module trc

import global bool eq[Foo]; end

sort Foo; end

operators global
  a	: Foo;
  b	: Foo;
  c	: Foo;
  d	: Foo;
  f(@)	: (Foo) Foo;
  @(@)	: (Foo Foo) Foo;
end

stratop global
  AB	: <Foo> builtin;
  BC	: <Foo> builtin;
  ABC	: <Foo> builtin;
  ALLSOL	: <Foo> builtin;
end

rules for Foo
x, y, z, u, uu, m	: Foo;
global
  [all]	f(x) => z(y(uu(x))) // z(y(uu(x)))
		where z:=(AB)x
		try
		  choice where u:=()a where y:=()b if true if x == a
		  choice where y:=(BC)x if x == b
		  choice where y:=()c if x == c
/*
		  choice
			try
			  choice if true where u:=()x  where y:=()x
			  choice if false  where y:=()x
			end
*/
		end
		where uu:=(ABC)d
		if x == a or x == c
  end 
  [LA]  x => a end
  [LB]  x => b end
  [LC]  x => c end
end 

strategies for Foo
implicit
  [.] AB => dk(LA,LB)  end
  [.] ABC => dk(LA,LB,LC)  end
  [.] BC => dk(LB,LC)  end
end

strategies for Foo
implicit
  [.] ALLSOL => dk(all) end
end

end





