module fib_builtin
	// First import the integers
import global builtinInt;
end

	// And now all the operators of interest to build simple
	// monomials and polynomials
operators global
  fib(@)       : (builtinInt) builtinInt ;
  bench(@,@,@) : (builtinInt builtinInt builtinInt) builtinInt ;
end

rules for builtinInt 
  x,y,n : builtinInt ;
global
  [] fib(0) => 1 end
  [] fib(1) => 1 end
  [] fib(n) => fib(n - 1) + fib(n - 2)
      if greater_builtinInt(n,1)
  end

  //[] bench(x,y,0) => y end
  //[] bench(x,y,n) => bench(x,fib(x),n-1) end
end

end
