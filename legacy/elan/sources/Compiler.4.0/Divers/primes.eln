module primes

// not finished, I will need conditions to do this.

import 
  local	builtinInt bool;
end
sort 
  list;
end
operators
  global
   nil 		: list;
   cons(@,@) 	: ( builtinInt list ) list;

   app(@,@)  	: ( list list ) list;

   primes(@)		: ( builtinInt ) list;
   addifprime(@,@)	: ( builtinInt list ) list;
   addprime1(@,@,@)	: ( builtinInt bool list ) list;
   addprime2(@,@,@)	: ( builtinInt bool list ) list;

   forget(@)	: (list) list;
end

rules for list
x   	: builtinInt;
y,z 	: list;
n,i,j 	: builtinInt;
global
  [] app(nil,y)		=> y					end
  [] app(cons(x,y),z)	=> cons(x,app(y,z))			end

  [] addifprime(n,nil)		=> cons(n,nil)					end
  [] addifprime(n,cons(i,y))	=> cons(i,app(y,cons(n,nil))) 	if i*i>n	end
  [] addifprime(n,cons(i,y))	=> cons(i,y)			if n%i == 0 	end
  [] addifprime(n,cons(i,y))	=> cons(i,addifprime(n,y))			end

  [] primes(0)		=> nil					end
  [] primes(1)		=> nil					end
  [] primes(2)		=> cons(2,nil)				end
  [] primes(n)		=> addifprime(n,primes(n-1))		end
  [] forget(y)		=> nil					end
end

end



