module simap

import global strat[Foo]; end

sort Foo; end

operators global
  go		: Foo;
  nil		: Foo;
  a		: Foo; 
  b		: Foo;
  c		: Foo;
  cons(@,@)	: (Foo Foo) Foo;
end

stratop global
  map(@)	: (<Foo>) <Foo>;
  Eval		: <Foo> builtin;
end

rules for Foo
y	: Foo;
t, y1, y2, t1, t2 : Foo;
s1, s2 : <Foo>;
global
  [R1]	a => b		end
  [R2]	a => c		end
  []	go => //y	where y:=[map(dk(R1,R2))]
		cons(a,
		cons(a,
		cons(a,nil)))
	end
//  []	go => y	where y:=[id]cons(a,nil)	end
//  []	go => y	where y:=[id]a	end

end

strategies for Foo
s	: <Foo>;
implicit
  [.]  map(s) => dc(nil,cons(s,map(s)))		end
end

end
