module ack

import global builtinInt;
end

operators
global
  ack(@,@)	: (builtinInt builtinInt) builtinInt;
end


rules for builtinInt
  x,y : builtinInt;
global 
  [] ack(0,x) => x+1			end
  [] ack(x,0) => ack(x-1,1)		end
  [] ack(x,y) => ack(x-1,ack(x,y-1))	end
end

end

