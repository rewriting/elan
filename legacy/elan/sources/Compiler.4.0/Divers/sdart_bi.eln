module sdart_bi

import builtinInt;
end
sort Set;
end

operators global
  empty		: Set;
  set(@)	: (builtinInt) Set;
  p1(@,@)	: (Set Set) Set (AC);
  @ + @		: (Set Set) Set (AC) alias p1(@,@):;
  p2(@,@)	: (Set Set) Set (AC);
  m2(@,@)	: (Set Set) Set (AC);
  singles	: Set;
  doubles	: Set;
  triples	: Set;
  all		: Set;
  finish	: Set;
end


rules for Set
	S,S1,S2 : Set;
	I,J	: builtinInt;
	tmp	: Set;
global
  [] p1( S,empty )	=> S end
  [] p1( S,S )		=> S end

  [] p2( empty,S	)	=> S end
  [] p2( set(I),set(J) )	=> set( I+J ) end
  [] p2( p1( S,S1 ) , S2 ) => p1( p2( set(I),S2 ) , p2( S1,S2 ) )
	where (Set)set(I):=()S 
  end
  [] m2( empty,S )		=> S end
  [] m2( set(I),set(J) )	=> set( I*J ) end
  [] m2( p1( S,S1 ) ,  S2 ) => p1( m2( set(I),S2 ) , m2( S1,S2 ) )
	where (Set)set(I):=()S 
  end

  [] singles		=>
	set(1) + set(2) + set(3) + set(4) + set(5)
	+ set(6) + set(7) + set(8) + set(9) + set(10)
	+ set(11) + set(12) + set(13) + set(14) + set(15)
	+ set(16) + set(17) + set(18) + set(19) + set(20)
  end

  [] doubles		=> m2( singles , set(2) ) end
  [] triples		=> m2( singles , set(3) ) end
  [] all		=> p1(singles,p1(doubles,p1(triples,p1(
				 set(25),p1(set(50),set(0))))))
  end
  [] finish		=> p2( p1( doubles , set(50) )  , p2( all , all ) ) end
end

end


/*
reduce in DARTS : doubles .
reduce in DARTS : triples .
reduce in DARTS : all .
reduce in DARTS : finish .
*/

