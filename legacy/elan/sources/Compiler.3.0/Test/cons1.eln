module cons1
sort  	Foo; 
end

operators global
	go    : Foo;
	r0   : Foo;
	r1   : Foo;
	r2   : Foo;

        a		: Foo;
        b		: Foo;
        c		: Foo;
        F(@,@)		: (Foo Foo) Foo (AC);
        f(@,@)		: (Foo Foo) Foo;
        g(@)		: (Foo) Foo;
        h(@,@)		: (Foo Foo) Foo;
end

stratop global
  s0 : <Foo> builtin;
end

rules for Foo
    x,y,z : Foo;
global
  []   go        => F(a,F(a,F(b,c)))  end

  [R1] F(x,a) => x end
  [R2] F(x,b) => x end
end


strategies for Foo
implicit
  [.] s0 => repeat*(first one(R1));
	    repeat*(first one(R2))
  end
end


end
				




