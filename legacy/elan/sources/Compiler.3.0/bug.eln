global rule NORMALISE_RULE0_303:poly/bug [1/3/fsym=303/vars=3]
  VAR(1)+ VAR(0)	 =>  VAR(1)+ VAR(2)

     where VAR(2) := (GNORMAL_STRAT0:poly/bug)  VAR(0)

global rule NORMALISE_RULE0_303:poly/bug [2/4/fsym=303/vars=3]
