module bug

import global bool;
end
sort poly;
end
operators global

  go : poly;
  a : poly;
  b : poly;
  c : poly;

  @ + @ 	: ( poly poly ) poly  assocRight;

end

stratop global
  S		: <poly>	bs;
  S1		: <poly>	bs;
  S2		: <poly>	bs;
end

rules for poly
  P            : poly;
  absX1, absX2 : poly;
  p1,p2,p3,p4  : poly;
  X,Y,Z        : poly;
global

  [R] go => X where X:=(S1) c
  end


/*
  [R1] X => Y where Y:=(S2) X+a         end
  [R1] X => Y where Y:=(S2) X+b         end
*/
  [R2] X+a => a end
  [R2] X+b => b end


  [R1] X => Y where Y:=() X+a         end
  [R1] X => Y where Y:=() X+b         end

  [] X+a => a end
  [] X+b => b end

end

strategies for poly
implicit

  [] S => dk(R) end

  [] S1 => dk(R1) end

  [] S2 => dk(R2) end
end

end

/*
global rule expand:poly/bug [1/1/fsym=303/vars=3]
