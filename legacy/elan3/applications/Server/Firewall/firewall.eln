module firewall
  import global
    string builtinInt eq[builtinInt];
  end /* for import */
  
  sort
    Protocol IPAdress Octet Port Header;
  end

  operators global
    eval(@)	:(Header) string;
    tcp		:Protocol;
    udp		:Protocol;
    ip(@.@.@.@)	:(Octet Octet Octet Octet) IPAdress;

    @		:(builtinInt) Octet;
    int2Octet(@):(builtinInt) Octet alias @:;

    @		:(builtinInt) Port;
    int2Port(@)	:(builtinInt) Port alias @:;

    h(@,@,@,@,@):(Protocol IPAdress Port IPAdress Port) Header;

  end

  rules for string
    any				:builtinInt;
    x1,x2,x3,x4,y1,y2,y3,y4	:Octet;
  global
    [] eval(h(tcp,ip(140.192.37.20),any,ip(y1.y2.y3.y4),80))	=> "deny" 	end
    [] eval(h(tcp,ip(140.192.37.x4),any,ip(y1.y2.y3.y4),80)) 	=> "accept" 	end
    [] eval(h(tcp,ip(x1.x2.x3.x4),any,ip(161.120.33.40),80)) 	=> "accept" 	end
    [] eval(h(tcp,ip(140.192.37.x4),any,ip(161.120.33.40),80)) 	=> "deny" 	end
    [] eval(h(tcp,ip(140.192.37.30),any,ip(y1.y2.y3.y4),21)) 	=> "deny" 	end
    [] eval(h(tcp,ip(140.192.37.x4),any,ip(y1.y2.y3.y4),21)) 	=> "accept" 	end
    [] eval(h(tcp,ip(140.192.37.x4),any,ip(161.120.33.40),21)) 	=> "accept" 	end
    [] eval(h(tcp,ip(x1.x2.x3.x4),any,ip(y1.y2.y3.y4),any)) 	=> "deny" 	end
    [] eval(h(udp,ip(140.192.37.x4),any,ip(161.120.33.40),53)) 	=> "deny" 	end
    [] eval(h(udp,ip(x1.x2.x3.x4),any,ip(161.120.33.40),53)) 	=> "deny" 	end
    [] eval(h(udp,ip(x1.x2.x3.x4),any,ip(y1.y2.y3.y4),any)) 	=> "deny" 	end
  end

end
