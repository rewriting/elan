//---------------------------------------------------------------------------------------
// The oreder RPO induced by Equiv and Lss and Status
//--------------------------------------------------------------------------------------
module ordre_rpo[Vars,Ars,Lss,Equiv,Status]

import	global	
		ordre_sig[Vars,Ars,Lss,Equiv,Status] 
;end

operators
  global
//------------- rpo --------------------------------------------------------------------
    rpo(@,@)	: (term term) bool;
    suprpo(@,@)	: (term term) bool		alias rpo(@,@):;
    @ >rpo @	: (term term) bool		alias suprpo(@,@):;

    suplex(@,@)	: (list[term] list[term]) bool;
    @ >lex @	: (list[term] list[term]) bool	alias suplex(@,@):;

    supmult(@,@) : (list[term] list[term]) bool;
    @ >mult @	: (list[term] list[term]) bool	alias supmult(@,@):;
    multiset(@,@,@,@) : (list[term] list[term] list[term] list[term]) bool;
    multiset2(@,@,@) : (list[term] list[term] list[term]) bool;

    rpo(@,@)	: (list[term] term) bool;
    rpo(@,@)	: (term list[term]) bool;
    rpo1(@,@)	: (term term) bool;
    rpo2(@,@)	: (term term) bool;
    rpo3(@,@,@,@)	: (Stat Stat term term) bool;

    equiv_rpo(@,@)	: (term term) bool;
    equiv_rpo(@,@,@)	: (list[term] list[term] list[term]) bool;

    equiv_rpoM(@,@,@)	: (list[term] list[term] list[term]) bool;
//--------------------------------------------------------------------------------------
end

//--------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------
// Ordre RPO ***************************************************************************
//--------------------------------------------------------------------------------------
rules for bool
  	u, v : variable;
	s,t 	: term;
	ls,lt,L,Ls,Lt 	: list[term];
	b	: bool;
	gtf : int;
  global
//--------------------------------------------------------------------------------------
// Ordre lexicographique
//--------------------------------------------------------------------------------------
//    [] s.ls >lex t.lt => rpo(s,t) or (s~t and ls >lex lt)
//    end

    [] s.ls >lex t.lt 	=> true
			if equiv_rpo(s,t)
			where b:=() ls >lex lt 
			if b
    end
    [] s.ls >lex t.lt 	=> rpo(s,t)
    end

    [] nil >lex lt 	=> false
    end
    [] s.ls >lex nil 	=> true
    end

//--------------------------------------------------------------------------------------
// Ordre multiset
//--------------------------------------------------------------------------------------

    [] ls >mult lt 	=> multiset(ls, lt, nil, nil)
    end

// delete equivalent terms from the two lists of terms ---
    []  multiset(nil, lt, nil, Lt)	=> false
    end
    []  multiset(ls, nil, Ls, Lt)	=> multiset2(ls @ Ls, Lt, nil)
    end
    []  multiset(nil, t.lt, Ls, Lt)	=> multiset(Ls, lt, nil, t.Lt)
    end
    []  multiset(s.ls, t.lt, Ls, Lt)	=> 
		switch
		case equiv_rpo(s,t) then multiset(ls @ Ls, lt, nil, Lt)
		otherwise multiset(ls, t.lt, s.Ls, Lt)
	 	end
    end

// delete smaller terms from the second list ---
    []  multiset2(ls, nil, L)	=> true
    end
    []  multiset2(nil, t.lt, L)	=> false
    end
    []  multiset2(s.ls, t.lt, L)	=> 
		switch
		case rpo(s,t) then multiset2(cons(s,ls) @ L, lt, nil)
		otherwise multiset2(ls, t.lt, s.L)
	 	end
    end

//------------------------------------------------------------------------------------
// Ordre RPO
//------------------------------------------------------------------------------------
//    [] rpo(s,t) => rpo1(s,t) or rpo2(s,t) or rpo3(s,t)
//    end

//
// Cas : f(s1,...,sn) >rpo f(t1,...,tn)
// Il faut : s >rpo t1,...,tn et s1,...,sn >status t1,...,tn
//
    [] rpo(s,t) => false
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if neq_Stat(statType(stat(head(s))),statType(stat(head(t))))
    end
    [] rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),LR)
		if eq_Stat(stat(head(t)),LR)
		where b:=() rpo3(LR,LR,s,t) 
		if b
    end

    [] rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),LR)
		if eq_Stat(stat(head(t)),RL)
		where b:=() rpo3(LR,RL,s,t) 
		if b
    end
    [] rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),RL)
		if eq_Stat(stat(head(t)),LR)
		where b:=() rpo3(RL,LR,s,t) 
		if b
    end
    [] rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),RL)
		if eq_Stat(stat(head(t)),RL)
		where b:=() rpo3(RL,RL,s,t) 
		if b
    end
    [] rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),MS)
		if eq_Stat(stat(head(t)),MS)
		where b:=() rpo3(MS,MS,s,t) 
		if b
    end
    [] rpo3(LR,LR,s,t) => 
		switch
		case list_subterm(s) >lex list_subterm(t)  then 
			rpo(s,list_subterm(t))
		otherwise false
		end
    end
    [] rpo3(LR,RL,s,t) =>  
		switch
		case list_subterm(s) >lex reverse(list_subterm(t))  then 
			rpo(s,list_subterm(t))
		otherwise false
		end
    end
    [] rpo3(RL,LR,s,t) =>  
		switch
		case reverse(list_subterm(s)) >lex list_subterm(t)  then 
			rpo(s,list_subterm(t))
		otherwise false
		end
    end
    [] rpo3(RL,RL,s,t) =>  
		switch
		case reverse(list_subterm(s)) >lex reverse(list_subterm(t))  then 
			rpo(s,list_subterm(t))
		otherwise false
		end
    end
    [] rpo3(MS,MS,s,t) => list_subterm(s) >mult list_subterm(t) 
    end
//
// Cas : f(s1,...,sn) >rpo g(t1,...,tn) avec f >sig g
// Il faut : s >rpo t1,...,tn
//
    [] rpo(s,t) => true
                if not(isvar(s)) and not(isvar(t))
                if head(s) >sig head(t)
                where b:=() rpo2(s,t)
                if b
    end

    [] rpo2(s,t) => rpo(s,list_subterm(t))
    end
//
// Cas : autre
// Il faut : si >rpo t
//
    [] rpo(s,t) => rpo1(s,t)
    end
    [] rpo1(s,t) => rpo(list_subterm(s),t)
    end

//----------------------------------------------------------------------------------
//    [] rpo(s.ls,t) => rpo(s,t) or s ~rpo t or rpo(ls,t)
//    end    
    [] rpo(s.ls,t) => 
		switch
		case equiv_rpo(s,t) then true
		case rpo(ls,t) then true
		otherwise rpo(s,t)
		end
    end
    [] rpo(nil,t) => false
    end

//----------------------------------------------------------------------------------
//    [] rpo(s,t.lt) => rpo(s,t) and rpo(s,lt)
//    end   
    [] rpo(s,t.lt) => 
		switch
		case rpo(s,t) then rpo(s,lt)
		otherwise false
	 	end
    end
    [] rpo(s,nil) => true
    end

//----------------------------------------------------------------------------------
//----------------------------------------------------------------------------------
//   f(s_1,...,s_n) equiv_rpo g(t_1,...,t_n) => f = g and s_i ~ t_i
//    end    
    [] equiv_rpo($v,$u) => false if neq_variable($v,$u)
    end
    [] equiv_rpo(s,s) => true
    end

    [] equiv_rpo(s,t) => false
		if not(isvar(s)) and not(isvar(t))
		if not(head(s) ==sig head(t))
    end
    [] equiv_rpo(s,t) => false
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if neq_Stat(statType(stat(head(s))),statType(stat(head(t))))
    end
    [] equiv_rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),LR)
		if eq_Stat(stat(head(t)),LR)
		where b:=() equiv_rpo(list_subterm(s),list_subterm(t), nil) 
		if b
    end
    [] equiv_rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),LR)
		if eq_Stat(stat(head(t)),RL)
		where b:=() equiv_rpo(list_subterm(s),reverse(list_subterm(t)), nil) 
		if b
    end
    [] equiv_rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),RL)
		if eq_Stat(stat(head(t)),LR)
		where b:=() equiv_rpo(reverse(list_subterm(s)),list_subterm(t), nil) 
		if b
    end
    [] equiv_rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),RL)
		if eq_Stat(stat(head(t)),RL)
		where b:=() equiv_rpo(reverse(list_subterm(s)),reverse(list_subterm(t)), nil) 
		if b
    end
    [] equiv_rpo(s,t) => true
		if not(isvar(s)) and not(isvar(t))
		if head(s) ==sig head(t)
		if eq_Stat(stat(head(s)),MS)
		if eq_Stat(stat(head(t)),MS)
		where b:=() equiv_rpoM(list_subterm(s),list_subterm(t), nil) 
		if b
    end
    [] equiv_rpo(s,t) => false
		//if isvar(s) or not(isvar(t)
    end


    [] equiv_rpo(nil, nil, nil) => true
    end  
    [] equiv_rpo(s.ls, t.lt, nil) => 
		switch
		case equiv_rpo(s,t) then equiv_rpo(ls,lt, nil)
		otherwise false
	 	end
    end
  
    [] equiv_rpoM(nil, nil, nil) => true
    end  
    [] equiv_rpoM(nil, nil, t.L) => false
    end  
    [] equiv_rpoM(nil, t.lt, L) => false
    end  
    [] equiv_rpoM(s.ls, t.lt, L) => 
		switch
		case equiv_rpo(s,t) then equiv_rpoM(ls @ L, lt, nil) 
		otherwise equiv_rpoM(ls, t.lt, s.L)
	 	end
    end
end
//------------------------------------------------------------------------------------

end

