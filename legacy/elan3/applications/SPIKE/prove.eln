FOR EACH SS:pair[ident,pair[int,int]]; 
	F:ident;  A:pair[int,int];
	AL:int; AR:int; N:int
SUCH THAT SS:=(listExtract) elem(Ars)
	AND F:=()first(SS) 
	AND A:=()second(SS) 
	AND AL:=()first(A) 
	AND AR:=()second(A) 
	AND N:=()AL+AR
	ANDIF N==0:{

  rules for list[term]
	lt_1,...,lt_N : list[term];
	TS : list[term];
  global
	[] consTerm(F, TS) =>	F.nil
  	end
  end

}

FOR EACH SS:pair[ident,pair[int,int]]; 
	F:ident;  A:pair[int,int];
	AL:int; AR:int; N:int
SUCH THAT SS:=(listExtract) elem(Ars)
	AND F:=()first(SS) 
	AND A:=()second(SS) 
	AND AL:=()first(A) 
	AND AR:=()second(A) 
	AND N:=()AL+AR
	ANDIF N>0:{

  rules for list[term]
	lt_1,...,lt_N : list[term];
	TS : list[term];
  global
	[] consTerm(F, TS) =>	makeTerm(F {,lt_I}_I=1...N)
			{where lt_I := ()getArgs(dom-I(F), TS) }_I=1...N
  	end
  end

}

//--------------------------------------------------------------------------------------

  rules for list[term]
	f : ident;
	lf : list[ident];
  global
  	[] get_variables(nil) 	=> 	nil
  	end
  	[] get_variables($f.lf) 	=> 	v-$f . get_variables(lf) 
  	end
  end
//--------------------------------------------------------------------------------------

  rules for list[term]
	k : int;
	t : term;
	lt : list[term];
  global
  	[] freshListTerm(k,nil) 	=> 	nil
  	end
  	[] freshListTerm(k,t.lt) 	=> 	freshTerm(k,t).freshListTerm(k,lt)
  	end
  end
//--------------------------------------------------------------------------------------

  rules for list[term]
	d : int;
	t : term;
	lt : list[term];
  global
  	[] elim_Term_Vars(d, nil) 	=> 	nil
  	end
  	[] elim_Term_Vars(d, t.lt) 	=> 	t.  elim_Term_Vars(d, lt)
					if not Var_at(d, t)
  	end
  	[] elim_Term_Vars(d, t.lt) 	=>	elim_Term_Vars(d, lt)
					if  Var_at(d, t)	
  	end

  	[] elim_Term_Strict(d, nil) 	=> 	nil
  	end
  	[] elim_Term_Strict(d, t.lt) 	=> 	t.  elim_Term_Strict(d, lt)
					if not Strict_at(d, t)
  	end
  	[] elim_Term_Strict(d, t.lt) 	=>	elim_Term_Strict(d, lt)
					if  Strict_at(d, t)	
  	end
  end
//--------------------------------------------------------------------------------------

  rules for list[term]
	TS : list[term];
	f : ident;
	LC : list[ident];
	p, d : int;
  global
	[] testsetOne(nil, TS, p, d) =>	TS
  	end
	[] testsetOne($f.LC, TS, p,d) => 
		consTerm($f,TS @ get_variables(domall($f))) @ testsetOne(LC, TS, p, d)
  	end
  end

//--------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------

FOR EACH SS:pair[ident,pair[int,int]]; 
	F:ident;  A:pair[int,int]; N:int; NEXT:int;
	AL:int; AR:int
SUCH THAT SS:=(listExtract) elem(Ars) 
	AND F:=()first(SS) 
	AND A:=()second(SS) 
	AND AL:=()first(A) 
	AND AR:=()second(A) 
	AND NEXT:=()AL+1
	AND N:=()AL+AR
	ANDIF N==0 :{
  rules for list[term]
	LC : list[ident];
	p, d : int;
  global
	[] TestSet(F.LC, 1, d)	=>	F.TestSet(LC, 1, d)
  	end
  end
}
FOR EACH SS:pair[ident,pair[int,int]]; 
	F:ident;  A:pair[int,int]; N:int; NEXT:int;
	AL:int; AR:int
SUCH THAT SS:=(listExtract) elem(Ars) 
	AND F:=()first(SS) 
	AND A:=()second(SS) 
	AND AL:=()first(A) 
	AND AR:=()second(A) 
	AND NEXT:=()AL+1
	AND N:=()AL+AR
	ANDIF N>0 :{
  rules for list[term]
	TS : list[term];
	LC : list[ident];
	p, d : int;
  global
	[] TestSet(F.LC, 1, d)	=>	TestSet(LC, 1, d)
  	end
  end

}

  rules for list[term]
	TS : list[term];
	LC : list[ident];
	p, d : int;
  global
	[] TestSet(nil, 1, d)	=>	nil
  	end
	[] TestSet(LC, p, p)	=>	elim_Term_Strict( p, elim_Term_Vars(p-1, 
					unicate(testsetOne(LC, TS, p, p)) ))
				where TS := ()unicate(TestSet(LC, p-1, p))
  	end
	[] TestSet(LC, p, d)	=>	testsetOne(LC, TS, p, d)
				where TS := ()unicate(TestSet(LC, p-1, d))
  	end
  end

//--------------------------------------------------------------------------------------
  rules for list[pair[equationS, clause]]
	pos : list[int];
	S, SSigma, T, Tr : term;
	Np, Pp, Pi, PiSigma : equationS;
	Li, Ri, RiSigma : term;
	matchRez : list[term]; 
        listVar : list[term];
	sigma : substitution;
	LR : clause;
  global
	//[] cons_Clause_Neg_L(pos, S=T, Np, Pp, EmptyC) => nil
  	//end
	//[] cons_Clause_Neg_L(pos, S=T, Np, Pp, EmptyC*LR) => 
	//		cons_Clause_Neg_L(pos, S=T, Np, Pp, LR)
  	//end

	[] cons_Clause_Neg_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>
	   [PiSigma, [PiSigma:SSigma=T:Np,Pp]] . nil
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in S	
  	end

	[] cons_Clause_Neg_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
	   [PiSigma, [PiSigma:SSigma=T:Np,Pp]] . cons_Clause_Neg_L(Tr, S=T, Np, Pp,LR)
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in S	
  	end

	[] cons_Clause_Neg_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>	nil
			//where listVar :=() unicate(variables_ofLT(Li))
			//where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			//if neq_list[term](matchRez,MF)		
  	end

	[] cons_Clause_Neg_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
		cons_Clause_Neg_L(Tr, S=T, Np, Pp,LR)
			//where listVar :=() unicate(variables_ofLT(Li))
			//where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			//if neq_list[term](matchRez,MF)		
  	end

//--------------------------------------------------------------------------------------

	[] cons_Clause_Neg_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>
	   [PiSigma, [PiSigma:S=SSigma:Np,Pp]] . nil
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in T	
  	end

	[] cons_Clause_Neg_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
	   [PiSigma, [PiSigma:S=SSigma:Np,Pp]] . cons_Clause_Neg_R(Tr, S=T, Np, Pp,LR)
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in T	
  	end

	[] cons_Clause_Neg_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>	nil
  	end

	[] cons_Clause_Neg_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
		cons_Clause_Neg_R(Tr, S=T, Np, Pp,LR)		
  	end

//--------------------------------------------------------------------------------------

	[] cons_Clause_Pos_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>
	   [PiSigma, [PiSigma:Np,SSigma=T:Pp]] . nil
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in S	
  	end

	[] cons_Clause_Pos_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
	   [PiSigma, [PiSigma:Np,SSigma=T:Pp]] . cons_Clause_Pos_L(Tr, S=T, Np, Pp,LR)
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in S	
  	end

	[] cons_Clause_Pos_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>	nil
  	end

	[] cons_Clause_Pos_L(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
		cons_Clause_Pos_L(Tr, S=T, Np, Pp,LR)		
  	end

//--------------------------------------------------------------------------------------

	[] cons_Clause_Pos_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>
	   [PiSigma, [PiSigma:Np,S=SSigma:Pp]] . nil
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in T	
  	end

	[] cons_Clause_Pos_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
	   [PiSigma, [PiSigma:Np,S=SSigma:Pp]] . cons_Clause_Pos_R(Tr, S=T, Np, Pp,LR)
			where listVar :=() unicate(variables_ofLT(Li))
			where matchRez := () builtinSyntacticMatching(Li,Tr,listVar,MF)
			if neq_list[term](matchRez,MF)
			where sigma := ()system_to_subst(listVar,matchRez)
			where PiSigma := ()apply(sigma,Pi)
			where RiSigma := ()apply(sigma,Ri)	
			where SSigma := ()replace Tr by RiSigma in T	
  	end

	[] cons_Clause_Pos_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]) =>	nil
  	end

	[] cons_Clause_Pos_R(Tr, S=T, Np, Pp, [Pi, Li=Ri:EmptyT]*LR) =>
		cons_Clause_Pos_R(Tr, S=T, Np, Pp,LR)		
  	end

  end

//--------------------------------------------------------------------------------------
rules for clause
	P : equationS;
	C : clause;
	L : list[pair[equationS, clause]];
global
//	[] Get_Precond(nil) => EmptyC
//	end
//	[] Get_Precond([P,C] . L) => [EmptyT,P] * Get_Precond(L)
//	end
	[] Get_Precond(L) => [EmptyT,make_Precond(L):EmptyT]
	end

	[] Get_Clauses(nil) => EmptyC
	end
	[] Get_Clauses([P,C] . L) => C * Get_Clauses(L)
	end
end

rules for equationS
	P : equationS;
	C : clause;
	L : list[pair[equationS, clause]];
global
	[] make_Precond(nil) => EmptyT
	end
	[] make_Precond([P,C] . L) => P : make_Precond(L)
	end
end

//--------------------------------------------------------------------------------------

rules for clause
	P, R : equationS;
	C, L : clause;
global
	[] OrderNp(EmptyC) => EmptyC
	end
	[] OrderNp([R,P]) => [R,OrderEqs(P)]
	end
	[] OrderNp(C * L) => OrderNp(C) * OrderNp(L)
	end
end

rules for equationS
	C, L : equationS;
	s, t : term;
global
	[] OrderEqs(EmptyT) => EmptyT
	end
	[] OrderEqs(s=t) => 
			switch
			case rpo(s,t) then s=t
			otherwise t=s
	 		end
	end
	[] OrderEqs(C : L) => OrderEqs(C) : OrderEqs(L)
	end
end

//--------------------------------------------------------------------------------------

rules for string
	C : clause;
	S : string;
	ct, pt,qt,rt,st,tt,ut : string;
	cp : clause;
global
	[] printClause(S,C) => S
			where ut := ()print("\n")
			where pt := ()print("\n")
			where qt := ()print("%%%%%%%%%%%%%%%%%% Execute =>")
			where rt := ()print(S)
			where tt := ()print(" on:\n")
			where ct := ()printCl(C)
			where st := ()print("\n")
	end
end

rules for string
	C : clause;
	S : string;
	ct,pt,qt,rt,st,tt : string;
	cp : clause;
global
	[] printE(C) => pt
			where pt := ()print("\n")
			where qt := ()print("Clauses to prove:\n")
			where tt := ()print("---------------------------------------\n")
			where ct := ()printCl(C)
	end
end

rules for string
	C : clause;
	S : string;
	ct, pt,qt,rt,st,tt : string;
	cp : clause;
global
	[] printH(C) => pt
			where pt := ()print("\n")
			where qt := ()print("Hypothesis:\n")
			where tt := ()print("---------------------------------------\n")
			where ct := ()printCl(C)
	end
end

rules for string
	C,L : clause;
	Np, Pp : equationS;
	ct,dt,pt,rt : string;
	cp,dp : clause;
global
	[] printCl(EmptyC) => pt
			where pt := ()print(" ")
	end
	[] printCl([Np,Pp]) => pt
			where cp := ()print([Np,Pp])
			where pt := ()print(" ")
	end
	[] printCl(EmptyC*L) => ct
			where ct := ()printCl(L)
	end
	[] printCl(C*L) => ct
			where dt := ()printCl(C)
			where pt := ()print("\n")
			where ct := ()printCl(L)
	end
end

//--------------------------------------------------------------------------------------

end
