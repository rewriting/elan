FOR EACH SS:pair[ident,pair[list[ident],ident]]; 
	F:ident;  DC:pair[list[ident],ident]; 
	D:list[ident]; C:ident; N:int
SUCH THAT SS:=(listExtract) elem(Css)
	AND F:=()first(SS) 
	AND DC:=()second(SS) 
	AND D:=()first(DC)
	AND N:=()size(D)
	AND C:=()second(DC):{

rules for ident
global
	{ [] dom-I(F) => I-th elem(D)
	end
	}_I=1...N

	[] codom(F) => C
	end
end

rules for list[ident]
global
	[] domall(F) => D
	end
end

}

//--------- GET domain and codomain ------------------------------------
FOR EACH SS:pair[ident,pair[list[ident],ident]]; 
	F:ident;  DC:pair[list[ident],ident]; 
	D:list[ident]; C:ident; N:int
SUCH THAT SS:=(listExtract) elem(Fss)
	AND F:=()first(SS) 
	AND DC:=()second(SS) 
	AND D:=()first(DC)
	AND N:=()size(D)
	AND C:=()second(DC):{

rules for ident
global
	{ [] dom-I(F) => I-th elem(D)
	end
	}_I=1...N

	[] codom(F) => C
	end
end

rules for list[ident]
global
	[] domall(F) => D
	end
end

}

// for the variables v-$
rules for ident
	f:ident;
global
	[] codom($f) => $f
	end
end

