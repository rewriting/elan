***********************************************************************************/
//----------------------------------------------------------------------------------

  rules for int
  global
	[] sdepthR	=>
    //--------------------------------- for each rule -----------
    FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
	LC:list[pair[term,term]];  R:list[pair[term,term]]; 
	r:pair[term,term];
	g:term
    SUCH THAT SSS:=(listExtract) elem(Axs)
	AND LC:=()first(SSS) // /\ ui=vi
	AND R:=()second(SSS) // g -> d,.
	ANDIF neq_list[pair[term,term]](R,nil) // g -> d, ... ,.
	AND r:=()1-th elem(R) // g -> d
	AND g:=()first(r) :{
		 max( sdepthT(g), 
	}
		0
    FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
	LC:list[pair[term,term]];  R:list[pair[term,term]]
    SUCH THAT SSS:=(listExtract) elem(Axs)
	AND LC:=()first(SSS) // /\ ui=vi
	AND R:=()second(SSS) // g -> d,.
	ANDIF neq_list[pair[term,term]](R,nil):{
		 )
	}
	end
  end

