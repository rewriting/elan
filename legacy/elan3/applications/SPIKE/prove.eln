rules for list[pair[ident,list[term]]]
	lt : list[term];
	t : term;
	Lts : list[pair[ident,list[term]]];
	v : variable;
	type, d : ident;
global
	[] getClasses(nil, Lts)	=>	Lts
	end
	[] getClasses(t.lt, Lts)	=> getClasses(lt, insert(codom(head(t)), t, Lts))
	end


	[] insert($d, t, [$d, lt].Lts)		=> [$d, t.lt].Lts
	end
	[] insert($d, t, [$type, lt].Lts)	=> [$type, lt].	insert($d, t, Lts)
	end
	[] insert($d, t, nil)			=> [$d, t.nil].nil
	end
end

