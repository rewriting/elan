  rules for list[variable]
	C1, C2 : clause;
	Np, Pp : equationS;
	s, t : term;
	lt : list[term];	
  global
  	[] listVariables(nil) => nil
  	end
  	[] listVariables(t.lt) => unicate(variables_of(t)) @ listVariables(lt)
  	end

  	[] listVariables(EmptyC) => nil
  	end
  	[] listVariables(C1*C2) =>  listVariables(C1) @ listVariables(C2)
  	end
  	[] listVariables([Np,Pp]) =>  listVariables(Np) @ listVariables(Pp)
  	end
  	[] listVariables(EmptyT) => nil
  	end
  	[] listVariables(s=t:Pp) =>  variables_of(s) @ variables_of(t) @ 
					listVariables(Pp)
  	end
  end

