		getClasses( freshListTerm(1, TestSet(ListCons, DepthR, DepthR)), nil )
			//getClasses( TestSet(ListCons, DepthR, DepthR), nil )	
			//TestSet(ListCons, DepthR, DepthR)
	end
	[] TestSETbrief	=>
			getClasses( TestSet(ListCons, DepthR, DepthR), nil )	
			//TestSet(ListCons, DepthR, DepthR)
	end
  end

//----------------------------------------------------------------------------------

  rules for clause
  global
	[] LHsides	=>
  //the left-hand sides of the rules
  FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]];
		PP:list[pair[term,term]]
  SUCH THAT SSS:=(listExtract) elem(Axs)
	AND PP:=()second(SSS)
	:{

	[
	EmptyT,
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(PP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT]*
	}
	EmptyC

	end
  end

//----------------------------------------------------------------------------------

  rules for clause
  global
	[] RulesW	=>
  //the rewrite rules that will be used (non-empty RHS)
  FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
		NP:list[pair[term,term]];  PP:list[pair[term,term]]; F:ident
  SUCH THAT SSS:=(listExtract) elem(Axs)
	AND NP:=()first(SSS) 
	AND PP:=()second(SSS)
	ANDIF neq_list[pair[term,term]](PP,nil)
	AND F:=()head(first(1-th elem(PP)))
	:{
	F : ( replaceVars(
	[
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(NP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT,
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(PP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT]))*
	}
  //the rewrite rules that will be used (empty RHS)
  FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
		NP:list[pair[term,term]];  PP:list[pair[term,term]]
  SUCH THAT SSS:=(listExtract) elem(Axs)
	AND NP:=()first(SSS) 
	AND PP:=()second(SSS)
	ANDIF eq_list[pair[term,term]](PP,nil)
	:{
	NRWR : ( replaceVars(
	[
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(NP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT,
	EmptyT]))*
	}
	EmptyC
	//end rewrite rules part

	end
  end

  rules for clause
	f : ident;
	C1, C2 : clause;
  global
	[] $f:(C1) * $f:(C2)	=>	$f:(C1 * C2)
	end
  end

//----------------------------------------------------------------------------------

  rules for clause
  global
	[] EClause	=>
//the clauses to be proved
  FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
		NP:list[pair[term,term]];  PP:list[pair[term,term]]
  SUCH THAT SSS:=(listExtract) elem(Es)
	AND NP:=()first(SSS) 
	AND PP:=()second(SSS)
	:{

	[
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(NP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT,
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(PP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT]*

	}
	EmptyC

	end
  end

//----------------------------------------------------------------------------------

  rules for clause
  global
	[] Lemma	=>
  FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
		NP:list[pair[term,term]];  PP:list[pair[term,term]]
  SUCH THAT SSS:=(listExtract) elem(Lm)
	AND NP:=()first(SSS) 
	AND PP:=()second(SSS)
	:{

	[
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(NP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT,
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(PP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT]*

	}
	EmptyC

	end
  end

