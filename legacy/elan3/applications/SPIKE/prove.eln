rules for list[pair[ident,variable]]
	s,t : term;
	Lpi : list[indp];
	n,p : equationS;
global
  	[] indVariables(s, Lpi)	=> unicate(indVars(s, Lpi, Lpi)	)
	end

  	[] indVariables(EmptyT, Lpi) =>  nil
	end
  	[] indVariables(s=t, Lpi) =>  unicate(indVariables(s,Lpi) @ indVariables(t,Lpi))
	end

  	[] indVariables(n:p, Lpi) =>  unicate(indVariables(n,Lpi) @ indVariables(p,Lpi))
	end
  	[] indVariables([n,p],Lpi) =>  unicate(indVariables(n,Lpi) @ indVariables(p,Lpi))
	end
end

