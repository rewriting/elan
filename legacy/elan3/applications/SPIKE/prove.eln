FOR EACH SS:pair[ident,pair[int,int]]; 
	F:ident;  A:pair[int,int];
	AL:int; AR:int
SUCH THAT SS:=(listExtract) elem(Ars) 
	AND F:=()first(SS) 
	AND A:=()second(SS) 
	AND AL:=()first(A) 
	AND AR:=()second(A) 
	ANDIF AL==0  
	ANDIF AR==0 :{

  rules for list[pair[ident,variable]]
	Lpi : list[indp];	
