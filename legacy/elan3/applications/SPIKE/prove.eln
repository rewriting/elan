rules for list[term]
	lt : list[term];
	t : term;
	v : variable;
	type : ident;
global
	[] getArgs($type, nil)	=>	nil
	end

	[] getArgs($type, t.lt)	=>	
		switch
		case eq_ident($type, codom(head(t))) then t. getArgs($type,lt)
		otherwise getArgs($type,lt)
	 	end
	end
end

