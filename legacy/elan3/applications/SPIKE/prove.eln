rules for list[term]
	lt : list[term];
	t : term;
	Lts : list[pair[ident,list[term]]];
	v : variable;
	type, d : ident;
global
	[] getOneTs($d, nil)			=> nil
	end
	[] getOneTs($d, [$d, lt].Lts)		=> lt
	end
	[] getOneTs($d, [$type, lt].Lts)	=> getOneTs($d, Lts)
	end
end

