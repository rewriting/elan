module map2[X]

import global 
  strat[X] strat[list[X]] 
  X          list[X];

op global
  map(@) 	: (<X>) <list[X]>;
  start @ 	: (int) <list[X]>;
end

rules for X
 x	: X; 
    	n	: int;
bodies
  [ass(n)] x => n 		end
  [add(n)] x => x+n 		end
  [sub(n)] x => x-n 		end
end

strategies for <list[X]>
 s : <X>;
	n : int;
bodies
  [] map(s)	==> nil				end
  [] map(s)	==> cons(s,map(s))		end

  [] start n	==> map(dk(ass(n),dk(add(n),sub(n))))	end
end

// query	of sort  list[int] result of sort list[int] 
// modules int map1[int] start with [start 2]query

end




