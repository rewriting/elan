module lis4[X]

import global 	Any list[Any] any[X] 
		strat[X] strat[Any] strat[list[Any]]
		strassign[list[Any]];
end

stratop global
  lis(@)	: (<X>) <Any>;
 local
  map(@)	: (<X>) <list[Any]>;
end

strategies for Any
	s	: <X>;
	as	: list[Any]; 		a	: Any;
explicit
/*
  [lis(s)] first(let as:=[map(s)]explode(self) in 
				return implode(functor(self),as),
			(X)s)
*/
  [.] [lis(s)]a => implode(functor(a),as) where as:=[map(s)]explode(a) end
implicit
  [.] lis(s) => (X)s						   end
end

strategies for list[Any]
s	: <X>;
implicit
  [.] map(s) => first(cons(lis(s),id), cons(id,map(s)))	end 
end

end






