module ll

import 	global int bool strat[lterm];
end
sort lterm;
end
operators global
  	@		: (int) lterm;
	(@ @)		: (lterm lterm) lterm;
	la @		: (lterm) lterm;
  	lis(@)  	: (<lterm>) <lterm>;
  	los(@)  	: (<lterm>) <lterm>;
  	repeat @  	: (<lterm>) <lterm>;
  	rep @  		: (int) <lterm>;
  local
	repl(@,@,@)	: (int lterm lterm) lterm;
	free(@,@)	: (int lterm) bool;
end

rules for bool
v	: int;
M, N	: lterm;
global
  []	free(v,v) => true				end
  []	free(v,(M N)) => free(v,M) or free(v,N)		end
  []	free(v,la M) => free(v+1,M)			end
  []	free(v,M) => false				end
end

rules for lterm
v, w	: int;
M, N, Q	: lterm;
global
  []	repl(v,v,M) => M				end
  []	repl(v,w,M) => w				end
  []	repl(v,(M N),Q) => (repl(v,M,Q) repl(v,N,Q))	end
  []	repl(v,la N,M) => la repl(v+1,N,M)		end
end

rules for lterm
M, N	: lterm;
global
  [beta](la M N) => repl(1,M,N)				end
  [eta]	(la M 1) => M if not free(1,M)			end
end

strategies for lterm
s	: <lterm>;
t, y	: lterm;
n1, n	: int;
explicit
  [.] [lis(s)]t => 
//	t end
//	y where y:=[id]t end
//	y where y:=[first(beta,eta)]t end
//	y where y:=[(lis(s) id)]t end
	y where y:=[first((lis(s) id),(id lis(s)), la lis(s), s )]t	end
  [.] [los(s)]t => 
  	y where y:=[first(s, (los(s) id),(id los(s)), la los(s))]t end
implicit
/*
  [rep 0]t	=> la 2000				end
  [rep n]t 	=> y 
		if n > 0
		where n1:=()n-1
		where y:=[rep n1]t 
	end
*/  
  [.] repeat s =>	first(s; repeat s, id)			end
end

end

