module polyDer[Vars]

import global Vars identifier list[identifier] eq[variable] 
	strat[identifier] strat[polynomial];
sort  polynomial ;

op global
  FOR EACH Id:identifier SUCH THAT Id:=(listExtract) elem(Vars) :
   { Id : identifier; }
//  X : identifier;
  one  : polynomial;
  zero : polynomial;
  @	: 	( identifier )   	polynomial		;
  @ + @ : 	( polynomial polynomial ) polynomial;
  derive(@)	: (identifier) <polynomial>;
end

rules global for polynomial
p1, p2, p1p, p2p : polynomial; $x, $y : identifier;
bodies
  [deriveVar1($x)]    $x	 	=> one			end
  [deriveVar2($x)]    $y   	=> $y	if $x != $y	end
  [deriveOne]        one 	=> zero			end
  [deriveZero]       zero 	=> zero			end
  [deriveSum($x)]     p1 + p2 	=> p1p + p2p 	
					where p1p := [derive($x)]p1
					where p2p := [derive($x)]p2 
					end
end

strategies for <polynomial>
$x : identifier;
bodies
  []  derive(x) ==> dc (deriveVar1(x) , deriveVar2(x) ,
			deriveOne ,  deriveZero , 
			deriveSum(x) )			end
end

end
