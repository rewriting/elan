module sigSyntax

	// This module describes a possible syntax for the user specification

import 
	global	anyIdentifier anyInteger;
	local	identifier list[identifier];
op 
 global

  @	  : ( ident ) identifier			alias @:;
  Epsilon : list[identifier]		      		alias nil:;
  @ ; @	  : ( identifier list[identifier] ) list[identifier]   
							alias cons(@,@):;
endop

end of module
