LPL lvariables description

	specification description

		part Vars of sort list[identifier]
	 	import sigSyntax

		part Ops of sort list[pair[identifier,int]]
	 	import sigSyntax

		part Prec of sort list[pair[identifier,int]]
	 	import sigSyntax

		part System of sort list[equation]
		import 	sigSyntax
			list[equation]
			eqSystem[Ops,Vars]
			termCommons[Ops,Vars]
			lvariables[Vars,Ops,Prec]
	end

	query of sort list[variable]

	result of sort list[variable]

	import lvariables[Vars,Ops,Prec]

       	start with ()query

end







