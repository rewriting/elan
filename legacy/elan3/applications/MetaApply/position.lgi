		part Ops of sort list[pair[identifier,int]]
	 	import sigSyntax

		part Prec of sort list[pair[identifier,int]]
	 	import sigSyntax

		part System of sort list[equation]
		import 	sigSyntax
			list[equation]
			eqSystem[Ops,Vars]
			termCommons[Ops,Vars]
			position[Vars,Ops,Prec]
	end

	query of sort list[term]

	result of sort list[term]

