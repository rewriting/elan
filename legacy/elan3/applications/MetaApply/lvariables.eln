module lvariables[vars,fss,prec]

/* Module containing operations concerning the lists of variables */

/* vars : variables, 
   fss  : operators,
   prec : precedence */


import
	local
		vars
		fss
		prec
		int
		bool 
		identifier
		pair[identifier,int] /* used for the strategy listExtract */
		list[pair[identifier,int]]
		termCommons[fss,vars] /* defined the sort term so variable */
		eqSystem[fss,vars] /* defined the sort eqSystem so equation */
		list[variable]
		occur[variable,list[variable]]
	;
end


operators
	global

	/* Provide the list of variables of a term or of an equational */
	/* system without duplication of variables */
	list_variables(@)	: (term) list[variable];
	list_variables(@)	: (eqSystem) list[variable];

	/* Provide the list of variables of a term or of an equational */
	/* system with duplication of variables */
	list_variables1(@)	: (term) list[variable];
	list_variables1(@)	: (eqSystem) list[variable];

	/* Test the inclusion of a list of variables in another list */
	/* of variables */
	include(@,@)		: (list[variable] list[variable]) bool;
end


/* list_variables1 */

rules for list[variable]
	l,r            : term;
	v              : variable;
	lv,lr          : list[variable];
	C              : eqSystem;
	b              : bool;
	X              : variable;
	n 	       : int;
global
	[] list_variables1(X) => X.nil
	end

	[] list_variables1(var(n)) => var(n).nil
	end
end


FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(fss) AND F:=()first(SS) 
AND N:=()second(SS) :{
	rules for list[variable]
		t_1,...,t_N : term;
	global
	[] list_variables1(F(t_1,...,t_N)) => { list_variables1(t_I) @@
	}_I=1...N nil
      end
  end
}


/* list_variables */

rules for list[variable]
	t : term;
global
	[] list_variables(t)	=> simple_list(list_variables1(t))
	end
end


/* list_variables1 */

rules for list[variable]
	l,r            : term;
	v              : variable;
	lv,lr          : list[variable];
	C              : eqSystem;
	b              : bool;
global
	[] list_variables1(l->r) => list_variables1(l)
	end

	[] list_variables1(l=r) => list_variables1(l) @@ list_variables1(r)
	end

	[] list_variables1(C & l=r) =>
	list_variables1(C) @@ list_variables1(l) @@ list_variables1(r)
	end

	[] list_variables1(C & l->r) => list_variables1(C) @@ list_variables1(l)
	end

	[] list_variables1(C & b) => list_variables1(C)
	end

	[] list_variables1(true) => nil	
	end
end


/* list variables */

rules for list[variable]
	eqs : eqSystem;
global
	[] list_variables(eqs)	=> simple_list(list_variables1(eqs))
	end
end


/* include */

rules for bool
	e: variable;
	l,ll: list[variable];
global
	[] include(nil,l) => true
	end

	[] include(e.l,ll) =>	switch
				case occurs(e,ll) then include(l,ll)
				otherwise false
				end
	end

end

end



