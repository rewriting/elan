module mySyntacticUnification[Fss,Vars,Mvs]
import  global  EtermCommons[Fss,Vars,Mvs];
        local   Mvs Fss int identifier bool pair[identifier,int]
                list[pair[identifier,int]] eq[variable] eq[term]
                myEqSystem[Fss,Vars,Mvs] occur[variable,term]
		occur[variable,eqSystem]
                myApplySubstOn[Fss,Vars,Mvs,term] ;
end

sort mvariable;
end

operators
  global
    @ = @       : (term term) equation          alias @=@:;
    @           : ( equation ) eqSystem         alias @:;
  local
    mergingClash(@,@,@) : ( eqSystem variable term ) bool;

end

rules for eqSystem
	P,Q,R:eqSystem;
	s,t:term;
	x,y:variable;
	isvar1,isvar2:bool;
global

  [delete]      P & $x=$y => P            
                        if eq($x,$y)
  end
  [conflict]    P & $s=$t => false
                        where isvar2 := (isVariable) isvar($t)
                        where isvar1 := (isVariable) isvar($s)
                        if head($s)!=head($t) 
                           and not(isvar1) and not(isvar2)
  end
  [occCheck1]   P & $x=$s => false
                        where isvar1 := (isVariable) isvar($s)
                        if occurs $x in $s and not isvar1
  end
  [occCheck2]   P & $s=$x => false
                        where isvar1 := (isVariable) isvar($s)
                        if occurs $x in $s and not isvar1
  end
  [matchClash]  P & $s=$x => false
                        where isvar1 := (isVariable) isvar($s)
                        if not isvar1 
  end
  [mergeClash]  P & $x=$s => false
                        if mergingClash(P,$x,$s)
  end
  [mergePass1]  P & $x=$s => $x=$s & P
  end
  [mergePass2]  P & $x=$s => $x=$s & P
                        if not(occurs $x in P) // and not mergingClash(P,x,s)
  end
  [mergePass3]  P & $x=$s => P
                        if occurs $x in P // and  not mergingClash(P,x,s)
  end


FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
        AND N:=()second(SS) :{
   rules for eqSystem
    s_1,...,s_N:term; t_1,...,t_N:term;
   global
     [decompose] P & F(s_1,...,s_N)=F(t_1,...,t_N)  => P { & s_I=t_I }_I=1...N
     end
   end
  }

FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Mvs) AND F:=()first(SS) 
        AND N:=()second(SS) :{
   rules for eqSystem
    s_1,...,s_N:term; t_1,...,t_N:term;
   global
     [decompose] P & F(s_1,...,s_N)=F(t_1,...,t_N)  => P { & s_I=t_I }_I=1...N
     end
   end
  }


// initial and final transitions rules

  [trueelim]    P & true        => P                            end
  [truepass]    P & true        => true & P                     end
  [trueadd]     P               => true & P                     end
  [falsepropag] false           => false                        end
  [truepropag]  true            => true                         end

end

rules for bool
 P,Q:eqSystem; s,t:term; x,y:variable;
local
  [] mergingClash(true,$x,$s) => false                            end
  [] mergingClash(P & Q,$x,$s) => mergingClash(P,$x,$s) 
                                or mergingClash(Q,$x,$s)          end
  [] mergingClash($x=$s,$y,$t) => eq($x,$y) and neq($s,$t)        end
end

strategies for eqSystem
global
[matchs]
  repeat* (
    dc first one( unfold , 
        delete , decompose , conflict ,
                     matchClash , mergePass1)
  );
  dc first one(truepass , truepropag);
  repeat* (
    dc first one( unfold , 
        mergeClash , mergePass2 , mergePass3)
  );
  dc first one(truepass , truepropag)
end
end

end
