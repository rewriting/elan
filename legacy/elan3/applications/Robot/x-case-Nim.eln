module Nim

import global 
   int 
   Space Quick
   State list[state] list[list[state]]
   strat[state] strat[list[list[state]]];
end
stratop global
  movetowin	: <list[list[state]]>;
  findawinner	: <list[list[state]]>;
  heuristic	: <list[list[state]]>;
  step		: <list[list[state]]>;
end

rules for state
position, state	: state;
level		: list[state];
space		: list[list[state]];
global
  [guess]  position => state
		where (list[list[state]]) state.level.space :=
					  [step]position.nil.nil
  end
end

strategies for list[list[state]]
level	: list[state];
space	: list[list[state]];
explicit
  [.] [heuristic]level.space => sort(level).space
  end
implicit
  [.] step =>  dc(movetowin, call(moves); heuristic)
  end
  [.] movetowin => if call(win) then 
			id
		     orelse 
			call(moves); findawinner; cut
		     fi
  end
  [.] findawinner => if movetowin then 
		  exit; next; findawinner
		orelse 
		  id
		fi
  end
end

