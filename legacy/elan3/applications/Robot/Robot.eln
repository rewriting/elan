module Robot

import global 	Space strat[state] strat[list[list[state]]]
		int bool labyrint;
end
sort state;
end
operators global
  [@,@]		: (int int) state;
end

stratop global
  up		: <state>;
  down		: <state>;
  left		: <state>;
  right		: <state>;
  exitable	: <state>;
  search	: <list[list[state]]>;
  allsearch	: <list[list[state]]>;
 local
  moves		: <state>;
end

rules for state
	x,y,dx,dy,dir	: int;
local
  [move(dx,dy,dir)] 
	[x,y] => [x+dx,y+dy]
		if room(x,y) & dir != 0			
  end
end

strategies for state
implicit
  [.] up => 	move( 1, 0, U)				end
  [.] down => 	move(-1, 0, D)				end
  [.] left => 	move( 0,-1, L) 				end
  [.] right => 	move( 0, 1, R)				end
  [.] exitable => move(0,0,E)				end
  [.] moves => 	dk(right, dk(down, dk(left, up)))	end
end

strategies for list[list[state]]
  state	: state;
  level	: list[state];
  space	: list[list[state]];
  ls	: list[list[state]];
explicit
  [.] [search] state.level.space => ls
		where ls:=
		[first(	call(exitable); narrow,
			if occurs state in space then 
			  next;search
			else
			  first(call(moves);search, next;search)
			fi
		)]state.level.space
  end
  [.] [allsearch]state.level.space => ls
		where ls:=[dk( 
		     call(exitable);narrow,
		     if occurs state in space then 
		       next 
 		     else 
		       dk(call(moves), next)
                     fi; 
		     allsearch
		   )]state.level.space
  end
/*
  [search] first( call(exitable); narrow,
		 if loop then 
		   next;search
		 orelse 
		   first(call(moves);search, next;search)
                 fi
		)
  end
  [allsearch] dk( 
		     call(exitable);narrow,
		     if loop then 
		       next 
 		     orelse 
		       dk(call(moves), next)
                     fi; 
		     allsearch
		   )
  end
*/
end

end

