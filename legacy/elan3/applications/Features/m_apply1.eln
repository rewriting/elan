module m_apply1

import global builtinInt string REF Meta_Apply refstring2string ref2string[Strategy] ref2string[Term] ref2string[Program] string2refterm;
end

operators global
  foo(@)	: (int) string;
end

rules for string
x	: int;
xx	: builtinInt;
s	: string;
t	: Term;
P, P1	: Program;
global
  []   foo(xx) => s
	where s:=(META)
