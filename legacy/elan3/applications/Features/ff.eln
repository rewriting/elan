module ff

import global int bool eq[Foo];
end
sort Foo;
end
operators global
  a	: Foo;
  b	: Foo;
  c	: Foo;
  d	: Foo;
  [@,@]	: (Foo Foo) Foo;
  doit(@,@) : (int Foo) Foo;
  qqq(@) : (Foo) Foo;
end

stratop
  global 
    foo		: <Foo>		builtin;
    or		: <Foo>		builtin;
    more	: <Foo>		builtin;
end

rules for Foo
 p,r,s,t,rr:Foo;
	aa,bb:bool;
	n	: int;
global
  [A] p => 
	     where (Foo)rr:=()p
	     switch	
		case true then [s,r]
			where (Foo)[r,s]:=()[rr,rr]
	     end
  end
  []	doit(0,p) => p end
  []  	doit(n,p) => doit(n-1,s)where (Foo)r:=()doit(n-1,p)
				where (Foo)s:=()qqq(r)
  end
  []	qqq([r,s]) => switch
		case r == s then r
		otherwise d
	     end
  end
  []	qqq(p) => p end
//------------------------------------------------------------------
  [MORE]	p => a end
  [MORE]	p => b end
  [MORE]	p => c end
  [MORE]	p => d end
  [OR]  p => switch
		case p == a then b
		case p == b then c
		case p == c then d
		otherwise        a
	     end
  end
  [FOO]	p => 
	     where (Foo)s:=(or)p
	     switch
		case s==b then [c,[s,t]] 
				where (Foo)t:=(more)p
				if s!=t    
		case s==a then [d,[s,t]] 
				where (Foo)t:=(more)p
		otherwise d
	     end
  end
  [AA] p => a
	     where (Foo)t:=()c 
	     where (Foo)t:=()c 
  end
  [B]	p => 
	     where (Foo)rr:=(more)a if true
	     switch
		case false then a   where (Foo)t:=(more)a if true
		case false then a   where (Foo)t:=(more)a if true
		otherwise b         where (Foo)s:=(more)a if true
	     end
  end
  [C]	p =>  
	      switch
		case true then
		  where (Foo)s:=(more) a
		  switch
		    case true then p where (Foo)r :=(more) a
	            otherwise      b where (Foo)r :=(or) a 
		  end
		otherwise p where (Foo)r:=(more)a
	      end
  end 
  [D]	p =>  
	      where (Foo)rr:=(more)a
	      switch  
		case true then
		  where (Foo)s:=(more) a
		  switch 
		    case true then [r,r] where (Foo)r :=(more) a
	            otherwise      b where (Foo)r :=(more) a
		  end
		case false then p
		otherwise
		    where (Foo)r:=(more)a
		    switch
		      case true then b
		      otherwise      a
		    end
		end
  end
  [F]	p => 
	     where (Foo)r:=()p
	     where (bool)aa:=()true
	     switch
		case aa then [c,c]
		case true then c where (bool)bb:=() true
	     end
  end
  [G]	p =>  where (Foo)t:=(or)p
	      if t != a
	      switch  
		case t == c then [d,d]
		case t == b then [t,r]  
					where (Foo)r:=(more)p 
					if r != a 
					if r != b
		otherwise [t,r] 
				where (Foo)r:=()[t,t]
				if r != a 
	     end
  end
end

strategies for Foo
implicit
  [.] foo => 	dk(FOO)      //  dk(A)  //  dc(FOO)
  end
  [.] or => 		dc(OR)
  end
  [.] more =>	dk(MORE)
  end
end

end 


