LPL RestrictUnifFA description

  specification description

    part Vars	of sort list[identifier]
	 	import sigSyntax
    part Ops	of sort list[pair[identifier,int]]
	 	import sigSyntax

  end

  query 	of sort eqSystem
         	result of sort eqSystem
	 	import RestrictUnifFA[Vars,Ops] eqSystem bool int

         	start with (restrictUnifFA) query 

end
