module Part

import term list[variable] pair[list[variable],list[variable]] ; end


operators 

  global

  Part(@) : (list[variable]) pair[list[variable],list[variable]] ;

  x : variable ;
  y : variable ;
  z : variable ;
  u : variable ;
  v : variable ;
  w : variable ;


end

rules for pair[list[variable],list[variable]]
//declare	
        x 	: variable ;
	l	: list[variable] ;
        p       : pair[list[variable],list[variable]] ;

global

  [Part1] Part(x.l)	=> [x.first(p),second(p)]
                           where p:= (choosePart) Part(l) 
                           end

  [Part2] Part(x.l)	=> [first(p),x.second(p)]
                           where p:= (choosePart) Part(l) 
                           end

  [Part3] Part(nil)     => [nil,nil] end


end


strategies for pair[list[variable],list[variable]]

 global 
    [choosePart]
    dont know choose(Part1 || Part2 || Part3) 
    end

end


end
