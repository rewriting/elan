module nim

import global 
   integ 
   space 
   state
   strat[list[list[state]]];

op global
  movetowin	: <list[list[state]]>;
  findawinner	: <list[list[state]]>;
end

strategies for <list[list[state]]>
bodies
  []	movetowin ==> if call(win) then 
			id
		     orelse 
			call(moves); findawinner 
		     fi
  end
  []	findawinner ==> if movetowin then 
			  exit; next; findawinner
		       orelse 
			  exit
		       fi
  end
end

