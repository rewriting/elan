module filter

import global strat[integ] strat[list[integ]]
		integ list[integ];
end
operators global
  filter(@) : (<integ>) <list[integ]>;
end

rules for integ
 n:integ;
global
  [large]	n => n+1 if n > 10			end
end

strategies for list[integ]
	s : <integ>;
	h : integ; t : list[integ];
defined
  [filter(s)] dc(	nil,
		 	dc( s.filter(s),
			    [h.t => t] ; filter(s)))
  end
end

end
