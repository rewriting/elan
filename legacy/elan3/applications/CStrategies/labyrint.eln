module labyrint

import global integ;

op global
  U		: integ;		// upward possible
  D		: integ;  		// downward possible
  L		: integ;  		// leftward possible
  R		: integ;  		// rightward possible
  E		: integ;  		// exitable room
  room(@,@)	: (integ integ) integ;
end

rules for integ
bodies
  []	U	=> 1			end
  []	D	=> 2			end
  []	L	=> 4			end
  []	R	=> 8			end
  []	E	=> 16			end
/*
+--------+
|        |
|--  ----|
|    |   |
|  --    |
|      | |
|--      | 
|        |
+--------+
*/
  []	room(0,0)	=> R		end
  []	room(0,1)	=> R+L+U	end
  []	room(0,2)	=> R+L+U	end
  []	room(0,3)	=> L+U		end
  []	room(1,0)	=> U+R		end
  []	room(1,1)	=> R+D+L	end
  []	room(1,2)	=> L+U+D	end
  []	room(1,3)	=> U+D		end
  []	room(2,0)	=> D+R		end
  []	room(2,1)	=> L+U		end
  []	room(2,2)	=> D+R		end
  []	room(2,3)	=> L+D		end
  []	room(3,0)	=> R		end
  []	room(3,1)	=> R+D+L	end
  []	room(3,2)	=> R+L		end
  []	room(3,3)	=> L+E		end
end

end
