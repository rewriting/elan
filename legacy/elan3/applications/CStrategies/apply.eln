module apply[X,Y]

import global tcstrat[X,Y] tcstrat[list[X],list[Y]]
  	      X Y list[X] list[Y];
end
operators global
  apply 	: <list[X] -> list[Y]>;
  apply(@) 	: (<X->Y>) <list[X] -> list[Y]>;
end

rules for X->Y
 
    x  	: X; 
    n	: integ;
global
  [tr(n)] x => true 					end
  [trr(n)] x => false 					end
end

strategies for list[X] -> list[Y]
 s : <X->Y>; 
defined
  [apply(s)] dc(nil,s.apply(s))  end
end

end
