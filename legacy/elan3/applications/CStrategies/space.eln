module space

import global 	list[state] 		// Level
		list[list[state]]	// Space
		eq[state] eq[list[state]]
	  	strcapply[state]
		booleg eq[booleg]
		strat[state] 
		strat[list[list[state]]];

sort state;

op global
  occurs @ in @	: (state list[list[state]]) booleg;
  next		: <list[list[state]]>;
  exit		: <list[list[state]]>;
  cut		: <list[list[state]]>;
  call(@)	: (<state>) <list[list[state]]>;
  loop		: <list[list[state]]>;
  narrow	: <list[list[state]]>;
end

rules for booleg

  state1, state2	: state;
  level			: list[state];
  space			: list[list[state]];
bodies
  []	occurs state1 in nil => false					end
  []	occurs state1 in state2.level.space => true if state1 == state2	end
  []	occurs state1 in state2.level.space => occurs state1 in space	end
end

strategies for <list[list[state]]>

  state			: state;
  s			: <state>;
  level			: list[state];
  space			: list[list[state]];
  new_level		: list[state];
  new_space		: list[list[state]];
bodies
  []	[next]state.level.space	=> level.space		end
  []	[exit]state.level.space	=> space		end
  []	[cut]state.level.space	=> state.nil.space	end
  []	[call(s)]state.level.space => new_level.state.level.space
					if new_level != nil
					where new_level:=()setof(s,state)
  end
  []	[loop]state.level.space => state.level.space if 
				occurs state in space==true
  end
  []	[narrow]state.level.space => state.nil.new_space
			where new_space:=[narrow]space	end
  []	[narrow]nil => nil				end
end

end

















