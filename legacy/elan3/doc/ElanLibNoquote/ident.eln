module ident
import global anyIdentifier;
       local  bool;
end
sort ident;
end
operators
 global

   @ == @       : ( ident ident ) bool			code 14;
   @ != @       : ( ident ident ) bool			code 15;

   ideq(@,@)    : ( ident ident ) bool     	alias @ == @:;
   idneq(@,@)   : ( ident ident ) bool     	alias @ != @:;

end

end

