module eq[X]

	// This module in fact hides some operations
	// defined in the module cmp.
	// The importation dependency could have been, instead of
	// the present one: cmp -import-> eq -import-> bool

import bool cmp[X];
end
operators
  global

    @ == @	: ( X X ) bool		alias @ == @:;
    @ != @	: ( X X ) bool		alias @ != @:;

    eq(@,@)	: ( X X ) bool		alias @ == @:;
    neq(@,@)	: ( X X ) bool		alias @ != @:;

end

end
