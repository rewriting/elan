module integerConstants

	// This module is NOT loadable. It only describe the semantics of the 
	// built in elements of the sort int, i.e all the integer numbers.

sort int
op
 global

  0	: int;
  1	: int;
  -1	: int;
  2	: int;
  -2	: int;
  3	: int;
.
.
.

end

end
