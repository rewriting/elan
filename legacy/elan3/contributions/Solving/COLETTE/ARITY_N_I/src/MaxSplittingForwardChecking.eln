module MaxSplittingForwardChecking[Variables,Type,Values]

import
global
	OptimizationRules[Variables,Type,Values]
	ForwardChecking[Variables,Type,Values]
	ForwardCheckingChoicePoint[Variables,Type,Values]
	ForwardCheckingChoicePointII[Variables,Type,Values]
	;
end

stratop
global
	MaxSplittingFCFirstToLast				: < csop -> csop >	bs;
	MaxSplittingFCLastToFirst				: < csop -> csop >	bs;
	MaxSplittingFCSplitFirstToLast				: < csop -> csop >	bs;
	MaxSplittingFCSplitLastToFirst				: < csop -> csop >	bs;
