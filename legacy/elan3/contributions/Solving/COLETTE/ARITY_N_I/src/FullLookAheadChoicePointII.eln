module FullLookAheadChoicePointII[Variables,Type,Values]

import
global
	LocalConsistencyStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	;
end

stratop
global
	FLAChoicePointIIFirstToLastAll			: < csp -> csp >	bs;
	FLAChoicePointIIFirstToLastOne			: < csp -> csp >	bs;
	FLAChoicePointIILastToFirstAll      		: < csp -> csp >	bs;
	FLAChoicePointIILastToFirstOne      		: < csp -> csp >	bs;
	FLAChoicePointIISplitFirstToLastAll      	: < csp -> csp >	bs;
	FLAChoicePointIISplitFirstToLastOne      	: < csp -> csp >	bs;
	FLAChoicePointIISplitLastToFirstAll      	: < csp -> csp >	bs;
	FLAChoicePointIISplitLastToFirstOne      	: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Full Lookahead with Choice Point and Enumeration	*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: All							*/

[] FLAChoicePointIIFirstToLastAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	dk (iterate* (EliminateFirstValueOfDomain));
	first one (InstantiateFirstValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	LocalConsistencyForEC
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point and Enumeration	*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: First							*/

[] FLAChoicePointIIFirstToLastOne =>
first one (FLAChoicePointIIFirstToLastAll)
end


/* Strategy		: Full Lookahead with Choice Point and Enumeration	*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: All							*/

[] FLAChoicePointIILastToFirstAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	LocalConsistencyForEC
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point and Enumeration	*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: First							*/

[] FLAChoicePointIILastToFirstOne =>
first one (FLAChoicePointIILastToFirstAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: All 					*/

[] FLAChoicePointIISplitFirstToLastAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: First					*/

[] FLAChoicePointIISplitFirstToLastOne =>
first one (FLAChoicePointIISplitFirstToLastAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: All 					*/

[] FLAChoicePointIISplitLastToFirstAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: First					*/

[] FLAChoicePointIISplitLastToFirstOne =>
first one (FLAChoicePointIISplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FLAChoicePointIIFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointIIFirstToLastOne)P
end

[FLAChoicePointIILastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointIILastToFirstOne)P
end

[FLAChoicePointIISplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=()P
end

[FLAChoicePointIISplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=()P
end

[GetUBFLAChoicePointIIFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointIIFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointIILastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointIILastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointIISplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointIISplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointIISplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointIISplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointIIFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointIIFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointIILastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointIILastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointIISplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointIISplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointIISplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointIISplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
