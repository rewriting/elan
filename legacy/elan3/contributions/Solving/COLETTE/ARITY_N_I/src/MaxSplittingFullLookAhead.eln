module MaxSplittingFullLookAhead[Variables,Type,Values]

import
global
	OptimizationRules[Variables,Type,Values]
	FullLookAhead[Variables,Type,Values]
	FullLookAheadChoicePoint[Variables,Type,Values]
	FullLookAheadChoicePointII[Variables,Type,Values]
	;
end

stratop
global
	MaxSplittingFLAFirstToLast				: < csop -> csop >	bs;
	MaxSplittingFLALastToFirst				: < csop -> csop >	bs;
	MaxSplittingFLASplitFirstToLast				: < csop -> csop >	bs;
	MaxSplittingFLASplitLastToFirst				: < csop -> csop >	bs;
