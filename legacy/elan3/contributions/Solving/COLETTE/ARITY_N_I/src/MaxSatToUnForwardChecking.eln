strategies for csop
implicit

/* Optimization Strategy: */
/* Search Strategy	: */
/* Variable selection	: */
/* Value selection	: */

[] MaxSatToUnFCFirstToLast =>
first one (PostGTELowerBound);
LocalConsistencyForEC;
first one (GetLBFCFirstToLastOne);
repeat* (
	first one( first one (PostGTLowerBound);
		   LocalConsistencyForEC;
		   first one (GetLBFCFirstToLastOne)
		   ,
		   first one (SetUpperBoundToLowerBound)
		 )
	);
first one (FCFirstToLastOne);
first one (GetSolutionCSOP)
end


