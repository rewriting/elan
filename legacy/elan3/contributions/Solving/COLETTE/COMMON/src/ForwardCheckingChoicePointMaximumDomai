stratop
global
	FCChoicePointMaximumDomainFirstToLastAll  		: < csp -> csp >	bs;
	FCChoicePointMaximumDomainFirstToLastOne  		: < csp -> csp >	bs;
	FCChoicePointMaximumDomainLastToFirstAll  		: < csp -> csp >	bs;
	FCChoicePointMaximumDomainLastToFirstOne  		: < csp -> csp >	bs;
	FCChoicePointMaximumDomainSplitFirstToLastAll  		: < csp -> csp >	bs;
