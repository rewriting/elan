strategies for csop
implicit

/* Optimization Strategy: */
/* Search Strategy	: */
/* Variable selection	: */
/* Value selection	: */

[] MinSatToUnFCFirstToLast =>
first one (PostLTEUpperBound);
LocalConsistencyForEC;
first one (GetUBFCFirstToLastOne);
repeat* (
	first one( first one (PostLTUpperBound);
		   LocalConsistencyForEC;
		   first one (GetUBFCFirstToLastOne)
		   ,
		   first one (SetLowerBoundToUpperBound)
		 )
	);
first one (FCFirstToLastOne);
first one (GetSolutionCSOP)
end


