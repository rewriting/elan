strategies for csop
implicit

/* Optimization Strategy: */
/* Search Strategy	: */
/* Variable selection	: */
/* Value selection	: */

[] MaxSplittingFCMinimumDomainFirstToLast =>
first one (PostGTELowerBound);
LocalConsistencyForEC;
first one (GetLBFCMinimumDomainFirstToLastOne);
first one (OvervalueUpperBound);
repeat* (
	first one( first one (SetLowerBoundToMiddle);
		   first one (PostGTLowerBound);
		   LocalConsistencyForEC;
		   first one (GetLBFCMinimumDomainFirstToLastOne)
		   ,
		   first one (SetUpperBoundToMiddle)
		 )
	);
first one (FCMinimumDomainFirstToLastOne);
first one (GetSolutionCSOP)
end


