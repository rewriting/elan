module ForwardCheckingWithCD3[Variables,Type,Values]

import
global
	ConstructiveDisjunctionStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	PropagationRules[Variables,Type,Values]
	ChoicePointStrategies[Variables,Type,Values]
	;
end

stratop
global
	FCWithCD3FirstToLastAll			: < csp -> csp >	bs;
	FCWithCD3FirstToLastOne			: < csp -> csp >	bs;
	FCWithCD3LastToFirstAll			: < csp -> csp >	bs;
	FCWithCD3LastToFirstOne			: < csp -> csp >	bs;
	FCWithCD3SplitFirstToLastAll		: < csp -> csp >	bs;
	FCWithCD3SplitFirstToLastOne		: < csp -> csp >	bs;
	FCWithCD3SplitLastToFirstAll		: < csp -> csp >	bs;
	FCWithCD3SplitLastToFirstOne		: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: All 							*/

[] FCWithCD3FirstToLastAll =>
dk (LocalConsistencyForECandDCWithCD3);
repeat* (
	dk (iterate* (EliminateFirstValueOfDomain));
	first one (InstantiateFirstValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: First 						*/

[] FCWithCD3FirstToLastOne =>
first one (FCWithCD3FirstToLastAll)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: All 							*/

[] FCWithCD3LastToFirstAll =>
dk (LocalConsistencyForECandDCWithCD3);
repeat* (
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: First 						*/

[] FCWithCD3LastToFirstOne =>
first one (FCWithCD3LastToFirstAll)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain first to last				*/
/* Number of solutions	: All 							*/

[] FCWithCD3SplitFirstToLastAll =>
dk (LocalConsistencyForECandDCWithCD3);
repeat* (
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain first to last				*/
/* Number of solutions	: First							*/

[] FCWithCD3SplitFirstToLastOne =>
first one (FCWithCD3SplitFirstToLastAll)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain last to first				*/
/* Number of solutions	: All 							*/

[] FCWithCD3SplitLastToFirstAll =>
dk (LocalConsistencyForECandDCWithCD3);
repeat* (
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain last to first				*/
/* Number of solutions	: First							*/

[] FCWithCD3SplitLastToFirstOne =>
first one (FCWithCD3SplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FCWithCD3FirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD3FirstToLastOne)P
end

[FCWithCD3LastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD3LastToFirstOne)P
end

[FCWithCD3SplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD3SplitFirstToLastOne)P
end

[FCWithCD3SplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD3SplitLastToFirstOne)P
end

[GetUBFCWithCD3FirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD3FirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCWithCD3LastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD3LastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCWithCD3SplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD3SplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCWithCD3SplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD3SplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD3FirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD3FirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD3LastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD3LastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD3SplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD3SplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD3SplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD3SplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
