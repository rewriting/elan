strategies for csop
implicit

/* Optimization Strategy: */
/* Search Strategy	: */
/* Variable selection	: */
/* Value selection	: */

[] MinSatToUnFLAFirstToLast =>
first one (PostLTEUpperBound);
LocalConsistencyForEC;
first one (GetUBFLAFirstToLastOne);
repeat* (
	first one( first one (PostLTUpperBound);
		   LocalConsistencyForEC;
		   first one (GetUBFLAFirstToLastOne)
		   ,
		   first one (SetLowerBoundToUpperBound)
		 )
	);
first one (FLAFirstToLastOne);
first one (GetSolutionCSOP)
end


