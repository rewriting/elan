module MinSatToUnFullLookAhead[Variables,Type,Values]

import
global
	OptimizationRules[Variables,Type,Values]
	FullLookAhead[Variables,Type,Values]
	FullLookAheadChoicePoint[Variables,Type,Values]
	FullLookAheadChoicePointII[Variables,Type,Values]
	;
end

stratop
global
	MinSatToUnFLAFirstToLast				: < csop -> csop >	bs;
	MinSatToUnFLALastToFirst				: < csop -> csop >	bs;
	MinSatToUnFLASplitFirstToLast				: < csop -> csop >	bs;
	MinSatToUnFLASplitLastToFirst				: < csop -> csop >	bs;
