module MaxSatToUnFullLookAhead[Variables,Type,Values]

import
global
	OptimizationRules[Variables,Type,Values]
	FullLookAhead[Variables,Type,Values]
	FullLookAheadChoicePoint[Variables,Type,Values]
	FullLookAheadChoicePointII[Variables,Type,Values]
	;
end

stratop
global
	MaxSatToUnFLAFirstToLast				: < csop -> csop >	bs;
	MaxSatToUnFLALastToFirst				: < csop -> csop >	bs;
	MaxSatToUnFLASplitFirstToLast				: < csop -> csop >	bs;
	MaxSatToUnFLASplitLastToFirst				: < csop -> csop >	bs;
