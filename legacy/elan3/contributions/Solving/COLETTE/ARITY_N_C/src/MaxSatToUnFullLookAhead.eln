strategies for csop
implicit

/* Optimization Strategy: */
/* Search Strategy	: */
/* Variable selection	: */
/* Value selection	: */

[] MaxSatToUnFLAFirstToLast =>
first one (PostGTELowerBound);
LocalConsistencyForEC;
first one (GetLBFLAFirstToLastOne);
repeat* (
	first one( first one (PostGTLowerBound);
		   LocalConsistencyForEC;
		   first one (GetLBFLAFirstToLastOne)
		   ,
		   first one (SetUpperBoundToLowerBound)
		 )
	);
first one (FLAFirstToLastOne);
first one (GetSolutionCSOP)
end


