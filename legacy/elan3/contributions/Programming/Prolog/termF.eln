module termF[Fss]

import global 	term;
       local 	int identifier bool Fss pair[identifier,int] 
		list[pair[identifier,int]] list[int];
end

operators
  global



	// This creates from the user specification the actual 
	// rank for operators d of arity zero (the constants)
  FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
  SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
	AND N:=()second(SS) ANDIF N==0 :{

      F: Fsymbol ;

      F()     	: term;
      F	: term				alias F():;
    }

	// From the user specification, this creates the actual
	// rank for non constant operators
FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
	AND N:=()second(SS) ANDIF N > 0 :{

     F: Fsymbol ;

     F({,@}~N) 	: ({term}~N)term;

     F({@,}~N)		: ({term}~N)term 	alias F({,@}~N):;
     F(,{@,}~N)	: ({term}~N)term 	alias F({,@}~N):;
     F(@ {,@}~(N-1))	:({term}~N) term 	alias F({,@}~N):;

    }

end



stratop
  global
   chooseOccurence	: <list[int]>		builtin;
end




FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
	AND N:=()second(SS) ANDIF N > 0 :{
  rules for term
   t_1,...,t_N : term;
  global

   { [] I-th subterm(F(t_1,...,t_N))   => t_I		end
   }_I=1...N

   rules for Fsymbol
   global
     [] head(F(t_1,...,t_N)) => F end
   end

   rules for int 
   global  
     [] arity(F) => N end
   end

   rules for list[int]
    oocc:list[int];
   local
   { [inOccRule] nvocc(F(t_1,...,t_N))	=> J.oocc 
		where oocc:=(chooseOccurence) nvocc(t_J)
      end
   }_J=1...N
   end

  end
}

FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
	AND N:=()second(SS) ANDIF N == 0 :{
   rules for list[int]
   global
     [inOccRule]  nvocc(F) 		=> nil end
   end

   rules for Fsymbol
   global  
     [] head(F) => F end
   end

   rules for int 
   global  
     [] arity(F) => N end
   end

}


FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
	AND N:=()second(SS) ANDIF N != 0 :{
  rules for term
   t_1,...,t_N : term;
	  s	: term;
	  l	: list[int];
  global
  { [] F(t_1,...,t_N)[s] at I.l => F(t_1,...,t_(I-1),t_I[s] at l,t_(I+1),...,t_N)
    end
  }_I=1...N
  end
}


strategies for list[int]
implicit
 [.] chooseOccurence => dk(topOccRule, inOccRule)	end
end


end

