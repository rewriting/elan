module propositional[Fss]
import 	
	definitions[Fss]  cmp[Seq]
;end

//-------------------------------------------------------------------------
//-------------------------------------------------------------------------
//AND-rules 
//-----------------------------------------------------------------------------
rules for Seq
	P, Q, R : Pred;
	H : Pred;
	S1,  S2 : Seq;
global
  [] H |- ^(P && Q) |=> R 	=>  S1 :: S2
			where S1 := () H |- ^Q |=> R
			where S2 := () H |- ^P |=> R		end
  [] H |- ^(P && Q) 		=>  H |- P |=> ^Q		end
  [] H |-  (P && Q) |=> R 	=>  H |- P |=> (Q |=> R) 		end
  [] H |-  (P && Q)		=>  S1 :: S2
			where S1 := () H |- Q	
			where S2 := () H |- P			end
end

//-------------------------------------------------------------------------
//OR-rules
//-----------------------------------------------------------------------------
rules for Seq
	P, Q, R : Pred;
	H : Pred;
	S1,  S2 : Seq;
global
  [] H |- ^(P or Q) |=> R 	=>  H |- ^P |=> (^Q |=> R) 		end
  [] H |- ^(P or Q) 		=>  S1 :: S2
			where S1 := () H |- ^Q
			where S2 := () H |- ^P			end
  [] H |-  (P or Q) |=> R 	=>  S1 :: S2
			where S1 := () H |- Q |=> R
			where S2 := () H |- P |=> R		end
  [] H |-  (P or Q) 		=>  H |- ^P |=> Q			end
end

//-----------------------------------------------------------------------------
//EQV-rules
//-----------------------------------------------------------------------------
rules for Seq
	P, Q, R : Pred;
	H : Pred;
	S1,  S2 : Seq;
global
  [] H |- ^(P <=> Q) |=> R 	=> S1 :: S2
			where S1 := () H |- P |=> (^Q |=> R)
			where S2 := () H |- ^P |=> (Q |=> R)		end
  [] H |- ^(P <=> Q) 	=> S1 :: S2
			where S1 := () H |- P |=> ^Q 
			where S2 := () H |- ^Q |=> P			end
  [] H |-  (P <=> Q) |=> R 	=> S1 :: S2
			where S1 := () H |- P |=> (Q |=> R)
			where S2 := () H |- ^P |=> (^Q |=> R)		end
  [] H |-  (P <=> Q) 	=> S1 :: S2
			where S1 := () H |- P |=> Q
			where S2 := () H |- Q |=> P			end
end

//-----------------------------------------------------------------------------
//NOT-rules
//-----------------------------------------------------------------------------
rules for Seq
	P, R : Pred;
	H : Pred;
global
  [] H |-  ^^P |=> R	=> H |- P |=> R			end
  [] H |-  ^^P 		=> H |- P			end
end

//-----------------------------------------------------------------------------
//AXM-axioms
//-----------------------------------------------------------------------------
rules for Seq
	P, Q : Pred;
	H : Pred;
global
  [] H && ^P |- P |=> Q  	=> $			end
  [] H && P  |- ^P |=> Q  	=> $			end
  [] H && P  |- P		=> $			end

/******************** not compiled ****************************************************
  [] H && P && ^P |- Q		=> $		end
**************************************************************************************/
end
//-----------------------------------------------------------------------------
//Enhancements
//-----------------------------------------------------------------------------
//IMP5
rules for Seq
	P,Q : Pred;
	H : Pred;
global
  [] H && P |-  (P |=> Q) 	=>  H && P |- Q				end
end 

//-----------------------------------------------------------------------------
//AXM-aux
//-----------------------------------------------------------------------------
rules for Seq
	P, Q, R : Pred;
	H : Pred;
global
  [] H && R |- P |=> R  		=> $		end
  [] H && ^Q  |- P |=> (Q |=> R)  	=> $		end
  [] H && Q  |- P |=> (^Q |=> R)  	=> $		end
  [] H |- P	|=> P			=> $		end
  [] H |- P && R |=> R		=> $		end
end

//-----------------------------------------------------------------------------
//IMP-rules
//-----------------------------------------------------------------------------
rules for Seq
	Pp : Prop;
	P, Q, R : Pred;
	H : Pred;
	S1,  S2 : Seq;
global
  [] H |- ^(P |=> Q) |=> R 	=>  H |- P |=> (^Q |=> R) 		end
  [] H |- ^(P |=> Q) 	=>  S1 :: S2
			where S1 := ()  H |- ^Q  
			where S2 := () 	H |- P			end
  [] H |-  (P |=> Q) |=> R 	=>  S1 :: S2
			where S1 := () H |- Q |=> R
			where S2 := () H |- ^P |=> R		end 
  [] H |-  (Pp |=> Q) 	=>  H && Pp |- Q			end
  [] H |-  (^Pp |=> Q) 	=>  H && ^Pp |- Q			end
end

//-----------------------------------------------------------------------------
//AND-aux
//-----------------------------------------------------------------------------
/******************** not compiled *************************************************
rules for Seq
	P, R : Pred;
	a, b : Pred;
	H : Pred;
global
  [] H |- P && a && (a |=>  b) |=> R  	=>  H |- P && a && b |=> R 	end
end
**************************************************************************************/
//-----------------------------------------------------------------------------
//TRUE-rules 
//-----------------------------------------------------------------------------
rules for Seq
	R : Pred;
	H : Pred;
global
  [] H |- ^TRUE |=> R 	=> $				end
  [] H |- ^TRUE  		=> H |- FALSE 			end
  [] H |-  TRUE |=> R 	=> H |- R 			end
  [] H |-  TRUE  		=> $				end
end

//-----------------------------------------------------------------------------
//FALSE-rules
//-----------------------------------------------------------------------------
rules for Seq
	R : Pred;
	H : Pred;
global
  [] H |- ^FALSE |=> R 	=> H |- R			end
  [] H |- ^FALSE  		=> $				end
  [] H |-  FALSE |=> R 	=> $ 				end
end

//-----------------------------------------------------------------------------
//STOP-rules
//-----------------------------------------------------------------------------
rules for Seq
	P : Pred;
	Pp : Prop;
	H : Pred;
global
  [] H |- Pp 	=> H |- ^Pp |=> FALSE
				if neq_Prop(Pp,FALSE)		end
  [] H |- ^Pp 	=> H |- ^^Pp |=> FALSE
				if neq_Prop(Pp,FALSE)		end
end


//-----------------------------------------------------------------------------
//BUILT-IN
//-----------------------------------------------------------------------------
//Built-in
rules for Seq
	S : Seq;
	P, Q, R : Pred;
global
	[] $ :: S 		=> S					end
end 

end
