                                            where cz:=()zn(sz1)  
                                            end

    [] next_sz(zz,lb,s1,s2,s3,s4,false,false,true,true) => (ss,tt,uu,vv)/cz
                                            where sz:=()trans.lb(s3/zz)
                                            where cz1:=()zn(sz)
                                            where sz1:=()trans.lb(s4/cz1)
                                            where ss:=()s1
