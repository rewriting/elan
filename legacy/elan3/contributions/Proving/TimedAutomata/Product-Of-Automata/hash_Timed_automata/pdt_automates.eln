                                            end

    [] next_sz(zz,lb,s1,s2,s3,s4,true,true,false,false) => (ss,tt,uu,vv)/cz
                                            where sz:=()trans.lb(s1/zz)
                                            where cz1:=()zn(sz)
                                            where sz1:=()trans.lb(s2/cz1)
                                            where ss:=()st(sz)
                                            where tt:=()st(sz1)
                                            where uu:=()s3
                                            where vv:=()s4
                                            where cz:=()zn(sz1)
                                            end

    [] next_sz(zz,lb,s1,s2,s3,s4,true,false,true,false) => (ss,tt,uu,vv)/cz
                                            where sz:=()trans.lb(s1/zz)
                                            where cz1:=()zn(sz)
                                            where sz1:=()trans.lb(s3/cz1)
                                            where ss:=()st(sz)
