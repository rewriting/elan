end

//---  STRATÉGIES  ---//

strategies for label
 implicit
  []  trytrans  =>  dk(trylabel)  end
  []  try_lbl   =>  first one(trylbl) end
end

strategies for statezone
 implicit
  []  lst_tranz => time ; dk(trans_pdt)  end
  []  tranz  =>  trans_pdt ; time  end

  []  dt_pdt  => dk(
      FOR EACH label : identifier SUCH THAT label:=(listExtract)elem(S):
      { dt_pdt_aux_label, } fail)  end

  FOR EACH label : identifier SUCH THAT label:=(listExtract)elem(S):
  { [] dt_pdt_aux_label => dk(DT_pdt_label) end }
end

strategies for pair[list[statezone],bool]
 implicit
  [] explore => repeat*(first one(dk(trans1),dk(trans2),dk(trans3),trans4)) end
end

end