  esac
done

ac_given_srcdir=.
ac_given_INSTALL="/usr/bin/install -c"

trap 'rm -fr           Makefile           config/Makefile           runtime/Makefile           runtime/SmilesGasEl/Makefile           runtime/SmilesGasEl/algo/Makefile           runtime/SmilesGasEl/algo/huxu/Makefile           runtime/SmilesGasEl/algo/usmiles/Makefile           runtime/SmilesGasEl/parser/Makefile           runtime/SmilesGasEl/datatypes/Makefile           earley/Makefile 	  src/Makefile 	  src/rem/Makefile 	  src/rem/compiler/Makefile 	  src/rem/exception/Makefile 	  src/rem/parser/Makefile 	  doc/Makefile 	  scripts/Makefile  conftest*; exit 1' 1 2 15

