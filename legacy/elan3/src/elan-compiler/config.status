  -recheck | --recheck | --rechec | --reche | --rech | --rec | --re | --r)
    echo "running ${CONFIG_SHELL-/bin/sh} ./configure  --prefix=/local/protheo/pot/ELAN/elan3/mandrake-2.2.18 --no-create --no-recursion"
