module ivars[btypes]
import global 	sigSyntax types[btypes] list[vardef];
end
sort vardef;
end
operators
  global
    @':'@	: (identifier type) vardef;
    //--------------------------------------------------//
    ';'		: list[vardef] alias nil:;		// end of list
    @ @		: (vardef list[vardef]) list[vardef] alias cons(@,@):;
    variabla(@)	: (vardef) identifier;
    type(@)	: (vardef) type;
end

rules for identifier
 	$a:identifier;
		$t:type;
global
  [] variabla($a : $t)	=> $a		end
end

rules for type
 	$a	: identifier;
		$t	: type;
global
  [] type($a : $t)	=> $t			end
end

end













