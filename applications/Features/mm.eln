//////////// --norm1 --los --lis
module mm

import 	global 	int;
	local 	bool eq[lterm];
end
sort lterm;
end
operators global
  	@		: (int) lterm;
	(@ @)		: (lterm lterm) lterm;
	la @		: (lterm) lterm;
   local
	repl(@,@,@)	: (int lterm lterm) lterm;
	free(@,@)	: (int lterm) bool;
end

rules for bool
 v, w	: int;
 M, N, Q	: lterm;
local
  []	free(v,v) => true				end
  []	free(v,(M N)) => free(v,M) or free(v,N)		end
  []	free(v,la M) => free(v+1,M)			end
  []	free(v,M) => false				end
end

rules for lterm
 v, w	: int;
 M, N, Q	: lterm;
 M1, N1, Q1	: lterm;
local
  []	repl(v,v,M) => M				end
  []	repl(v,w,M) => w				end
  []	repl(v,(M N),Q) => (repl(v,M,Q) repl(v,N,Q))	end
  []	repl(v,la N,M) => la repl(v+1,N,M)		end

  [beta](la M N) => repl(1,M,N)				end
  [eta]	(la M 1) => M if not free(1,M)			end

  [NORM_RULE_1]  (M N) => (M1 N) where M1:=(nstrat)M	end
  [NORM_RULE_1]  (M N) => (M N1) where N1:=(nstrat)N	end
  [NORM_RULE_2]  la M =>  la M1 where M1:=(nstrat)M	end
  [NORM_RULE_3]  M => M1 where M1:=(norm_strat)M 	end
end

strategies  for lterm
local
[norm_strat]
  dc(beta,eta)
  end
end

strategies for lterm
global 
  [nstrat]
  dc(
//	dc(NORM_RULE_1) , dc(NORM_RULE_2) , dc(NORM_RULE_3)  
	dc(NORM_RULE_3) , dc(NORM_RULE_2) , dc(NORM_RULE_1)
  )
  end
end

strategies for lterm
global 
  [ss]
//  nstrat
  repeat* (nstrat)
//    normalise(dc(beta,eta))
  end
end
