module norm

sort S T U V;
end
operators global
  a		: S;
  s(@)		: (S) S;
  f(@,@)	: (S T) T;     //
  g(@)		: (T) T;       //
  h(@,@)	: (U V) T;    //2x ???
  u		: U;
  k(@,@)	: (T V) U;  // 2x
  v		: V;
  l(@)		: (T) V;     //
  t		: T;
  tt		: T;
  m(@)		: (T) T;     ///
  n(@,@)	: (T T) T;   // 2x
end
// t end
// n(t,tt) end 
// n(n(t,tt),n(tt,t)) end
// g(m(n(t,t))) end
// h(k(g(m(n(t,t))),v),v) end 		
// g(g(h(k(g(m(n(t,t))),v),v))) end
// f( s(s(a)), g(g(h(k(g(m(n(t,t))),v),l(n(n(t,tt),n(tt,t))))))) end
// f( s(s(a)), g(g(h(k(g(m(n(t,t))),v),l(n(n(t,tt),n(tt,t))))))) end

stratop
  global
    ss		: <T>		builtin;
end

rules for T
x : T;
global
  [CLIP]  t => tt		end
  [CLOP]  g(x) => x		end
end

strategies for T
implicit
  [.] ss =>
// id
//  normalise(dc(CLIP))
  normalise(dc(CLIP , CLOP))
  end
end

end
