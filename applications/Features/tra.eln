module tra

import global bool eq[Foo]; end

sort Foo; end

operators global
  a	: Foo;
  b	: Foo;
  c	: Foo;
  d	: Foo;
  f(@)	: (Foo) Foo;
end

stratop global
  ALLSOL	: <Foo> builtin;
end

rules for Foo
x, y, z, u, uu	: Foo;
global
  [all]	f(x) => a
		if true
		where z:=()x
		choose
		  try where u:=()a where y:=()b if true if x == a
		  try where y:=()x if x == b
		  try where y:=()c if x == c
/*
		  try
			choose
			  try if true where u:=()x  where y:=()x
			  try if false  where y:=()x
			end
*/
		end
		where uu:=()d
		if x == a or x == c
  end 
end 

strategies for Foo
implicit
  [.] ALLSOL => dk(all) end
end

end





