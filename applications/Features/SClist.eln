module SClist[X]
import
local 
	int
	bool
	occur[X,list[X]];
end
sort X list[X];
end
operators global

    nil_X	: list[X];
    cons(@,@)	: ( X list[X] ) list[X];

    tail(@)	: (list[X])	list[X];

    empty(@)	: (list[X])	bool;

   // alias version of the previous operators
    nil		: list[X]			alias nil_X:;
    @ @		: ( X list[X] ) list[X]		alias cons(@,@):;
    @ , @	: ( X list[X] ) list[X]		alias cons(@,@):;
    @ . @	: ( X list[X] ) list[X]		alias cons(@,@):;

    append(@,@)	: ( list[X] list[X] ) list[X];
    @ '@' @	: ( list[X] list[X] ) list[X]	alias append(@,@):;

    elem(@)	: ( list[X] ) X;		// with listExtract str.

    @-th elem(@): ( int list[X] ) X;		/* n-th element of list */

    size(@)	: ( list[X] ) int;
    size_of_X_list(@) : ( list[X] ) int		alias size(@):;

    ccat(@*@)	: ( int list[X] ) list[X];	// concat n-times  
    ccat(@,@)	: ( int list[X] ) list[X]	alias ccat(@*@):;

    /* new functions */

    /* Clean of a list to avoid duplication of variables */
    simple_list(@)		: (list[X]) list[X];

   /* Append two lists and avoid duplication of variables */
   simple_append(@,@)	: (list[X] list[X]) list[X];
   @ '@''@' @		: (list[X] list[X]) list[X] assocLeft alias append(@,@):;

   /* We define this new operator + which is an associative-left */
   /* version of append */
   @ + @	: ( list[X] list[X] ) list[X]	assocLeft alias append(@,@):;

   /* moinslist give the first list minus all the elements present in the second list */
   moinslist(@,@)	: (list[X] list[X]) list[X];

   /* app tests id an element is in a list */
   app(@,@)		: (X list[X])	bool;
end


stratop global
    listExtract	: <X>	builtin;
end


rules for list[X]
	e 	: X;
	l,l1,l2	: list[X];
global
  [] 		append(nil,l)		=> l			end
  [] 		append(e.l1 , l2)	=> e . append(l1,l2)	end
end


rules for X
 e,ee : X;
 l    : list[X];
 n, n1: int;
global
  [] 		1-th elem(e.l)	=> e					end
  [] 		n-th elem(e.l)	=> n1-th elem(l)  where n1:=()n-1	end
local
  [extractrule1] elem(e.l)	=> e					end
  [extractrule2] elem(e.l)	=> elem(l)				end
end

rules for list[X]
 n : int;
 l : list[X];
global
  [] 		ccat(0,l)	=> nil				end
  [] 		ccat(n,l)	=> l @ ccat(n-1,l) if n>0	end
end

rules for int
e : X;
l : list[X];
global
  [] 		size(nil)	=> 0				end
  [] 		size(e.l)	=> 1+size(l)			end
end

rules for bool
	l : list[X];
global
	[] empty(l)	=> eq_int(size(l),0)
	end
end

rules for list[X]
	e : X;
	l : list[X];
global
	[] tail(nil)	=> nil
	end

	[] tail(e.l)	=> l
	end

end


/* simple_list */

rules for list[X]
	l,R: list[X];
	e: X;
global
	[] simple_list(nil) => nil
	end
	
	[] simple_list(e.l) => R
	   choose
	   try if occurs(e,l) where R:=() simple_list(l)
	   try where R:=() e.simple_list(l)
	   end
	end
end


/* simple_append */

rules for list[X]
	l, ll, lll, llll, R: list[X];
	e 		: X;
	b, c,b1,b2	: bool;
global
	[] simple_append(nil,nil) => nil
	end

	[] simple_append(nil,l) => 	simple_list(l)
	end

	[] simple_append(l,nil) => 	simple_list(l)
	end

	[] simple_append(e.l,ll) => R
	 	where lll	:= ()simple_list(l)
		where llll 	:= ()simple_list(ll)
		where b1   	:= ()occurs(e,l) 
		where b2 	:= ()occurs(e,ll)
		where b 	:= ()b1 or b2
		choose
		try if b where R:=() simple_append(lll,llll) 
		try where R:=() e.simple_append(lll,llll) 
		end
	end

end


/* app */

rules for bool
	e, e1	: X;
	l 	: list[X];
global
	[] app(e,nil)	=> false
	end

	[] app(e,e.l)	=> true
	end

	[] app(e,e1.l)	=> app(e,l)
	end
end


/* moinslist */

rules for list[X]
	l1, l2,R	: list[X];
	e	: X;
global
	[] moinslist(l1,nil)	=>
		l1
	end

	[] moinslist(nil,l2)	=>
		nil
	end

	[] moinslist(e.l1,l2)	=> R
		choose
		try if app(e,l2) where R:=() moinslist(l1,l2)
		try where R:=() e.moinslist(l1,l2)
		end
	end

end


strategies for X
implicit
  []	listExtract => iterate*( dc(extractrule2) ) ; dc(extractrule1) end
//global
//   [listExtract]  iterate*( dc(extractrule2) ) ; dc(extractrule1) end
end

end
	
