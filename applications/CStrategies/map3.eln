module map3[X]

import global 
  strat[X] strat[list[X]]
  X          list[X];
end
operators global
  map(@) 	: (<X>) <list[X]>;
  start @ 	: (integ) <list[X]>;
end

rules for X
 x	: X; 
    	n	: integ;
global
  [ass(n)] x => n 		end
  [add(n)] x => x+n 		end
  [sub(n)] x => x-n 		end
end

strategies for list[X]
 s : <X>;
	h, h1 : X;		
	t, t1 : list[X];	
	n : integ;
defined
  [start n] map(dk(ass(n),dk(add(n),sub(n))))	end
  [map(s)] nil => nil				end
  [map(s)] h.t => h1.t1 
			where t1:=[map(s)]t		
			where h1:=[s]h 
  end
end

end



