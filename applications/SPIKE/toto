  rules for clause
  global
	[] RulesW	=>
  //the rewrite rules that will be used (non-empty RHS)
  FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
		NP:list[pair[term,term]];  PP:list[pair[term,term]]; F:ident
  SUCH THAT SSS:=(listExtract) elem(Axs)
	AND NP:=()first(SSS) 
	AND PP:=()second(SSS)
	ANDIF neq_list[pair[term,term]](PP,nil)
	AND F:=()head(first(1-th elem(PP)))
	:{
	F : ( replaceVars(
	[
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(NP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT,
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(PP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT]))*
	}
  //the rewrite rules that will be used (empty RHS)
  FOR EACH SSS:pair[list[pair[term,term]],list[pair[term,term]]]; 
		NP:list[pair[term,term]];  PP:list[pair[term,term]]
  SUCH THAT SSS:=(listExtract) elem(Axs)
	AND NP:=()first(SSS) 
	AND PP:=()second(SSS)
	ANDIF eq_list[pair[term,term]](PP,nil)
	:{
	NRWR : ( replaceVars(
	[
  	FOR EACH SS:pair[term,term]; 
		Lt:term; Rt:term
  	SUCH THAT SS:=(listExtract) elem(NP)
		AND Lt:=()first(SS) 
		AND Rt:=()second(SS):{
			Lt = Rt : 
   	}
	EmptyT,
	EmptyT]))*
	}
	EmptyC
	//end rewrite rules part

	end
  end

