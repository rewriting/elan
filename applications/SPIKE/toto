  rules for ipf
  global
//------------------------------------- for each symbol ------- pos_zero -------------
FOR EACH SS:pair[ident,pair[int,int]]; F:ident
SUCH THAT SS:=(listExtract) elem(Ars) 
  AND F:=()first(SS) :{
	[] pos_zero(F)	=> unicate(
    //--------------------------------- for each Sf -----------
    FOR EACH S:term; LV:list[variable]
    SUCH THAT S:=(listExtract) elem(funSf(F))
	AND LV:=()var_lin(S):{
    	//--------------------------------- for each Strict Position -----------
    	FOR EACH SPos:list[int]
    	SUCH THAT SPos:=(chooseOccurence) nvocc(S)
		ANDIF neq_list[int](SPos,nil):{
			SPos.
		}
    	//--------------------------------- for each Non-linear Position -----------
    	FOR EACH NLVPos:list[int]
    	SUCH THAT NLVPos:=(NLVchooseOccurence) nlvocc(S,LV)
		ANDIF neq_list[int](NLVPos,nil):{
			NLVPos.
	}
    }
			nil)
	end
}

  end

