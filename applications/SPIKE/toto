	Lpi, LpiN : list[indp];	
global
  	[] indVars({t_I }_I=1...AL F {t_I }_I=NEXT...N, $f:nil . Lpi, LpiN)	=> 
			nil
			{ @ indVariables(t_I, LpiN)}_I=1...N
		if eq_ident(F,$f)
	end

  	[] indVars({t_I }_I=1...AL F {t_I }_I=NEXT...N, $f:u.l . Lpi, LpiN)	=> 
		  [$d,v] . indVars({t_I }_I=1...AL F {t_I }_I=NEXT...N, $f:l . Lpi, LpiN)
		if eq_ident(F,$f)
		where s:=()({t_I }_I=1...AL F {t_I }_I=NEXT...N) at u
		if isvar(s)
		where v:=()term_to_variable(s)
		where t:=()({t_I }_I=1...AL F {t_I }_I=NEXT...N) at firstList(u)
		where d:=() dom-lastElem(u)(head(t))
	end

  	[] indVars({t_I }_I=1...AL F {t_I }_I=NEXT...N, $f:u.l . Lpi, LpiN)	=> 
		   indVars({t_I }_I=1...AL F {t_I }_I=NEXT...N, $f:l . Lpi, LpiN)
		if eq_ident(F,$f)
		where s:=()({t_I }_I=1...AL F {t_I }_I=NEXT...N) at u
		if not isvar(s)
	end

  	[] indVars({t_I }_I=1...AL F {t_I }_I=NEXT...N, $f:l . Lpi, LpiN)	=> 
			indVars({t_I }_I=1...AL F {t_I }_I=NEXT...N, Lpi, LpiN)
		if not eq_ident(F,$f)
	end
  end	

