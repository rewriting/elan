//--------------------------------------------------------------------------------------
// specify substitution applicable on sort X -> very similar to the module from lib
//--------------------------------------------------------------------------------------
module applySubstOn[Vars,Ars,X]

import global
	termCommons[Vars,Ars]
	replace[term,X]
;end

sort X;
end

operators
  global
    @(@)	: ( substitution X ) X;
    apply(@,@)	: ( substitution X ) X		alias @(@):;
end

rules for X
	$tt	: X;
	$s1,$s2	: substitution;
	$v 	: variable;
	$t	: term; 
global
  [] apply(identity,$tt)	=> $tt				end
  [] apply($s1 o $s2 ,$tt) 	=> apply($s2,apply($s1,$tt))	end
  [] apply($v->$t,$tt) 		=> replace($v,$t,$tt)		end
end

end
