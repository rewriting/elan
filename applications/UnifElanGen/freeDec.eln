module freeDec[Fss]
import 	global 	term termUnif[Fss] unification0 ;

 	local  	Fss anyIdentifier int bool pair[identifier,int]
		list[pair[identifier,int]] eq[variable] eq[term]
		eqSystem occur[variable,term] occur[variable,eqSystem];
end



FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
	AND N:=()second(SS) ANDIF N> 0 :{
   rules for eqSystem
   // declare 
          P:eqSystem; s_1,...,s_N:term; t_1,...,t_N:term;
   global
     [decompose] P & F(s_1,...,s_N) = F(t_1,...,t_N) => P { & s_I=t_I }_I=1...N  end
   end
  }


strategies for eqSystem
global 
  [unify0]
  dont care choose(trueadd) ;
  repeat*(
    dont care choose(
      	unfold || delete || decompose || conflict || coalesce || occCheck1 ||
        occCheck2 || eliminate1 || eliminate2
    )
  ) ;
  dont care choose(trueelim || truepropag || falsepropag) ;

// CR modif (10/09/96) 

  dont care choose(foldrule)
  end

end


end