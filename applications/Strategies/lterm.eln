module lterm

import 	global int bool strat[lterm];
end
sort lterm;
end
operators global
  	@		: (int) lterm;
	(@ @)		: (lterm lterm) lterm;
	la @		: (lterm) lterm;
  local
	repl(@,@,@)	: (int lterm lterm) lterm;
	free(@,@)	: (int lterm) bool;
end

stratop
	global
  	lis(@)  	: (<lterm>) <lterm>;
  	los(@)  	: (<lterm>) <lterm>;
end

rules for bool
v	: int;
M, N	: lterm;
global
  []	free(v,v) => true				end
  []	free(v,(M N)) => free(v,M) or free(v,N)		end
  []	free(v,la M) => free(v+1,M)			end
  []	free(v,M) => false				end
end

rules for lterm
v, w	: int;
M, N, Q	: lterm;
global
  []	repl(v,v,M) => M				end
  []	repl(v,w,M) => w				end
  []	repl(v,(M N),Q) => (repl(v,M,Q) repl(v,N,Q))	end
  []	repl(v,la N,M) => la repl(v+1,N,M)		end
  [beta](la M N) => repl(1,M,N)				end
  [eta]	(la M 1) => M if not free(1,M)			end
end

strategies for lterm
s	: <lterm>;
implicit
  [.] lis(s) => dc((lis(s) id),(id lis(s)), la lis(s), s )	end
  [.] los(s) => dc(s, (los(s) id),(id los(s)), la los(s) )	end
end

end






