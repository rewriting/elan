module tc_list[X,Y]

import global int list[X] tcstrat[list[X],Y] 
	symbol[3,X,list[X],Y,Y]	// pour tc_list
	symbol[2,Y,X,Y] 	// pour foldl
	symbol[2,X,Y,Y]		// pour foldr
	;

op global //           (X list[X] Y) --> Y
  tc_list(@,@)  : (Y Symbol[X,list[X],Y,Y]) <list[X] -> Y>;
  foldl(@,@)	: ( Y Symbol[Y,X,Y] ) <list[X]->Y>;
  foldr(@,@)	: ( Y Symbol[X,Y,Y] ) <list[X]->Y>;
//  exists(@)	: ( Symbol[X,bool]) <list[X] -> bool>; 
  exists(@,@)	: ( Symbol[X,bool] list[X]) bool; 
end

strategies for <list[X] -> Y>

	fnil	: Y;
	fcons	: Symbol[X,list[X],Y,Y];
	a	: X;
	b	: Y;
	r	: list[X];
bodies
  []  [tc_list(fnil,fcons)]  nil => fnil				end
  []  [tc_list(fnil,fcons)] a.r => fcons(a,r,b)
			where b:=[tc_list(fnil,fcons)]r    		end
end

strategies for <list[X] -> Y>
	fl	: Symbol[Y,X,Y];
	fr	: Symbol[X,Y,Y];
	a	: X;
	b, y	: Y;
	r 	: list[X];
bodies
  []	[foldl(b,fl)] nil => b					end
  []	[foldl(b,fl)] a.r => y where y:=[foldl(fl(b,a),fl)]r	end

  []	[foldr(b,fr)] nil => b					end
  []	[foldr(b,fr)] a.r => fr(a,y) 
				where y:=[foldr(b,fr)] r 	end
end

end
