// (la 1.(1 1) la 1.(1 1))
// (la (1 1) la (1 1))

/*
zero = la la 1
add  = la la la (2 ((3 2) 1))
one  = (  la la la (2 ((3 2) 1))  la la 1   ) = la la (2 1)
two  = (  la la la (2 ((3 2) 1))  la la (2 1)  ) = la la (2 (2 1))
three= (  la la la (2 ((3 2) 1))  la la (2 (2 1)) ) = la la (2 (2 (2 1)))
*/

end
