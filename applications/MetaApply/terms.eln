module terms[vars,fss,prec]

/* Module containing operations concerning terms and equation 
   that are useful for the program */


/* vars : variables, 
   fss  : operators,
   prec : precedence */


import
	global
		list[term]
		termCommons[fss,vars] /* to define the sort term so variable*/
		int
		bool
	;	
        local 
		fss
		prec
		vars
		identifier
		pair[identifier,int]
		list[pair[identifier,int]]
		renaming[vars,fss,prec]
		eq[term]
	;
end


operators
  global
	/* List of strict subterms at level one of a term */
	list_subterms_strict(@)	: (term) list[term];

	/* List of all strict subterms of a term */
	list_allsubtermsstrict(@): (term) list[term];

	/* List of all subterms at all level of a term */	
	list_allsubterms(@)	: (term) list[term];

	/* Test if a term is in a list of terms */
	is_inlist_terms(@,@)		: (term list[term]) bool;

	/* Test if a term is a subterm (or a strict subterm) of another */
	/* term. is_subterm(t, f(...,g( ...t...),....)) => true */
	is_subterm(@,@)	: (term term) bool;
	is_subterm_strict(@,@)	: (term term) bool;

	/* Test if a term is a subterm of a term of a list of term */
	/* is_subterm(t, .... . f(...,t,...) .... ) => true */
	is_subterm(@,@)		: (term list[term]) bool;
	is_subterm_strict(@,@)	: (term list[term]) bool;

	/* Test if a list of terms is included in another list of terms */
	/* or is a subterm of a term of the list */
	/* This function will be used to test the reduced relative condition */
	include_subterms(@,@)	: (list[term] list[term]) bool;

	/* alpha-conversion of terms */
	eqterms(@,@)		: (term term)	bool;

end


/* list_subterms_strict (level 1) */

rules for list[term]
X : variable;
global 
	[] list_subterms_strict(X) => nil
	end
end


FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(fss) AND F:=()first(SS) 
AND N:=()second(SS) :{
  rules for list[term]
  t_1,...,t_N: term;
  global	
      [] list_subterms_strict(F(t_1,...,t_N)) => {t_I .}_I=1...N nil
      end
  end
}


/* list_allsubtermsstrict */

rules for list[term]
X : variable;
global 
	[] list_allsubtermsstrict(X) => nil
	end
end


FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(fss) AND F:=()first(SS) 
AND N:=()second(SS) :{
  rules for list[term]
  t_1,...,t_N: term;
  global	
      [] list_allsubtermsstrict(F(t_1,...,t_N)) => 
		{list_allsubtermsstrict(t_I) +}_I=1...N nil
      end
  end
}


/* list_allsubterms */

rules for list[term]
X : variable;
global 
	[] list_allsubterms(X) => nil
	end
end


FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(fss) AND F:=()first(SS) 
AND N:=()second(SS) :{
  rules for list[term]
  t_1,...,t_N: term;
  ll : list[term];
  global	
      [] list_allsubterms(F(t_1,...,t_N)) => F(t_1,...,t_N).ll
		where ll := (){list_allsubterms(t_I) +}_I=1...N nil
      end
  end
}


/* is_inlist_terms */

rules for bool
	e, e1, enorm, e1norm : term;
	l : list[term];
	b : bool;
global
	[] is_inlist_terms(e,nil)	=> false
	end

	[] is_inlist_terms(e,e1.l)	=> true
					if eqterms(e,e1)
	end

	[] is_inlist_terms(e,e1.l)	=> is_inlist_terms(e,l)
	end
end


/* is_subterm */
/* t1 is a subterm of t2 */

rules for bool
	t1, t2 : term;
	lsubt2 : list[term];
global

	[] is_subterm(t1,t1)		=> true
	end

	[] is_subterm(t1,t2)		=> is_inlist_terms(t1,lsubt2)
					where lsubt2 := ()list_allsubterms(t2)
	end
end


/* is_subterm_strict */
/* t1 is a strict subterm of t2 */

rules for bool
	t1, t2 : term;
	lsubt2 : list[term];
global
	[] is_subterm_strict(t1,t1)	=> false
	end

	[] is_subterm_strict(t1,t2)	=> is_inlist_terms(t1,lsubt2)
					where lsubt2 := 
					()list_allsubtermsstrict(t2)
	end
end


/* is_subterm */
/* t1 is a subterm of an element of the list given as argument */

rules for bool
	t1, t2 	: term;
	lt 	: list[term];
global
	[] is_subterm(t1,nil)		=> false
	end

	[] is_subterm(t1, t1.nil)	=> true
	end

	[] is_subterm(t1, t2.nil)	=> is_subterm(t1,t2)
	end

	[] is_subterm(t1,t2.lt)		=> 
					switch 
					case is_subterm(t1,t2) 
					then true
					otherwise is_subterm(t1,lt)
					end
	end
end


/* is_subterm_strict */
/* t1 is a subterm of an element of the list given as argument */

rules for bool
	t1, t2 	: term;
	lt 	: list[term];
global
	[] is_subterm_strict(t1,nil)	=> false
	end

	[] is_subterm_strict(t1, t1.nil)=> false
	end

	[] is_subterm_strict(t1, t2.nil)=> is_subterm_strict(t1,t2)
	end

	[] is_subterm_strict(t1,t2.lt)	=> 
					switch 
					case is_subterm_strict(t1,t2) 
					then true
					otherwise is_subterm_strict(t1,lt)
					end
	end
end


/* include_subterms */

rules for bool
	l1, l2 : list[term];
	b, b1, b2 : bool;
	e : term;
global
	[] include_subterms(nil,l2)	=> true
	end

	[] include_subterms(e.l1,l2)	=> 
					switch 
					case is_subterm(e,l2)
					then include_subterms(l1,l2)
					otherwise false
					end
	end
end


/* eqterms */

rules for bool
	t, t1	: term;
	x,y	: variable;	
global
	[] eqterms(t,t)		=> true
	end

	[] eqterms(t,t1)	=> eq_term(normalize(t),normalize(t1))
	end
end

end











