module myEqSystem[Vars,Ops,Types]
import 	global	msApplySubstOn[eqSystem,Vars,Ops,Types];
	local	bool int msTermCommons[Vars,Ops,Types];
end

sort eqSystem equation;
end

operators
global
  @ = @		: ( term term ) equation;

  @		: ( bool ) eqSystem;
  @ 		: ( equation ) eqSystem;
  @ & @		: ( eqSystem eqSystem ) eqSystem	(AC);
  (@ & @)	: ( eqSystem eqSystem ) eqSystem	alias @ & @:;

  system_to_subst(@)	: ( eqSystem ) substitution;
end

stratop
global
  delete_new_variables : <eqSystem> builtin;
end


rules for substitution
 P,Q,R:eqSystem; t:term; x:variable;
global
  [] system_to_subst(true) 	=> identity			end
  [] system_to_subst(x=t) 	=> x->t				end
  [] system_to_subst(P & Q) 	=> system_to_subst(P) o system_to_subst(Q)
  end
end

rules for eqSystem
 P,Q,R:eqSystem; n:int; t:term; e:equation;
global
  [new_var_elim] P & var(n) = t 	=> apply(var(n)->t,P)	end
end

strategies for eqSystem
implicit
  [.] delete_new_variables => repeat* ( dc one(new_var_elim) )
  end
end

end

