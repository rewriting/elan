module MinSplittingFullLookAhead[Variables,Type,Values]

import
global
	OptimizationRules[Variables,Type,Values]
	FullLookAhead[Variables,Type,Values]
	FullLookAheadChoicePoint[Variables,Type,Values]
	FullLookAheadChoicePointII[Variables,Type,Values]
	;
end

stratop
global
	MinSplittingFLAFirstToLast				: < csop -> csop >	bs;
	MinSplittingFLALastToFirst				: < csop -> csop >	bs;
	MinSplittingFLASplitFirstToLast				: < csop -> csop >	bs;
	MinSplittingFLASplitLastToFirst				: < csop -> csop >	bs;
