module ForwardCheckingChoicePointIIMaximumDegreeInECandDC[Variables,Type,Values]

import
global
	LocalConsistencyStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	PropagationRules[Variables,Type,Values]
	ChoicePointStrategies[Variables,Type,Values]
	;
end

stratop
global
	FCChoicePointIIMaximumDegreeInECandDCFirstToLastAll		: < csp -> csp >	bs;
	FCChoicePointIIMaximumDegreeInECandDCFirstToLastOne		: < csp -> csp >	bs;
	FCChoicePointIIMaximumDegreeInECandDCLastToFirstAll		: < csp -> csp >	bs;
	FCChoicePointIIMaximumDegreeInECandDCLastToFirstOne		: < csp -> csp >	bs;
	FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastAll	: < csp -> csp >	bs;
	FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne	: < csp -> csp >	bs;
	FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstAll	: < csp -> csp >	bs;
	FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne	: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: All 							*/

[] FCChoicePointIIMaximumDegreeInECandDCFirstToLastAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	first one (GetVarWithMaximumDegreeInECandDC);
	dk (iterate* (EliminateFirstValueOfDomain));
	first one (InstantiateFirstValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: First 						*/

[] FCChoicePointIIMaximumDegreeInECandDCFirstToLastOne =>
first one (FCChoicePointIIMaximumDegreeInECandDCFirstToLastAll)
end


/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: All 							*/

// Verify: Value elimination when there is no membership constraint does not work!!

[] FCChoicePointIIMaximumDegreeInECandDCLastToFirstAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	first one (GetVarWithMaximumDegreeInECandDC);
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: First 						*/

[] FCChoicePointIIMaximumDegreeInECandDCLastToFirstOne =>
first one (FCChoicePointIIMaximumDegreeInECandDCLastToFirstAll)
end



/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Split domain first to last				*/
/* Number of solutions	: All 							*/

[] FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	first one (GetVarWithMaximumDegreeInECandDC);
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Split domain first to last				*/
/* Number of solutions	: First							*/

[] FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne =>
first one (FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastAll)
end


/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Split domain last to first				*/
/* Number of solutions	: All 							*/

[] FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstAll =>
LocalConsistencyForEC;
repeat* (
	dk (PostElementaryDisjunct);
	LocalConsistencyForEC;
	first one (GetVarWithMaximumDegreeInECandDC);
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point and Enumeration	*/
/* Variable selection	: Maximum Degree					*/
/* Value selection	: Split domain last to first				*/
/* Number of solutions	: First							*/

[] FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne =>
first one (FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FCChoicePointIIMaximumDegreeInECandDCFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCFirstToLastOne)P
end

[FCChoicePointIIMaximumDegreeInECandDCLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCLastToFirstOne)P
end

[FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne)P
end

[FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne)P
end

[GetUBFCChoicePointIIMaximumDegreeInECandDCFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCChoicePointIIMaximumDegreeInECandDCLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end


[GetLBFCChoicePointIIMaximumDegreeInECandDCFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCChoicePointIIMaximumDegreeInECandDCLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointIIMaximumDegreeInECandDCSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
