module CooperationRulesII[Variables,Type,Values]

import
global
	CooperationStrategies[Variables,Type,Values]
	CooperationDefinitionII[Variables,Type,Values]
	OptimizationRules[Variables,Type,Values]
	ForwardCheckingChoicePointMinimumDomain[Variables,Type,Values]
	eq[csop]
 	;
end


rules for csopbisII

        x       					: var;
        lb, ub, lb1, ub1, lb2, ub2, newlb, newub  	: Type;
	pid, pid1					: Pid;
	laPid, liPid, newlaPid, newliPid		: list[Pid];
	lcsop, newlcsop					: list[csop];
        P1, P2    					: csop;
	string1, s1					: string;
	P, Q, R						: csp;
	PII, QII					: csopbisII;

global 

[CreateSolver1NoBlock]
	CSOPbisII[P1,lcsop,laPid,liPid]
	=>
	CSOPbisII[P1,lcsop,laPid,pid.liPid]
	where	pid := ()create_noblock("solver1CSOP")
	if 	not iserr(pid)
end

[CreateSolver2NoBlock]
	CSOPbisII[P1,lcsop,laPid,liPid]
	=>
	CSOPbisII[P1,lcsop,laPid,pid.liPid]
	where	pid := ()create_noblock("solver2CSOP")
	if 	not iserr(pid)
end

[CreateSolver1Block]
	CSOPbisII[P1,lcsop,laPid,liPid]
	=>
	CSOPbisII[P1,lcsop,laPid,pid.liPid]
	where	pid := ()create("solver1CSOP")
	if 	not iserr(pid)
end

[CreateSolver2Block]
	CSOPbisII[P1,lcsop,laPid,liPid]
	=>
	CSOPbisII[P1,lcsop,laPid,pid.liPid]
	where	pid := ()create("solver2CSOP")
	if 	not iserr(pid)
end

[SendToSolver]
	CSOPbisII[P1,lcsop,laPid,pid.liPid]
	=>
	CSOPbisII[P1,lcsop,pid.laPid,liPid]
	where	P2 	:= ()write(pid,P1)
	where	string1	:= ()write(pid,"\nend\n")
	if 	not iserror(P2) and not iserror(string1)
end

[GetOutputOfSolver]
	CSOPbisII[P1,lcsop,pid.laPid,liPid]
	=>
	CSOPbisII[P1,newlcsop,newlaPid,newliPid]
	where	P2 :=()read(pid)
	choose
	try
		if	not iserror (P2)
		if	P2 != no_more
		where	newlcsop := ()P2.lcsop
		where	newlaPid := ()pid.laPid
		where	newliPid := ()liPid
	try
		if	iserror (P2)
		if	P2 == no_more
		where	newlcsop := ()lcsop
		where	newlaPid := ()laPid
		where	newliPid := ()pid.liPid
	end
end

[UpdateBounds]
	CSOPbisII[CSOP[P,x,lb1,ub1],CSOP[Q,x,lb2,ub2].lcsop,laPid,liPid]
	=>
	CSOPbisII[CSOP[R,x,newlb,newub],lcsop,laPid,liPid]
	if	lb1 != ub1
	choose
	try
		if ub2 < ub1
		where	    R := ()Q
		where	newlb := ()lb1
		where	newub := ()ub2
	try
		if lb2 > lb1
		where	    R := ()Q
		where	newlb := ()lb2
		where	newub := ()ub1
	try
		where	    R := ()P
		where	newlb := ()lb1
		where	newub := ()ub1
	end
end

[GetMinimum]
	CSOPbisII[CSOP[P,x,lb,ub],lcsop,laPid,liPid]
	=>
	CSOPbisII[P2,lcsop,nil,append(laPid,liPid)]
	if	lb == ub
	if	size(laPid) > 0
	where	P1 := (first one (FCChoicePointMinimumDomainFirstToLastOne))CSOP[P,x,lb,ub]
	where	P2 := (first one (GetSolutionCSOP))P1
end

[CloseSolver]
	CSOPbisII[P1,lcsop,laPid,pid.liPid]
	=>
	CSOPbisII[P1,lcsop,laPid,liPid]
	where	pid1 := ()close(pid)
end

[ChangePriority]
	CSOPbisII[CSOP[P,x,lb,ub],lcsop,pid.laPid,liPid]
	=>
	CSOPbisII[CSOP[P,x,lb,ub],lcsop,append(laPid,pid.nil),liPid]
	if	lb != ub

end

end


end
