module ForwardCheckingChoicePoint[Variables,Type,Values]

import
global
	LocalConsistencyStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	PropagationRules[Variables,Type,Values]
	ChoicePointStrategies[Variables,Type,Values]
	;
end

stratop
global
	FCChoicePointFirstToLastAll      		: < csp -> csp >	bs;
	FCChoicePointFirstToLastOne      		: < csp -> csp >	bs;
	FCChoicePointLastToFirstAll      		: < csp -> csp >	bs;
	FCChoicePointLastToFirstOne      		: < csp -> csp >	bs;
	FCChoicePointSplitFirstToLastAll      		: < csp -> csp >	bs;
	FCChoicePointSplitFirstToLastOne      		: < csp -> csp >	bs;
	FCChoicePointSplitLastToFirstAll      		: < csp -> csp >	bs;
	FCChoicePointSplitLastToFirstOne      		: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: All 					*/

[] FCChoicePointFirstToLastAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	dk (iterate* (EliminateFirstValueOfDomain));
	first one (InstantiateFirstValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: First 				*/

[] FCChoicePointFirstToLastOne =>
first one (FCChoicePointFirstToLastAll)
end


/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: All 					*/

[] FCChoicePointLastToFirstAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: First 				*/

[] FCChoicePointLastToFirstOne =>
first one (FCChoicePointLastToFirstAll)
end


/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: All 					*/

[] FCChoicePointSplitFirstToLastAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: First					*/

[] FCChoicePointSplitFirstToLastOne =>
first one (FCChoicePointSplitFirstToLastAll)
end


/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: All 					*/

[] FCChoicePointSplitLastToFirstAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Choice Point	*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: First					*/

[] FCChoicePointSplitLastToFirstOne =>
first one (FCChoicePointSplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FCChoicePointFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointFirstToLastOne)P
end

[FCChoicePointLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointLastToFirstOne)P
end

[FCChoicePointSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointSplitFirstToLastOne)P
end

[FCChoicePointSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCChoicePointSplitLastToFirstOne)P
end

[GetUBFCChoicePointFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCChoicePointLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCChoicePointSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCChoicePointSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCChoicePointSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCChoicePointFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCChoicePointLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCChoicePointSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCChoicePointSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCChoicePointSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
