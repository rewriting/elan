module FullLookAheadChoicePointMinimumDomain[Variables,Type,Values]

import
global
	LocalConsistencyStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	;
end

stratop
global
	FLAChoicePointMinimumDomainFirstToLastAll  		: < csp -> csp >	bs;
	FLAChoicePointMinimumDomainFirstToLastOne  		: < csp -> csp >	bs;
	FLAChoicePointMinimumDomainLastToFirstAll  		: < csp -> csp >	bs;
	FLAChoicePointMinimumDomainLastToFirstOne  		: < csp -> csp >	bs;
	FLAChoicePointMinimumDomainSplitFirstToLastAll  	: < csp -> csp >	bs;
	FLAChoicePointMinimumDomainSplitFirstToLastOne  	: < csp -> csp >	bs;
	FLAChoicePointMinimumDomainSplitLastToFirstAll  	: < csp -> csp >	bs;
	FLAChoicePointMinimumDomainSplitLastToFirstOne  	: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: All					*/

[] FLAChoicePointMinimumDomainFirstToLastAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	first one (GetVarWithMinimumDomain);
	dk (iterate* (EliminateFirstValueOfDomain));
	first one (InstantiateFirstValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	LocalConsistencyForEC
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: First					*/

[] FLAChoicePointMinimumDomainFirstToLastOne =>
first one (FLAChoicePointMinimumDomainFirstToLastAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: All					*/

[] FLAChoicePointMinimumDomainLastToFirstAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	first one (GetVarWithMinimumDomain);
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	LocalConsistencyForEC
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: First					*/

[] FLAChoicePointMinimumDomainLastToFirstOne =>
first one (FLAChoicePointMinimumDomainLastToFirstAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: All 					*/

[] FLAChoicePointMinimumDomainSplitFirstToLastAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	first one (GetVarWithMinimumDomain);
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: First					*/

[] FLAChoicePointMinimumDomainSplitFirstToLastOne =>
first one (FLAChoicePointMinimumDomainSplitFirstToLastAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: All 					*/

[] FLAChoicePointMinimumDomainSplitLastToFirstAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	first one (GetVarWithMinimumDomain);
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Variable selection	: Minimum Domain			*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: First					*/

[] FLAChoicePointMinimumDomainSplitLastToFirstOne =>
first one (FLAChoicePointMinimumDomainSplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FLAChoicePointMinimumDomainFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointMinimumDomainFirstToLastOne)P
end

[FLAChoicePointMinimumDomainLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointMinimumDomainLastToFirstOne)P
end

[FLAChoicePointMinimumDomainSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointMinimumDomainSplitFirstToLastOne)P
end

[FLAChoicePointMinimumDomainSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointMinimumDomainSplitLastToFirstOne)P
end

[GetUBFLAChoicePointMinimumDomainFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointMinimumDomainFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointMinimumDomainLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointMinimumDomainLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointMinimumDomainSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointMinimumDomainSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointMinimumDomainSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointMinimumDomainSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointMinimumDomainFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointMinimumDomainFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointMinimumDomainLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointMinimumDomainLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointMinimumDomainSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointMinimumDomainSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointMinimumDomainSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointMinimumDomainSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
