module ForwardCheckingWithCD4[Variables,Type,Values]

import
global
	ConstructiveDisjunctionStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	PropagationRules[Variables,Type,Values]
	ChoicePointStrategies[Variables,Type,Values]
	;
end

stratop
global
	FCWithCD4FirstToLastAll			: < csp -> csp >	bs;
	FCWithCD4FirstToLastOne			: < csp -> csp >	bs;
	FCWithCD4LastToFirstAll			: < csp -> csp >	bs;
	FCWithCD4LastToFirstOne			: < csp -> csp >	bs;
	FCWithCD4SplitFirstToLastAll		: < csp -> csp >	bs;
	FCWithCD4SplitFirstToLastOne		: < csp -> csp >	bs;
	FCWithCD4SplitLastToFirstAll		: < csp -> csp >	bs;
	FCWithCD4SplitLastToFirstOne		: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: All 							*/

[] FCWithCD4FirstToLastAll =>
dk (LocalConsistencyForECandDCWithCD4);
repeat* (
	dk (iterate* (EliminateFirstValueOfDomain));
	first one (InstantiateFirstValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration first to last			*/
/* Number of solutions	: First 						*/

[] FCWithCD4FirstToLastOne =>
first one (FCWithCD4FirstToLastAll)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: All 							*/

[] FCWithCD4LastToFirstAll =>
dk (LocalConsistencyForECandDCWithCD4);
repeat* (
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	first one (LocalConsistencyInEC, id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Value enumeration last to first			*/
/* Number of solutions	: First 						*/

[] FCWithCD4LastToFirstOne =>
first one (FCWithCD4LastToFirstAll)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain first to last				*/
/* Number of solutions	: All 							*/

[] FCWithCD4SplitFirstToLastAll =>
dk (LocalConsistencyForECandDCWithCD4);
repeat* (
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain first to last				*/
/* Number of solutions	: First							*/

[] FCWithCD4SplitFirstToLastOne =>
first one (FCWithCD4SplitFirstToLastAll)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain last to first				*/
/* Number of solutions	: All 							*/

[] FCWithCD4SplitLastToFirstAll =>
dk (LocalConsistencyForECandDCWithCD4);
repeat* (
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   first one (LocalConsistencyInEC, id)
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   first one (LocalConsistencyInEC, id)
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Forward Checking with Constructive Disjunction 1	*/
/* Value selection	: Split domain last to first				*/
/* Number of solutions	: First							*/

[] FCWithCD4SplitLastToFirstOne =>
first one (FCWithCD4SplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FCWithCD4FirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD4FirstToLastOne)P
end

[FCWithCD4LastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD4LastToFirstOne)P
end

[FCWithCD4SplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD4SplitFirstToLastOne)P
end

[FCWithCD4SplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FCWithCD4SplitLastToFirstOne)P
end

[GetUBFCWithCD4FirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD4FirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCWithCD4LastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD4LastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCWithCD4SplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD4SplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFCWithCD4SplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FCWithCD4SplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD4FirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD4FirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD4LastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD4LastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD4SplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD4SplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFCWithCD4SplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FCWithCD4SplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
