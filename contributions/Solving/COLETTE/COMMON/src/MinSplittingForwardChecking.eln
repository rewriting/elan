	ForwardCheckingChoicePoint[Variables,Type,Values]
	ForwardCheckingChoicePointII[Variables,Type,Values]
	;
end

stratop
global
	MinSplittingFCFirstToLast				: < csop -> csop >	bs;
	MinSplittingFCLastToFirst				: < csop -> csop >	bs;
	MinSplittingFCSplitFirstToLast				: < csop -> csop >	bs;
	MinSplittingFCSplitLastToFirst				: < csop -> csop >	bs;
