/* Variable selection	: */
/* Value selection	: */

[] MaxSplittingFLAMaximumDegreeInECFirstToLast =>
first one (PostGTELowerBound);
LocalConsistencyForEC;
first one (GetLBFLAMaximumDegreeInECFirstToLastOne);
first one (OvervalueUpperBound);
repeat* (
	first one( first one (SetLowerBoundToMiddle);
