stratop
global
	FCChoicePointIIMaximumDomainFirstToLastAll  		: < csp -> csp >	bs;
	FCChoicePointIIMaximumDomainFirstToLastOne  		: < csp -> csp >	bs;
	FCChoicePointIIMaximumDomainLastToFirstAll  		: < csp -> csp >	bs;
