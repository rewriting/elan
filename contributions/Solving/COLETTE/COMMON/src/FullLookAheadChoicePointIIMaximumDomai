global
	FLAChoicePointIIMaximumDomainFirstToLastAll  		: < csp -> csp >	bs;
	FLAChoicePointIIMaximumDomainFirstToLastOne  		: < csp -> csp >	bs;
	FLAChoicePointIIMaximumDomainLastToFirstAll  		: < csp -> csp >	bs;
