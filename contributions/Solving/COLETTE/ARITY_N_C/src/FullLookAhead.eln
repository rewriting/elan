module FullLookAhead[Variables,Type,Values]

import
global
	LocalConsistencyStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	;
end

stratop
global
	FLAFirstToLastAll      			: < csp -> csp >	bs;
	FLAFirstToLastOne      			: < csp -> csp >	bs;
	FLALastToFirstAll      			: < csp -> csp >	bs;
	FLALastToFirstOne      			: < csp -> csp >	bs;
	FLASplitFirstToLastAll      		: < csp -> csp >	bs;
	FLASplitFirstToLastOne      		: < csp -> csp >	bs;
	FLASplitLastToFirstAll      		: < csp -> csp >	bs;
	FLASplitLastToFirstOne      		: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Full Lookahead			*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: All					*/

[] FLAFirstToLastAll =>
LocalConsistencyForEC ;
repeat* (
	dk (iterate* (EliminateFirstValueOfDomain)) ;
	first one (InstantiateFirstValueOfDomain) ;
	first one (ExtractConstraintsOnEqualityVar , id) ;
	first one (Elimination , id) ; 
	LocalConsistencyForEC
	) ;
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead			*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: First					*/

[] FLAFirstToLastOne =>
first one (FLAFirstToLastAll)
end


/* Strategy		: Full Lookahead			*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: All					*/

[] FLALastToFirstAll =>
LocalConsistencyForEC;
repeat* (
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	LocalConsistencyForEC
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead			*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: First					*/

[] FLALastToFirstOne =>
first one (FLALastToFirstAll)
end


/* Strategy		: Full Lookahead			*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: All 					*/

[] FLASplitFirstToLastAll =>
LocalConsistencyForEC;
repeat* (
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead			*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: First					*/

[] FLASplitFirstToLastOne =>
first one (FLASplitFirstToLastAll)
end


/* Strategy		: Full Lookahead			*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: All 					*/

[] FLASplitLastToFirstAll =>
LocalConsistencyForEC;
repeat* (
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead			*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: First					*/

[] FLASplitLastToFirstOne =>
first one (FLASplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FLAFirstToLastOne]

	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAFirstToLastOne)P
end

[FLALastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLALastToFirstOne)P
end

[FLASplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLASplitFirstToLastOne)P
end

[FLASplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLASplitLastToFirstOne)P
end

[GetUBFLAFirstToLastOne]

	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLALastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLALastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLASplitFirstToLastOne]

	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLASplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLASplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLASplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAFirstToLastOne]

	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLALastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLALastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLASplitFirstToLastOne]

	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLASplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLASplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLASplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
