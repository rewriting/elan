module CSPDefinition[Variables,Type,Values]

import
global	IntegerDomain
	ConstraintManipulation[Variables,Type]
	Values
	occur[var,constraint] occur[var,list[constraint]]
	replace[term,term]
	eq[csp]
	tuple[5,list[constraint],list[constraint],list[constraint],list[constraint],list[constraint]]
	tuple[3,list[constraint],list[constraint],list[var]]
	list[csp]
	eq[domain] 
	;
end

sort

	csp;

end

operators
global	

// Membership Constraints

@ in? @		: (var		domain)			constraint;

// Equality Constraints

@ = @		: (var		term)			constraint;

// CSP

CSP@		: (set:tuple[list[constraint],list[constraint],list[constraint],list[constraint],list[constraint]])	csp;
Unsatisfiable	:					csp;

EvaluateFunction(@,@)		: (term list[constraint])			Type;
CreateCSP(@)			: (constraint)			csp;
CreateSetOfConstraints(@) 	: (list[constraint])       	tuple[list[constraint],list[constraint]];
GetLMC(@)			: (csp)							list[constraint];
GetLEC(@)			: (csp)							list[constraint];
GetEC(@)			: (csp)							list[constraint];
GetDC(@)			: (csp)							list[constraint];
GetSTORE(@)			: (csp)							list[constraint];
GetMaximumDomain(@,@,@)		: (list[constraint] list[constraint] int)		list[constraint];
GetMinimumDomain(@,@,@)		: (list[constraint] list[constraint] int)		list[constraint];
GetMaximumDegree(@,@,@,@)	: (list[constraint] list[constraint] list[constraint] int) list[constraint];

MaxOfTerm(@,@,@,@)		: (term list[constraint] list[constraint] int) int;
MinOfTerm(@,@,@,@)		: (term list[constraint] list[constraint] int) int;
CreateEqualityConstraints(@)	: (list[constraint])			list[constraint];
ReviseDxWRTc(@,@,@)		: (list[constraint] list[constraint] constraint)	tuple[list[constraint],list[constraint],list[var]];
GetConstraintsOnVar(@,@,@,@)	: (list[var] list[constraint] list[constraint] list[constraint])			tuple[list[constraint],list[constraint]];
GetDegreeOfConstraint(@,@)	: (var list[constraint])				int;
ShiftConstraint(@,@)		: (list[constraint] constraint)			list[constraint];
SortList(@,@)			: (list[constraint] list[constraint])			list[constraint];
AllMembershipConstraints	:							list[constraint];

local
	CreateSetOfMembershipConstraints(@,@): (list[constraint] list[constraint])	list[constraint];
	GetSetOfConstraints(@,@,@,@)	: (list[constraint] list[constraint] list[constraint] list[constraint])
					  tuple[list[constraint],list[constraint],list[constraint]];
/* Cannot be compiled

	WriteCSPInHTML(@,@,@)		: (string constraint csp)				csp;
	WriteCSPInASCII(@,@,@)		: (string constraint csp)				csp;

*/

end


rules for csp

	n					: int;
	c, c1					: constraint;
	l, l1, l2, l3, l4, l5, lmc, lec, EC, DC, store	: list[constraint];
	s1, s2, s3, s4, s5, s6, s7, title	: string;
	S					: csp;

global 

[]	CreateCSP(c)
	=>
	CSP[lmc,lec,EC,DC,store]
	where	l   := ()CreateListOfCanonicalConstraints(c,nil)
	where	lmc := ()CreateSetOfMembershipConstraints(AllMembershipConstraints,l)
	where	lec := ()nil
	where	(tuple[list[constraint],list[constraint]]) [EC,DC] := ()CreateSetOfConstraints(l)
	where	store := ()nil
end

[GetSolutionCSP]

	CSP[lmc,lec,EC,DC,store]
	=>
	CSP[l1,l2,EC,DC,store]
	where	l1 := ()SortList(lmc,AllMembershipConstraints)
	where	l2 := ()SortList(lec,AllMembershipConstraints)
end

/* I/O cannot be compiled

