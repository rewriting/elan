module FullLookAheadChoicePoint[Variables,Type,Values]

import
global
	LocalConsistencyStrategies[Variables,Type,Values]
	EnumerationRules[Variables,Type,Values]
	;
end

stratop
global
	FLAChoicePointFirstToLastAll      		: < csp -> csp >	bs;
	FLAChoicePointFirstToLastOne      		: < csp -> csp >	bs;
	FLAChoicePointLastToFirstAll      		: < csp -> csp >	bs;
	FLAChoicePointLastToFirstOne      		: < csp -> csp >	bs;
	FLAChoicePointSplitFirstToLastAll      		: < csp -> csp >	bs;
	FLAChoicePointSplitFirstToLastOne      		: < csp -> csp >	bs;
	FLAChoicePointSplitLastToFirstAll      		: < csp -> csp >	bs;
	FLAChoicePointSplitLastToFirstOne      		: < csp -> csp >	bs;
end


strategies for csp
implicit

/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: All					*/

[] FLAChoicePointFirstToLastAll =>
dk (LocalConsistencyForECandDC) ;
repeat* (
	dk (iterate* (EliminateFirstValueOfDomain)) ;
	first one (InstantiateFirstValueOfDomain) ;
	first one (ExtractConstraintsOnEqualityVar , id) ;
	first one (Elimination , id) ;
	LocalConsistencyForEC
	) ;
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Value enumeration first to last	*/
/* Number of solutions	: First					*/

[] FLAChoicePointFirstToLastOne =>
first one (FLAChoicePointFirstToLastAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: All					*/

[] FLAChoicePointLastToFirstAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	dk (iterate* (EliminateLastValueOfDomain));
	first one (InstantiateLastValueOfDomain);
	first one (ExtractConstraintsOnEqualityVar, id);
	first one (Elimination, id);
	LocalConsistencyForEC
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Value enumeration last to first	*/
/* Number of solutions	: First					*/

[] FLAChoicePointLastToFirstOne =>
first one (FLAChoicePointLastToFirstAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: All 					*/

[] FLAChoicePointSplitFirstToLastAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	dk (first one (SplitDomainFirstMiddle), first one (SplitDomainSecondMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain first to last		*/
/* Number of solutions	: First					*/

[] FLAChoicePointSplitFirstToLastOne =>
first one (FLAChoicePointSplitFirstToLastAll)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: All 					*/

[] FLAChoicePointSplitLastToFirstAll =>
dk (LocalConsistencyForECandDC);
repeat* (
	dk (first one (SplitDomainSecondMiddle), first one (SplitDomainFirstMiddle));
	first one (first one (ExtractConstraintsOnEqualityVar);
		   first one (Elimination, id);
		   LocalConsistencyForEC
		   ,
		   first one (ExtractConstraintsOnDomainVar);
		   LocalConsistencyForEC
		   ,
		   id)
	);
first one (GetSolutionCSP)
end


/* Strategy		: Full Lookahead with Choice Point	*/
/* Value selection	: Split domain last to first		*/
/* Number of solutions	: First					*/

[] FLAChoicePointSplitLastToFirstOne =>
first one (FLAChoicePointSplitLastToFirstAll)
end

end


rules for csop

	x, y				: var;
	ub, lb, newub, newlb, middle	: Type;
	P, Q				: csp;
	lmc, lec, EC, DC, store		: list[constraint];
	l				: list[constraint];

global

[FLAChoicePointFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointFirstToLastOne)P
end

[FLAChoicePointLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointLastToFirstOne)P
end

[FLAChoicePointSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointSplitFirstToLastOne)P
end

[FLAChoicePointSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[Q,x,lb,ub]
	where	Q :=(FLAChoicePointSplitLastToFirstOne)P
end

[GetUBFLAChoicePointFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetUBFLAChoicePointSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,lb,newub]
	where	Q :=(FLAChoicePointSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newub.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointSplitFirstToLastOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointSplitFirstToLastOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

[GetLBFLAChoicePointSplitLastToFirstOne]
	CSOP[P,x,lb,ub]
	=>
	CSOP[P,x,newlb,ub]
	where	Q :=(FLAChoicePointSplitLastToFirstOne)P
	if	Q != Unsatisfiable
	where	(list[constraint]) y = newlb.l := ()GetVarInHead(x,GetLEC(Q),nil)
end

end


end
