LPL termination description 
 
  specification description

    part Vars		of sort list[identifier]
			import sigSyntax
    part Ops		of sort list[pair[identifier,int]]
	 		import sigSyntax
    part R1 	 	of sort list[rwrule]
			import variable[Vars] ECterm[Vars] Cterm[Ops]
			rwrule[Ops, Vars] list[rwrule]
    part R2	 	of sort list[rwrule]
			import variable[Vars] ECterm[Vars] Cterm[Ops]
			rwrule[Ops, Vars] list[rwrule]
    part Automata 	of sort list[automaton]
			import automaton[Ops] list[automaton]
  end

  query 	of sort pair[bool, automaton]
         	result of sort pair[bool, automaton]
	 	import termination[Ops, Vars, R1, R2] automaton[Ops]
		aut_name references[Ops, Automata]
         	start with () query
end
