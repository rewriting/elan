         global
           [decompose] P & FSYM(ss,code_f) = FSYM(tt,code_g)
                         => 
                         false
                         if code_f != code_g
           end
           [decompose] P & FSYM(s.ss,code_f)=FSYM(t.tt,code_f)
                         => 
                         P & s = t & FSYM(ss,-1) = FSYM(tt,-1)
           end
         end
         strategies for eqSystem
