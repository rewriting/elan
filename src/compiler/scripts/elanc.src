#!/bin/sh

#
#    REM - Reduce ELAN Machine
#
#    Copyright (C) 2000-2001  LORIA (CNRS, INPL, INRIA, UHP, U-Nancy 2)
#			     Nancy, France.
#
#    This program is free software; you can redistribute it and/or modify
#    it under the terms of the GNU General Public License as published by
#    the Free Software Foundation; either version 2 of the License, or
#    (at your option) any later version.
#
#    This program is distributed in the hope that it will be useful,
#    but WITHOUT ANY WARRANTY; without even the implied warranty of
#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#    GNU General Public License for more details.
#
#    You should have received a copy of the GNU General Public License
#    along with this program; if not, write to the Free Software
#    Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307 USA
#
#    Pierre-Etienne Moreau	e-mail: Pierre-Etienne.Moreau@loria.fr
#
#  POSIX sh translation (2026) of the tcsh script of 2003: same options,
#  same calls (elan --cexport, then REM). The options are split on blanks as
#  in the tcsh version, but not globbed.

set -f

echo

ELAN="__PREFIX__/bin/elan"
JAVA="__JAVA__"
CLASSES="__PREFIX__/classes"
# The installation and its tools (defaults of the generated Makefile)
PROPERTIES="-DPREFIX=__PREFIX__ -DELAN_CC=__ELAN_CC__ -DELAN_CXX=__ELAN_CXX__ -DGC_PREFIX=__GC_PREFIX__"

REMOPTION=""
ELANOPTION="-b "
LGIFILE=""
LGIDIR=""
SPCFILE=""
SPCDIR=""
SPCNAME=""

# print a command as the tcsh `echo` did (one blank between words)
show() { printf '%s\n' "$*"; }

if [ $# -gt 0 ]; then
  verb=1
  remarg=""
  elanarg=""
  argc=$#
  j=1
  for i in "$@"; do
    case "$i" in
      -aterm|-atermns)
        echo "elanc: the ATerm runtime is not supported (removed in this version)" >&2
        exit 1 ;;
      -O|-O2|-fast|-nocode|-nosplit|-split|-lib|-choicePointDebug|\
      -noOptimiseChoicePoint|-optimiseChoicePoint|-verbose|-debug|-coq|\
      -proofterm|-color|-noColor|-withGoto|-oldVariableAffectation|-onlyC|-noC)
        REMOPTION="$REMOPTION $i" ;;
      -quiet)
        REMOPTION="$REMOPTION $i"
        verb="" ;;
      -ba*)
        REMOPTION="$REMOPTION $i" ;;
      # options with argument (REM)
      -strategy|-output)
        remarg=1
        REMOPTION="$REMOPTION $i" ;;
      # options with argument (elan)
      --trace|-t|--elanlib|--secondlib|-l|--output)
        elanarg=1
        ELANOPTION="$ELANOPTION $i" ;;
      -*)
        ELANOPTION="$ELANOPTION $i" ;;
      *)
        if [ -n "$remarg" ]; then
          remarg=""
          REMOPTION="$REMOPTION $i"
        elif [ -n "$elanarg" ]; then
          elanarg=""
          ELANOPTION="$ELANOPTION $i"
        elif [ "$j" -lt "$argc" ]; then
          # not the last argument: the program
          LGIFILE=`basename "$i" .lgi`
          LGIDIR=`dirname "$i"`
        elif [ -n "$LGIFILE" ]; then
          # the last argument, after a program: its specification
          SPCFILE=`basename "$i" .spc`
          SPCDIR=`dirname "$i"`
          SPCNAME="$SPCDIR/$SPCFILE.spc"
        else
          LGIFILE=`basename "$i" .lgi`
          LGIDIR=`dirname "$i"`
        fi ;;
    esac
    j=`expr $j + 1`
  done

  if [ -n "$verb" ]; then
    show $ELAN --cexport $LGIFILE.ref $ELANOPTION $LGIDIR/$LGIFILE.lgi $SPCNAME
  fi
  # a stale .ref must not be compiled if the export fails
  rm -f "$LGIFILE.ref"
  "$ELAN" --cexport "$LGIFILE.ref" $ELANOPTION "$LGIDIR/$LGIFILE.lgi" ${SPCNAME:+"$SPCNAME"} || exit $?

  if [ -n "$verb" ]; then
    show $JAVA $PROPERTIES -cp $CLASSES rem.REM $LGIFILE.ref $REMOPTION
  fi
  "$JAVA" $PROPERTIES -cp "$CLASSES" rem.REM "$LGIFILE.ref" $REMOPTION

else
  echo "elanc [[elan options][compiler options]] file[.lgi] [file.[spc]]"
  "$JAVA" -cp "$CLASSES" rem.REM
fi
