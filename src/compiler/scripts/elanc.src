echo 

########################################################
#                                                      #
# Modify the following values according to your system #
#                                                      #
########################################################
set ARCH = `uname -m`
set ELAN = "__PREFIX__/bin/elan"
set JAVA = "java"

########################################################
#                                                      #
# Do not modify                                        #
#                                                      #
########################################################
set CLASSES    = "__PREFIX__/classes"
set REMOPTION  = ""
set ELANOPTION = "-b "
set LGIFILE    = ""
set LGIDIR     = ""
set SPCFILE    = ""
set SPCDIR     = ""
set SPCNAME    = ""


set verb
if($#argv>0) then
  @ j=1
  foreach i ($argv)
#    echo $i
    switch ($i) 	
      case -O:
      case -O2:
      case -fast:
      case -aterm:
      case -atermns:
      case -nocode:
      case -nosplit:
      case -split:
      case -lib:
      case -choicePointDebug:
      case -noOptimiseChoicePoint:
      case -optimiseChoicePoint:
      case -verbose:
      case -debug:
      case -coq:
      case -proofterm:
      case -color:
      case -noColor:
      case -withGoto:
      case -oldVariableAffectation:
      case -onlyC:
      case -noC:
        set REMOPTION = "${REMOPTION} $i"
        breaksw
      case -quiet:
        set REMOPTION = "${REMOPTION} $i"
	unset verb
        breaksw
      case -ba*:
        set REMOPTION = "${REMOPTION} $i"
        breaksw
# option with argument
      case -strategy:
      case -output:
	set remarg
        set REMOPTION = "${REMOPTION} $i"
        breaksw
# option with argument
      case --trace: 
      case -t:
      case --elanlib:
      case --secondlib:
      case -l:
      case --output:
        set elanarg
        set ELANOPTION = "${ELANOPTION} $i"
        breaksw
      case -*:
        set ELANOPTION = "${ELANOPTION} $i"
        breaksw
      default:
	if($?remarg) then
          unset remarg
          set REMOPTION = "${REMOPTION} $i"
        else
  	  if($?elanarg) then
            unset elanarg
            set ELANOPTION = "${ELANOPTION} $i"
          else
            if($j < $#argv) then
              set LGIFILE = `basename $i .lgi`
              set LGIDIR  = `dirname $i`
            else
              if(${LGIFILE} != "") then
                set SPCFILE = `basename $i .spc`
                set SPCDIR  = `dirname $i`
	        set SPCNAME = ${SPCDIR}/${SPCFILE}.spc 
              else
                set LGIFILE = `basename $i .lgi`
                set LGIDIR  = `dirname $i`
              endif
            endif
          endif
        endif
     endsw
     @ j++
  end

  #echo "REMOPTION  = ${REMOPTION}"
  #echo "ELANOPTION = ${ELANOPTION}"
  #echo "LGIFILE    = ${LGIFILE}"
  #echo "SPCFILE    = ${SPCFILE}"

if($?verb) then
  echo ${ELAN} --cexport ${LGIFILE}.ref ${ELANOPTION} ${LGIDIR}/${LGIFILE}.lgi ${SPCNAME}
endif

  ${ELAN} --cexport ${LGIFILE}.ref ${ELANOPTION} ${LGIDIR}/${LGIFILE}.lgi ${SPCNAME}

#if($?verb) then
#  echo ${JAVA} -jar ${CLASSES}/rem.jar ${LGIFILE}.ref ${REMOPTION}
#endif
#  ${JAVA} -jar ${CLASSES}/rem.jar ${LGIFILE}.ref ${REMOPTION}

if($?verb) then
  echo ${JAVA} -DPREFIX=__PREFIX__ -cp ${CLASSES} rem.REM ${LGIFILE}.ref ${REMOPTION}
endif
  ${JAVA} -DPREFIX=__PREFIX__ -cp ${CLASSES} rem.REM ${LGIFILE}.ref ${REMOPTION}


else
  echo "elanc [[elan options][compiler options]] file[.lgi] [file.[spc]]"
  ${JAVA} -cp ${CLASSES} rem.REM

#  echo "elanc [[elan options][-nosplit][-nocode][-quiet]] file[.lgi] [file.[spc]]"
#  echo "  [-nosplit]                  to produce only 2 files"
#  echo "  [-nocode]                   to erase generated files"
#  echo "  [-choicePointDebug]         to print choicePoints statistics"
#  echo "  [-noOptimiseChoicePoint]    to remove optimisation"
#  echo "  [-quiet]"
endif

