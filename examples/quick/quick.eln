module quick
  import global int list[int]; end
  sort pair; end
  operators global
    sort(@)               : (list[int]) list[int];
    pivot(@,@,@,@)        : (int list[int] list[int] list[int]) pair;
    [@,@]                 : (list[int] list[int]) pair;
  end
rules for list[int]
	x       : int;
	xs,s,l  : list[int];
  global
     []  sort(nil) => nil   end
     []  sort(x.xs) => append(sort(s),x.sort(l))           
                       where (pair)[s,l]:=()pivot(x,xs,nil,nil)   end
  end
rules for pair
	p, x    : int;
	xs,s,l, l1, l2  : list[int];
  global
     []  pivot(p,nil,s,l) => [s,l]  end
     []  pivot(p,x.xs,s,l) => pivot(p,xs,l1,l2) 
				choose try where l1 := ()s
                                           where l2 := ()x.l
                                           if p < x
				       try where l1 :=()x.s
                                           where l2 :=()l
				           if not(p < x)
                                       end
  end
end
end
