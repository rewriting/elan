module builtinterms
// A builtin operation (code 3, integer addition) declared on a sort of
// terms: the interpreter leaves a pl a as it is; elanc-go compiles it as
// a constructor (S7d; it crashed, then refused it).
import global int bool; end
sort t out; end
operators global
  a : t;
  @ pl @ : (t t) t code 3;
  r(@) : (t) out;
end
end
