LPL termops description
  query of sort bool
  result of sort u
  import termops
  start with () res(
    r(replace(a, b, f(a, g(a))),
      replace(b, h(a), f(b, d)),
      replace(a, g(b), g(a)),
      replace(k(1), k(2), f(k(1), s("x"))),
      replace(f(a,a), a, f(f(a,a), f(a,a))),
      replace(d, c, f(a, g(b))),
      rep(f(a, f(b, g(b))))),
    q(occurs(a, f(g(a), b)), occurs(f(a,b), a), occurs(s("x"), g(s("x"))),
      occurs(k(3), f(k(3), a)), occurs(a, a), occurs(d, f(a, b)),
      occurs(b, a U b U c), occurs(d, a U b),
      replace(a, c, a U b U a) == b U c U c),
    w(replace(a, b, a)),
    pair(replace(b, b U c, a U b), replace(g(a), g(b), f(g(a), a U g(a)))))
end
