module laterstrat
// A strategy term built at run time with a traversal (tone, evaluated by
// the eval_TONE strategy of strat[X], S6d), which elanc-rs must refuse
// (tests/compiler-rs/test_normalise.sh).
import global int strat[int]; end
rules for int
  n : int;
global
  [inc] n => n + 1 end
end
end
