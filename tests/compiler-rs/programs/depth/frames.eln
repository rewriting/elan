module frames
// Two deep normalisations in one start term (programs twophase*): cnt
// with small frames takes the stack to its largest size, then g, with 25
// arguments and frames 2-3x bigger, recurses on the same stack.
import global int bool; end
sort out; end
operators global
  cnt(@) : (int) int;
  g(@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@,@) : (int int int int int int int int int int int int int int int int int int int int int int int int int) int;
  r(@,@) : (int int) out;
end
rules for int
  n, v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23 : int;
global
  [] cnt(n) => 0 if n <= 0 end
  [] cnt(n) => cnt(n - 1) + 1 end
  [] g(n, v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23) => 0 if n <= 0 end
  [] g(n, v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23) => g(n - 1, v1 + v7, v2 + v8, v3 + v9, v4 + v10, v5 + v11, v6 + v12, v7 + v13, v8 + v14, v9 + v15, v10 + v16, v11 + v17, v12 + v18, v13 + v19, v14 + v20, v15 + v21, v16 + v22, v17 + v23, v18 + v0, v19 + v1, v20 + v2, v21 + v3, v22 + v4, v23 + v5, v0 + v6) + v0 * v3 + v1 * v4 + v2 * v5 + v3 * v6 + v4 * v7 + v5 * v8 + v6 * v9 + v7 * v10 + v8 * v11 + v9 * v12 + v10 * v13 + v11 * v14 + v12 * v15 + v13 * v16 + v14 * v17 + v15 * v18 + v16 * v19 + v17 * v20 + v18 * v21 + v19 * v22 + v20 * v23 + v21 * v0 + v22 * v1 + v23 * v2 end
end
end
