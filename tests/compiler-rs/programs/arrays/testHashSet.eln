module testHashSet

import bool hashSet[Term];
end

sort Term;
end 

operators global
  go     : Term;
  empty  : Term; 
  a      : Term; 
  b      : Term; 
  c      : Term; 
  g(@)	 : (Term) Term;

  hset1  : hashSet[Term];

  [@]	 : (bool) Term;
  int(@) : (int) Term;

  build(@) : (int) hashSet[Term];
  test(@,@) : (hashSet[Term] int) Term;
end

rules for Term
  x,y : Term; 
  hs : hashSet[Term];
  b  : bool;
  i  : int;
global

  [] go      => [hset1.contains(g(a))]
  end


  [] test(hs,0) => [hs.contains(int(0))]		end
  [] test(hs,i) => [b and hs.contains(int(i%123))]
		   if i>0
		   where (Term) [b]:=() test(hs,i-1) 
  end

end

rules for hashSet[Term]
  i  : int;
global
  [] hset1      => new(3)
		   .add(a)
		   .add(g(a))
  end

  [] build(0) => new(3).add(int(0))		end
  [] build(i) => build(i-1).add(int(i%123)) if i>0	end

end

end
				




