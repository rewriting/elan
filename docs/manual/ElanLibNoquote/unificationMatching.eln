module unificationMatching[Vars,Fss]

import  global  term termV[Vars] termF[Fss];
        local   Fss int identifier bool pair[identifier,int]
		list[pair[identifier,int]]
                eq[variable] eq[term]
		occur[variable,term] occur[variable,constraint]
                constraint[Fss,Vars]
		identity[constraint]
	;

op
  global
    @ = @       : (term term) equation          alias @=@:;
    @           : ( equation ) constraint       alias @:;
end


rules for constraint
	P : constraint;
	$s,$t : term;
	$x,$y : variable;
bodies

  [trueelim]    P & true        => P                            end
  [trueadd]     P               => true & P                     end



  [delete2] 	P & true & true	=> P & true
  end
  [delete3] 	P & false	=> false 
  end


  [delete] 	P & $s=$s	=> P
  end
  [coalesce] 	P & $x=$y	=> apply($x->$y,P) & $x=$y
		if occurs $x in P   and    occurs $y in P    and    neq($x,$y)
  end
  [conflict]	P & $s=$t	=> false
			if head($s)!=head($t) and not(isvar($s)) and not(isvar($t))
  end

  [occ_check1]	P & $x=$s	=> false
			if occurs $x in $s and not isvar($s)
  end
  [occ_check2]	P & $s=$x	=> false
			if occurs $x in $s and not isvar($s)
  end

  [eliminate1]	P & $x=$s	=> apply($x->$s,P) & $x=$s
		if not(occurs $x in $s)   and   occurs $x in P   and   not isvar($s)
  end
  [eliminate2]	P & $s=$x	=> apply($x->$s,P) & $x=$s
		if not(occurs $x in $s)   and   occurs $x in P   and   not isvar($s)
  end

  [orient_unif]	P & $y=$x	=> P & $x=$y
		if not occurs $x in P and occurs $y in P
  end
  [orient_unif]	P & $t=$x	=> P & $x=$t
		if not isvar($t)
  end

// Matching

  [MergingClash] 	P & $x=$s & $x=$t	=> false
			if neq($s,$t)
  end
  [SymbolVariableClash]	P & $s=$x	=> false
			if not(isvar($s))
  end
end

FOR EACH SS:pair[identifier,int]; F:identifier;  N:int
SUCH THAT SS:=(listExtract) elem(Fss) AND F:=()first(SS) 
        AND N:=()second(SS) :{
   rules for constraint
    P : constraint;
           s_1,...,s_N:term; t_1,...,t_N:term;
   bodies
     [decompose] P & F(s_1,...,s_N)=F(t_1,...,t_N)  => P { & s_I=t_I }_I=1...N   end
   end
}

strategy unify for constraint
  dc(trueadd);
  repeat* (
    dc(delete || delete2 || delete3 || decompose || conflict || coalesce || 
       occ_check1 || occ_check2 || eliminate1 || eliminate2 || orient_unif)
  );
  dc(trueelim || identity)
end

strategy match for constraint
  dc(trueadd);
  repeat* (
    dc(delete || delete2 || delete3 || decompose || conflict || MergingClash || SymbolVariableClash)
  );
  dc(trueelim || identity)
end

strategy unifys for constraint
  dc(trueadd);
  repeat* (
    dc(delete || delete2 || delete3 || decompose || conflict || coalesce || occ_check1 
       occ_check2 || eliminate1 || eliminate2 || orient_unif)
  );
  dc(trueelim || truepropag)
end

strategy matchs for constraint
  dc(trueadd);
  repeat* (
    dc(delete || delete2 || delete3 || decompose || conflict || MergingClash ||
       SymbolVariableClash )
  );
  dc(trueelim || truepropag)
end

strategy testunify for constraint
  dc(trueadd);
  repeat* (
  	repeat* ( dc(delete) );
	  repeat* ( dc(delete2) );
	  repeat* ( dc(delete3) );
	  repeat* ( dc(decompose) );
	  repeat* ( dc(conflict) );
	  repeat* ( dc(coalesce) );
	  repeat* ( dc(occ_check1) );
	  repeat* ( dc(occ_check2) );
	  repeat* ( dc(eliminate1) );
	  repeat* ( dc(eliminate2) );
	  repeat* ( dc(orient_unif) );
  );
  dc(trueelim || identity)
end

end
