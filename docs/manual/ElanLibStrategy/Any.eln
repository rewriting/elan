module Any

import global int list[Any] any[int];
end

sort Any Functor;
end

operators global
  functor(@)	: (Any) Functor;
  explode(@)	: (Any)	list[Any];
  implode(@,@)	: (Functor list[Any]) Any;
 local
  //*** EXPLIMPL for int
  @		: (int) Functor;
end

//*** EXPLIMPL for int
rules for list[Any]
 n:int; a:Any;
local
  []	explode((int)n) => nil 		end
end

rules for Functor
 n:int;
local
  []	functor((int)n) => n 		end
end

rules for Any
 n:int;
local
  []	implode(n,nil) => (int)n	end
end
//*** EXPLIMPL for int

end
