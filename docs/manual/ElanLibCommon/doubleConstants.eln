module doubleConstants
import global anyInteger;
sort double;
op
 global

  @.		: ( int ) double		pri 10000 code 34;
  @.@		: ( int int ) double		pri 10000 code 35;
  @.@E+@	: ( int int int ) double	pri 10000 code 36;
  @.@E-@	: ( int int int ) double	pri 10000 code 37;
  @.@e+@	: ( int int int ) double 	pri 10000 alias @.@E+@:;
  @.@e-@	: ( int int int ) double 	pri 10000 alias @.@E-@:;
  .@		: ( int ) double		pri 10000 code 64;
  .@E+@		: ( int int ) double		pri 10000 code 65;
  .@E-@		: ( int int ) double		pri 10000 code 66;
  .@e+@		: ( int int ) double		pri 10000 alias .@E+@:;
  .@e-@		: ( int int ) double		pri 10000 alias .@E-@:;

local

  DOUBLECONSTRUCTOR(@,@)	: ( int int ) double	code 49;

end

end
