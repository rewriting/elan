module identity[X]
sort X;
end
operators global

  identity(@)	: ( X ) X;

end

rules for X
 x : X;
local
  []	identity(x)	=> x		end
end

	// except his theoretical interest (this is the reflexivity 
	// of the rewrite logic) the next rule could be used when one 
	// wants a strategy to do always something
rules for X
 t : X;
global
  [identity]	t	=>	t	end
end

end
 
